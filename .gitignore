# Ordinary blocklist: a path is tracked unless a pattern below ignores
# it. Two things to know before adding a pattern:
#
#   1. gitignore is last-match-wins, so a pattern that re-ignores
#      something must sit BELOW the un-ignore it overrides. Getting
#      that order wrong shipped a bug once (#157 / #159).
#   2. The only allow-list in this file is the /.claude/ block near the
#      bottom. Everywhere else, adding a pattern only ever ignores
#      more.

# macOS Finder metadata and temp dirs
.DS_Store
__MACOSX/

# Git repo metadata
.git/

# macOS system files
.AppleDouble
.LSOverride
Icon
._*

# Archives and compressed files
*.zip
*.tar
*.gz
*.tgz
*.bz2
*.xz
*.7z

# Disk images and installers
*.dmg
*.iso
*.pkg

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
env/
venv/
.mypy_cache/
.pytest_cache/

# Node
node_modules/
npm-debug.log
yarn-error.log

# Environment
.env*

# Brew
Brewfile.lock.json
Brewfile.snapshot

# Docker
docker-data/
*.pid

# Local overrides, backups, lock files, and scratch directories,
# anywhere in the tree.
*.local.*
*.backup.*
*.lock
tmp/
worktrees/

# A place to stash machine-local files that stay out of git.
.local/

# Misc
*.log
*.tmp

# VSCode swapfile
*.swp

# direnv/asdf historic
.envrc
/.tool-versions

# The mise.toml at the repo root is the ONE tracked config form and is
# deliberately NOT ignored. Every path below is either machine-local or
# a non-canonical location we do not use; shutting them out is what
# keeps there being exactly one mise config to read.
/mise.local.toml
/mise/config.toml
/.mise/config.toml
/.config/mise.toml
/.config/mise/config.toml
/.config/mise/conf.d/

# Claude config — ignore the directory, then un-ignore the shareable
# parts. New Claude-generated dirs (cache, sessions, projects, todos,
# agent-memory, ...) stay ignored by default; add one here explicitly
# if it should be tracked. Re-including a file inside an ignored dir
# requires un-ignoring each parent first.
/.claude/*
!/.claude/CLAUDE.md
!/.claude/settings.json
!/.claude/agents/
!/.claude/commands/
!/.claude/hooks/
!/.claude/output-styles/
!/.claude/plans/
!/.claude/plugins/
!/.claude/rules/
!/.claude/skills/
