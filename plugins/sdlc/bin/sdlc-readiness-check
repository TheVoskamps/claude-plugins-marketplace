#!/usr/bin/env bash
#
# sdlc-readiness-check -- grade the `### Mechanical` bullets of an
# issue's two acceptance sections, `## Code and instruction Markdown
# acceptance` and `## Documentation acceptance`, against the tree, and
# print one gap line per failing bullet, per line under `### Mechanical`
# that is neither a bullet nor its continuation, per acceptance section
# with no bullet, and one when the body carries neither section. A
# `## Acceptance` section, and, when `## Files affected (floor)` is
# absent, each other heading at any level whose text holds the word
# "file" or "files" and the word "affected", in either order and any
# case, over a section holding a list item that lists a path, each get a
# gap line opening `mechanical: `, as does the neither-section line when
# the body carries `## Acceptance`. An item lists a path when its first
# token, backticked or bare, holds a slash, ends in a file extension or
# is a dotfile name, or when the item ends in a files-affected tag. Such a mistitled section's well-formed
# bullets are then read as the files-affected list. Read-only.
#
# The grammar and the key vocabulary are owned by
# plugins/sdlc/skills/orchestrate-readiness/SKILL.md. The body is read
# by running `issue-view <N>` from PATH, in the repository the working
# directory belongs to, and every path a bullet names is resolved
# against that repository's root.
#
# A bullet's text is never run. The script builds each command itself
# from the bullet's key, passes the bullet's arguments as argv only, and
# runs `grep` for a `[no-match]` bullet and nothing for any other key,
# which passes when each path it names is listed in the files-affected
# section. Runs under the bash 3.2 macOS ships.
#
# Usage: sdlc-readiness-check <N>
#
# <N> is an issue number in this repository, with or without a leading
# `#`.
#
# Exit statuses:
#   0  no gap; nothing is printed
#   1  a command the script ran failed, or issue-view is not on PATH
#   2  a usage error; nothing was read
#   3  at least one gap; one gap line per gap is printed on stdout
set -uo pipefail

PROGRAM=${0##*/}

# fail <status> <message> -- print the message on stderr, prefixed with
# the program name, and exit with the status.
fail() {
  printf '%s: %s\n' "$PROGRAM" "$2" >&2
  exit "$1"
}

[ "$#" -eq 1 ] || fail 2 "usage: $PROGRAM <N>"
issue=${1#\#}
case "$issue" in
  '' | *[!0-9]*) fail 2 "not an issue number: $1" ;;
esac

command -v issue-view >/dev/null 2>&1 ||
  fail 1 "issue-view is not on PATH; it ships with the issues plugin"

root=$(git rev-parse --show-toplevel) || fail 1 "not inside a git working tree"
root_phys=$(cd -P -- "$root" && pwd -P) || fail 1 "cannot resolve $root"

view=$(issue-view "$issue") || fail 1 "issue-view $issue failed"

# Split the body into the Mechanical bullets of both acceptance sections
# (`M<TAB><bullet>`), every other non-blank line under their `###
# Mechanical` (`X<TAB><line>`), the bullet count of each acceptance
# section present (`S<TAB><count><TAB><heading>`), the well-formed
# files-affected bullets (`F<TAB><path><TAB><tag>`), and the headings the
# mechanical gaps key on: `## Acceptance` (`A<TAB><heading>`), and, with
# no `## Files affected (floor)`, each other heading naming files
# affected over a list of paths (`N<TAB><heading>`), whose well-formed
# bullets are then the `F` records. A section under such a heading runs
# to the next `## ` heading or the next heading at its own level or
# above. No other `## ` section, `## Acceptance` included, is read past
# its heading. A bullet is a line
# opening with `- ` followed by text, and continues onto the indented
# lines directly below it, with no blank line between; a section's
# count is its bullets under `### Mechanical` and `### Semantic`. A
# fenced block is never read as grammar, and only a run of its opening
# character at least as long as its opening run closes it; a fence
# opening under `### Mechanical` is itself an `X` line.
records=$(printf '%s\n' "$view" | awk '
  function flush() {
    if (open) print "M\t" bullet
    open = 0; bullet = ""
  }
  # The path and tag of a well-formed files-affected bullet, tab-joined.
  function entry(s,   p, t) {
    p = s; sub(/^- `/, "", p); t = p
    sub(/`.*$/, "", p)
    sub(/^[^`]*` \(/, "", t); sub(/\).*$/, "", t)
    return p "\t" t
  }
  # Whether a heading names files affected: the word "file" or "files"
  # and the word "affected", in either order and any case.
  function names_files(h,   w) {
    w = tolower(h); sub(/^#+[ \t]+/, "", w); gsub(/[^a-z]+/, " ", w); w = " " w " "
    return w ~ / files? / && w ~ / affected /
  }
  # Whether a list item lists a path: its first token, backticked or
  # bare, holds a slash, ends in a file extension or is a dotfile name,
  # or the item ends in a files-affected tag.
  function lists_path(s,   b, t) {
    b = s; sub(/^[ \t]*([-*+]|[0-9]+[.)])[ \t]+/, "", b)
    if (b ~ /^`[^`]+`/) { t = b; sub(/^`/, "", t); sub(/`.*$/, "", t) }
    else { t = b; sub(/[ \t].*$/, "", t) }
    if (b ~ /\((new|update|delete)\)[ \t]*$/) return 1
    return t !~ /[ \t]/ && (t ~ /\// || t ~ /[^.\/]\.[A-Za-z0-9_-]+$/ || t ~ /^\.[A-Za-z0-9_]/)
  }
  # Open a section under a heading of level lvl that names files
  # affected.
  function open_named(h, lvl) { nn++; named[nn] = h; listing[nn] = 0; sec = "named"; nlvl = lvl; sub_ = "" }
  { sub(/\r$/, "") }
  !inbody { if ($0 == "Body:") inbody = 1; next }
  match($0, /^[ \t]*(```+|~~~+)/) {
    m = substr($0, RSTART, RLENGTH); sub(/^[ \t]*/, "", m)
    if (!fence) {
      flush()
      if (sec == "acc" && sub_ == "mech") print "X\t" $0
      fence = 1; fch = substr(m, 1, 1); flen = length(m); next
    }
    if (substr(m, 1, 1) == fch && length(m) >= flen) { fence = 0; next }
  }
  fence { next }
  /^## / {
    flush()
    h = $0; sub(/[ \t]+$/, "", h)
    if (h == "## Acceptance") print "A\t" h
    sec = (h == "## Code and instruction Markdown acceptance" || h == "## Documentation acceptance") ? "acc" : (h == "## Files affected (floor)") ? "files" : ""
    if (sec == "acc") { acc = h; if (!(h in count)) { count[h] = 0; order[++n] = h } }
    if (sec == "files") canon = 1
    if (sec == "" && names_files(h)) open_named(h, 2)
    sub_ = ""
    next
  }
  /^### / {
    flush()
    h = $0; sub(/[ \t]+$/, "", h)
    if (names_files(h)) { open_named(h, 3); next }
    if (sec == "named" && nlvl >= 3) sec = ""
    sub_ = (h == "### Mechanical") ? "mech" : (h == "### Semantic") ? "sem" : ""
    next
  }
  # A heading at any other level opens a files-affected section when it
  # names one, and ends one opened at its level or deeper; any other
  # such heading is read as the line it is.
  match($0, /^#+[ \t]/) && RLENGTH <= 7 && (names_files($0) || (sec == "named" && RLENGTH - 1 <= nlvl)) {
    flush()
    lvl = RLENGTH - 1
    h = $0; sub(/[ \t]+$/, "", h)
    if (names_files(h)) open_named(h, lvl); else sec = ""
    next
  }
  sec == "acc" && sub_ != "" && /^- [ \t]*[^ \t]/ { count[acc]++ }
  sec == "acc" && sub_ == "mech" {
    if (/^- [ \t]*[^ \t]/) { flush(); open = 1; bullet = substr($0, 3); next }
    if (open && /^[ \t]+[^ \t]/) { l = $0; sub(/^[ \t]+/, "", l); bullet = bullet " " l; next }
    flush()
    if (/[^ \t]/) print "X\t" $0
    next
  }
  sec == "files" && /^- `[^`]+` \((new|update|delete)\)[ \t]*$/ { print "F\t" entry($0) }
  sec == "named" && /^[ \t]*([-*+]|[0-9]+[.)])[ \t]+[^ \t]/ {
    if (lists_path($0)) listing[nn]++
    if (/^- `[^`]+` \((new|update|delete)\)[ \t]*$/) held[++nh] = entry($0)
  }
  END {
    flush()
    for (i = 1; i <= n; i++) print "S\t" count[order[i]] "\t" order[i]
    # With no `## Files affected (floor)`, a section holding a list of
    # paths under another files-affected heading is the list, mistitled.
    if (!canon) {
      for (i = 1; i <= nn; i++) if (listing[i]) print "N\t" named[i]
      for (i = 1; i <= nh; i++) print "F\t" held[i]
    }
  }
') || fail 1 "could not split the body of issue $issue"

GAPS=0

# gap <bar item> <bullet> <reason> -- print one gap line on stdout and
# count it in GAPS, which decides the exit-3 verdict.
gap() {
  printf '%s: Mechanical bullet "- %s" %s\n' "$1" "$2" "$3"
  GAPS=$((GAPS + 1))
}

# normalize <path> -- set NORM to the path with `.` and empty components
# dropped and `..` applied, or return 1 when it leaves the root.
normalize() {
  local IFS=/ part out=''
  local -a parts
  read -r -a parts <<<"$1"
  for part in "${parts[@]}"; do
    case "$part" in
      '' | .) ;;
      ..)
        [ -n "$out" ] || return 1
        case "$out" in
          */*) out=${out%/*} ;;
          *) out='' ;;
        esac
        ;;
      *) out=${out:+$out/}$part ;;
    esac
  done
  NORM=$out
}

# physical <path> -- set PHYS to where the absolute path leads once
# every symlink on it, the last component included, is followed, or
# return 1 when that takes more than 40 links. A component absent from
# the tree is taken as named, and `..` after it removes it.
physical() {
  local rest=${1#/} cur='' comp target hops=0
  while [ -n "$rest" ]; do
    comp=${rest%%/*}
    case "$rest" in
      */*) rest=${rest#*/} ;;
      *) rest='' ;;
    esac
    case "$comp" in
      '' | .) ;;
      ..) cur=${cur%/*} ;;
      *)
        if [ -L "$cur/$comp" ]; then
          hops=$((hops + 1))
          [ "$hops" -le 40 ] || return 1
          target=$(readlink -- "$cur/$comp") || return 1
          case "$target" in
            /*) cur='' ;;
          esac
          rest=${target#/}${rest:+/$rest}
        else
          cur=$cur/$comp
        fi
        ;;
    esac
  done
  PHYS=${cur:-/}
}

# resolve <path> -- set NORM to the repo-relative path, or set REFUSAL
# to why the path is refused and return 1. Only `readlink` runs on the
# path's components, to follow symlinks; nothing reads the file it
# names, and a refused path is never handed to grep.
resolve() {
  local p=$1
  case "$p" in
    '')
      REFUSAL='names an empty path'
      return 1
      ;;
    -*)
      REFUSAL="names a path starting with '-': $p"
      return 1
      ;;
    /*)
      REFUSAL="names a path outside the repo root: $p"
      return 1
      ;;
    *[*?[]*)
      REFUSAL="names a glob, not a literal path: $p"
      return 1
      ;;
  esac
  normalize "$p" || {
    REFUSAL="names a path outside the repo root: $p"
    return 1
  }
  [ -n "$NORM" ] || {
    REFUSAL="names the repo root, not a path in it: $p"
    return 1
  }
  # A symlink anywhere on the path, the path itself included, can lead
  # out of the root: follow each one and check where the path lands.
  physical "$root/$NORM" ||
    {
      REFUSAL="names a path that cannot be resolved: $p"
      return 1
    }
  case "$PHYS/" in
    "$root_phys"/*) ;;
    *)
      REFUSAL="names a path outside the repo root: $p"
      return 1
      ;;
  esac
}

# listed <path> [<tag>...] -- whether the files-affected section lists
# the repo-relative path, with one of the tags when any are given. NORM
# is local here because both callers read their own NORM after the call.
listed() {
  local want=$1 kind path tag t NORM
  shift
  while IFS=$'\t' read -r kind path tag; do
    [ "$kind" = F ] || continue
    normalize "$path" || continue
    [ "$NORM" = "$want" ] || continue
    [ "$#" -eq 0 ] && return 0
    for t in "$@"; do
      [ "$tag" = "$t" ] && return 0
    done
  done <<<"$records"
  return 1
}

# presence <bullet> <path>... -- the grading every key but [no-match]
# gets: each path must be listed in the files-affected section.
presence() {
  local bullet=$1 p unlisted=''
  shift
  for p in "$@"; do
    if ! resolve "$p"; then
      gap 'Acceptance criteria' "$bullet" "$REFUSAL; nothing was checked"
      return
    fi
  done
  for p in "$@"; do
    resolve "$p"
    listed "$NORM" || unlisted=${unlisted:+$unlisted, }$NORM
  done
  [ -z "$unlisted" ] ||
    gap 'Acceptance criteria' "$bullet" "names a file the files-affected section does not list: $unlisted"
}

# no_match <bullet> <args> -- run the one executed key: grep each named
# file for the ERE, and report every site in a file not listed with
# `update` or `delete`. A named file absent from the tree is skipped
# when listed with `new`, and is a gap otherwise. The ERE runs up to the
# last ` in `, so it may itself contain one.
no_match() {
  local bullet=$1 args=$2 ere p out rc line uncovered=''
  local -a paths
  case "$args" in
    *' in '*) ;;
    *)
      gap 'Acceptance criteria' "$bullet" "is malformed: [no-match] takes '<ERE> in <path>...'"
      return
      ;;
  esac
  ere=${args% in *}
  read -r -a paths <<<"${args##* in }"
  if [ -z "$ere" ] || [ "${#paths[@]}" -eq 0 ]; then
    gap 'Acceptance criteria' "$bullet" "is malformed: [no-match] takes '<ERE> in <path>...'"
    return
  fi
  for p in "${paths[@]}"; do
    if ! resolve "$p"; then
      gap 'Acceptance criteria' "$bullet" "$REFUSAL; nothing was run"
      return
    fi
    if [ -d "$root/$NORM" ]; then
      gap 'Acceptance criteria' "$bullet" "names a directory, not a file: $p; nothing was run"
      return
    fi
    if [ -e "$root/$NORM" ] && [ ! -f "$root/$NORM" ]; then
      gap 'Acceptance criteria' "$bullet" "names neither a regular file nor a directory: $p; nothing was run"
      return
    fi
    if [ ! -e "$root/$NORM" ] && ! listed "$NORM" new; then
      gap 'Acceptance criteria' "$bullet" \
        "names a file absent from the tree that the files-affected section does not list as new: $p; nothing was run"
      return
    fi
  done
  for p in "${paths[@]}"; do
    resolve "$p"
    [ -f "$root/$NORM" ] || continue
    out=$(grep -nE -- "$ere" "$root/$NORM" 2>&1)
    rc=$?
    case "$rc" in
      0) ;;
      1) continue ;;
      *)
        gap 'Acceptance criteria' "$bullet" "has an ERE grep rejects: ${out%%$'\n'*}"
        return
        ;;
    esac
    listed "$NORM" update delete && continue
    while IFS= read -r line; do
      uncovered=${uncovered:+$uncovered, }$NORM:${line%%:*}
    done <<<"$out"
  done
  [ -z "$uncovered" ] ||
    gap 'No unanswered design decisions' "$bullet" \
      "matches in a file the files-affected section does not list as update or delete: $uncovered"
}

# Grade each Mechanical line: one that is not a bullet is a gap as it
# stands, and a bullet is graded by its key. A key is lowercase letters
# and hyphens; the arguments after it are split on whitespace, so a path
# a bullet names cannot contain a space.
key_re='^\[([a-z-]+)\]([[:space:]]+(.*))?$'

while IFS=$'\t' read -r kind bullet; do
  if [ "$kind" = X ]; then
    printf 'Acceptance criteria: Mechanical line "%s" is not a "- " bullet or an indented continuation of one; nothing was run\n' "$bullet"
    GAPS=$((GAPS + 1))
    continue
  fi
  [ "$kind" = M ] || continue
  if ! [[ $bullet =~ $key_re ]]; then
    gap 'Acceptance criteria' "$bullet" "opens with no check key; nothing was run"
    continue
  fi
  key=${BASH_REMATCH[1]}
  args=${BASH_REMATCH[3]}
  read -r -a argv <<<"$args"
  n=${#argv[@]}
  malformed="is malformed for [$key]; nothing was checked"
  case "$key" in
    no-match)
      no_match "$bullet" "$args"
      ;;
    exists | executable | test-passes)
      if [ "$n" -eq 1 ]; then presence "$bullet" "${argv[0]}"; else gap 'Acceptance criteria' "$bullet" "$malformed"; fi
      ;;
    lint-clean)
      if [ "$n" -ge 1 ]; then presence "$bullet" "${argv[@]}"; else gap 'Acceptance criteria' "$bullet" "$malformed"; fi
      ;;
    max-lines)
      if [ "$n" -eq 2 ] && [[ ${argv[1]} =~ ^[0-9]+$ ]]; then
        presence "$bullet" "${argv[0]}"
      else
        gap 'Acceptance criteria' "$bullet" "$malformed"
      fi
      ;;
    version-bumped)
      if [ "$n" -eq 1 ] && [[ ${argv[0]} =~ ^[a-z0-9][a-z0-9._-]*$ ]]; then
        presence "$bullet" "plugins/${argv[0]}/.claude-plugin/plugin.json"
      else
        gap 'Acceptance criteria' "$bullet" "$malformed"
      fi
      ;;
    *)
      gap 'Acceptance criteria' "$bullet" "opens with an unrecognised check key [$key]; nothing was run"
      ;;
  esac
done <<<"$records"

# Grade the sections: at least one acceptance section, a bullet in each
# one present, no `## Acceptance`, and a files-affected list under no
# heading but `## Files affected (floor)`. A gap whose repair is fixed
# by the grammar alone — a forbidden section, or a heading missing
# around content the body already carries — is labelled `mechanical:`.
sections=0
forbidden=0
while IFS=$'\t' read -r kind count heading; do
  case "$kind" in
    A)
      forbidden=1
      printf 'mechanical: Acceptance criteria: the body carries the forbidden section "## Acceptance"; split its bullets into "## Code and instruction Markdown acceptance" and "## Documentation acceptance"\n'
      GAPS=$((GAPS + 1))
      ;;
    S)
      sections=$((sections + 1))
      if [ "$count" -eq 0 ]; then
        printf 'Acceptance criteria: "%s" carries no bullet under "### Mechanical" or "### Semantic"\n' "$heading"
        GAPS=$((GAPS + 1))
      fi
      ;;
  esac
done <<<"$records"
if [ "$sections" -eq 0 ]; then
  label=
  [ "$forbidden" -eq 0 ] || label='mechanical: '
  printf '%sAcceptance criteria: the body carries neither "## Code and instruction Markdown acceptance" nor "## Documentation acceptance"\n' "$label"
  GAPS=$((GAPS + 1))
fi
while IFS=$'\t' read -r kind heading; do
  [ "$kind" = N ] || continue
  printf 'mechanical: Files affected: the body carries its files-affected list under "%s"; retitle it "## Files affected (floor)"\n' "$heading"
  GAPS=$((GAPS + 1))
done <<<"$records"

[ "$GAPS" -eq 0 ] || exit 3
