#!/usr/bin/env bash
# Record one theorem-review round's progress in a log outside every
# worktree, and hold each child's full report, the round's theorem
# records and the round's argued review in files of their own, so a
# round completes from what is on disk rather than from what a caller
# heard back, and so the next round reads its predecessor's records off
# disk rather than off the PR. It also lists the PRs a repo holds state
# for and deletes one PR's state whole, which is the only way any of it
# is ever removed.
#
# Every path is composed here and nowhere else — the round log, each
# result file, the records file, the review file, and each child's
# harness transcript — so no agent ever opens one of these files by a
# path string of its own, to mistype or to carry across a turn
# boundary. An agent that names the state root in prose, to point a
# human at the directory, is doing something else.
#
# The contract this implements — modes, flags, paths, line grammar — is
# plugins/sdlc/skills/agent-result-persist-interface/SKILL.md.
set -euo pipefail

readonly PROGRAM=${0##*/}

die() {
  printf '%s: %s\n' "$PROGRAM" "$1" >&2
  exit 2
}

usage() {
  cat <<EOF
usage: $PROGRAM --mode anchor|spawn|enter|leave|return|stopped|print
                       |records|review|print-records|print-round-records
                       |print-review|list|delete
                --owner <owner> --repo <repo> [--pr <n>] [--round <n>]
                [--head-sha <sha>] [--theorem <id>]
                [--stage generate|disprove|verify] [--agent <name>]
                [--model <name>] [--effort <name>] [--agent-id <id>]
                [--tokens <n>] [--tools <n>] [--ms <n>] [--from <path>]
                [--carry [--edits <path>]]
EOF
}

mode=
owner=
repo=
pr=
round=
head_sha=
theorem=
stage=
agent=
model=
effort=
agent_id=
tokens=
tools=
ms=
from=
carry=
edits=
edits_given=

while [ "$#" -gt 0 ]; do
  flag=$1
  case "$flag" in
    --carry)
      carry=1
      shift
      continue
      ;;
    --mode|--owner|--repo|--pr|--round|--head-sha|--theorem|--stage|--agent|--model|--effort|--agent-id|--tokens|--tools|--ms|--from|--edits)
      [ "$#" -ge 2 ] || die "$flag needs a value"
      value=$2
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $flag"
      ;;
  esac
  case "$flag" in
    --mode)       mode=$value ;;
    --owner)      owner=$value ;;
    --repo)       repo=$value ;;
    --pr)         pr=$value ;;
    --round)      round=$value ;;
    --head-sha)   head_sha=$value ;;
    --theorem)    theorem=$value ;;
    --stage)      stage=$value ;;
    --agent)      agent=$value ;;
    --model)      model=$value ;;
    --effort)     effort=$value ;;
    --agent-id)   agent_id=$value ;;
    --tokens)     tokens=$value ;;
    --tools)      tools=$value ;;
    --ms)         ms=$value ;;
    --from)       from=$value ;;
    --edits)      edits=$value; edits_given=1 ;;
  esac
done

case "$mode" in
  anchor|spawn|enter|leave|return|stopped|print) ;;
  records|review|print-records|print-round-records|print-review) ;;
  list|delete) ;;
  '') die "--mode is required" ;;
  *)  die "unknown --mode: $mode" ;;
esac

# A / in an identifying value would silently add a directory level to
# the composed path, which is why owner and repo stay separate flags
# rather than arriving as one owner/name token. A value of . or .. names
# no directory of its own: .. climbs out of the level it stands at, and
# . lets the other value climb further, so either could compose a path
# outside the state root that every mode reads, writes or deletes under.
for pair in "owner:$owner" "repo:$repo"; do
  name=${pair%%:*}
  given=${pair#*:}
  [ -n "$given" ] || die "--$name is required"
  case "$given" in
    *[!A-Za-z0-9._-]*|.|..)
      die "--$name may hold only letters, digits, ., _ and -, and must not be . or ..: $given" ;;
  esac
done

# A mode refuses an identifying flag it does not act at: print-records
# selects the round itself, delete removes a whole PR's directory, and
# list reads above every PR's, so a caller passing one would be naming a
# round or a PR the mode is not going to touch.
for pair in "pr:$pr" "round:$round"; do
  name=${pair%%:*}
  given=${pair#*:}
  case "$name:$mode" in
    round:print-records|round:delete|round:list|pr:list)
      [ -z "$given" ] || die "--$name is not accepted in --mode $mode: $given"
      continue
      ;;
  esac
  [ -n "$given" ] || die "--$name is required"
  case "$given" in
    *[!0-9]*) die "--$name must be a number: $given" ;;
  esac
done

# Every column of every record is whitespace-separated, so a value
# carrying whitespace would shift the columns of its line and
# desynchronise the reader's derivation from the writer's intent.
single_token() {
  case "$2" in
    *[!A-Za-z0-9._:-]*) die "--$1 must be a single token: $2" ;;
  esac
}

case "$mode" in
  spawn|enter|leave|return|stopped)
    [ -n "$theorem" ] || die "--theorem is required in --mode $mode"
    single_token theorem "$theorem"
    # A result file is named <theorem>-<agent> and --mode print splits
    # it back apart at the first dash, so the theorem id carries none
    # and the agent name is free to.
    case "$theorem" in
      *-*) die "--theorem must carry no dash: $theorem" ;;
    esac
    [ -n "$stage" ] || die "--stage is required in --mode $mode"
    case "$stage" in
      generate|disprove|verify) ;;
      *) die "--stage must be generate, disprove or verify: $stage" ;;
    esac
    ;;
esac

# The agent names which definition the record is about, and on a leave
# it is half the result file's name.
case "$mode" in
  spawn|leave)
    [ -n "$agent" ] || die "--agent is required in --mode $mode"
    single_token agent "$agent"
    ;;
esac

if [ "$mode" = spawn ]; then
  for pair in "model:$model" "effort:$effort"; do
    name=${pair%%:*}
    given=${pair#*:}
    [ -n "$given" ] || die "--$name is required in --mode spawn"
    single_token "$name" "$given"
  done
fi

# The agent id names which child a record is about, so a re-spawned
# theorem's second child is told apart from the first. A child derives
# its own from its worktree; only the caller has to pass one.
if [ "$mode" = return ]; then
  [ -n "$agent_id" ] || die "--agent-id is required in --mode return"
  single_token agent-id "$agent_id"
fi

if [ "$mode" = anchor ]; then
  [ -n "$head_sha" ] || die "--head-sha is required in --mode anchor"
  single_token head-sha "$head_sha"
fi

# --from names the file a writing mode reads its payload from in place
# of stdin. A mode that reads no payload refuses it rather than ignore a
# file the caller expected to be stored.
if [ -n "$from" ]; then
  case "$mode" in
    leave|records|review) ;;
    *) die "--from is not accepted in --mode $mode: $from" ;;
  esac
  [ -f "$from" ] || die "--from names no file: $from"
fi

# --carry changes only how --mode records writes, and --edits feeds only
# that build, so either one anywhere else is refused rather than ignored.
# --edits is tested on edits_given rather than on its value, so an empty
# value is refused as naming no file instead of passing for an absent flag.
if [ -n "$carry" ] && [ "$mode" != records ]; then
  die "--carry is not accepted in --mode $mode"
fi
if [ -n "$edits_given" ]; then
  [ "$mode" = records ] || die "--edits is not accepted in --mode $mode: $edits"
  [ -n "$carry" ] || die "--edits is accepted only with --carry: $edits"
  [ -f "$edits" ] || die "--edits names no file: $edits"
fi

for pair in "tokens:$tokens" "tools:$tools" "ms:$ms"; do
  name=${pair%%:*}
  given=${pair#*:}
  [ -n "$given" ] || continue
  case "$given" in
    *[!0-9]*) die "--$name must be a number: $given" ;;
  esac
done

# The round gets a directory of its own under XDG state, composed from
# the identifying flags alone: no session is part of the path, so a
# round interrupted by a session ending is resumed from the same one.
readonly repo_dir="${XDG_STATE_HOME:-$HOME/.local/state}/sdlc/$owner/$repo"
readonly pr_dir="$repo_dir/pr$pr"
readonly dir="$pr_dir/round$round"
readonly file="$dir/log"
readonly result_file="$dir/$theorem-$agent"
readonly records_file="$dir/records"
readonly review_file="$dir/review"

now() {
  date -u +%Y-%m-%dT%H:%M:%SZ
}

# The harness names an isolation: worktree worktree agent-<agent-id>,
# so a child's own id is the one thing its cwd already tells it.
this_agent_id() {
  base=${PWD##*/}
  printf '%s\n' "${base#agent-}"
}

# The harness writes a child's transcript to
# ~/.claude/projects/<project>/<session>/subagents/agent-<id>.jsonl,
# where <project> is the primary clone's path with each character
# outside [A-Za-z0-9-] replaced by a dash — measured on both a / and a
# dot. The child's own cwd is a worktree, so the primary root comes from
# the common git dir rather than from $PWD. Any part of that being
# unavailable yields a dash: the record is worth more than the path.
transcript_path() {
  common=$(git rev-parse --git-common-dir 2>/dev/null) || { printf -- '-\n'; return; }
  case "$common" in
    /*) ;;
    *) common=$PWD/$common ;;
  esac
  primary=$(dirname "$common")
  session=${CLAUDE_CODE_SESSION_ID:-}
  if [ -z "$session" ]; then
    printf -- '-\n'
    return
  fi
  project=$(printf '%s' "$primary" | tr -c 'A-Za-z0-9-' '-')
  printf '%s\n' "$HOME/.claude/projects/$project/$session/subagents/agent-$(this_agent_id).jsonl"
}

# A payload, read from the --from file when one is named and from stdin
# otherwise, lands in a staging name and is renamed into place only once
# it is whole, because a stored file's mere existence is what a reader
# takes as settled: a file streamed straight to its own name would read
# as complete the moment the first byte landed, and a writer killed
# mid-write would leave that fragment there for good. The -$$ suffix is
# what keeps two writers from staging over each other.
store_payload() {
  target=$1
  noun=$2
  staged="$target.partial-$$"
  if [ -n "$from" ]; then
    if ! cat -- "$from" > "$staged"; then
      rm -f -- "$staged"
      die "--mode $mode takes the $noun from --from, and $from could not be read"
    fi
    if [ ! -s "$staged" ]; then
      rm -f -- "$staged"
      die "--mode $mode takes the $noun from --from, and $from is empty"
    fi
  else
    cat > "$staged"
    if [ ! -s "$staged" ]; then
      rm -f -- "$staged"
      die "--mode $mode takes the $noun on stdin, and nothing arrived"
    fi
  fi
  if [ "$mode" = leave ]; then
    check_report_theorem "$staged"
  fi
  mv -- "$staged" "$target"
}

# A disprover's or verifier's report names the theorem it answers on its
# THEOREM: line, and the stored file is named for --theorem, so a report
# handed over from another child would settle a theorem it never
# answered. The check runs on the staged copy, before the rename and
# before the leave record, so a refused report leaves neither behind. A
# generator's report is a theorem list and carries no such line.
check_report_theorem() {
  case "$stage" in
    disprove|verify) ;;
    *) return 0 ;;
  esac
  answered=$(awk '/^THEOREM:/ {
      sub(/^THEOREM:[ \t]*/, ""); sub(/[ \t\r]+$/, ""); print; exit
    }' "$1")
  if [ -z "$answered" ]; then
    rm -f -- "$1"
    die "--mode leave --stage $stage stores a report for --theorem $theorem, and the report has no THEOREM: line naming one"
  fi
  if [ "$answered" != "$theorem" ]; then
    rm -f -- "$1"
    die "--mode leave --stage $stage was given --theorem $theorem, and the report's THEOREM: line names $answered"
  fi
}

# The records to carry forward are the most recent ones there are: the
# highest-numbered round holding a records file. A voided round's
# directory carries its records with it under the .voided- name, and is
# skipped for the same reason its result files are — it describes a
# tree that no longer exists. Sets best and best_round, both empty when
# no round qualifies.
latest_records_round() {
  best=
  best_round=
  for candidate in "$pr_dir"/round*; do
    [ -d "$candidate" ] || continue
    base=${candidate##*/}
    case "$base" in
      *.voided-*) continue ;;
    esac
    n=${base#round}
    case "$n" in
      ''|*[!0-9]*) continue ;;
    esac
    [ -f "$candidate/records" ] || continue
    if [ -z "$best_round" ] || [ "$n" -gt "$best_round" ]; then
      best_round=$n
      best=$candidate
    fi
  done
}

# Builds the round's records file from the carried round's records, the
# --edits lines and the new records in the file $1 names (- for stdin),
# and prints it on stdout. The carried round is the one
# latest_records_round last selected, so that has to have run and found
# one. Every refusal is decided before a byte is printed, so a refused
# build prints nothing and exits 2 with the reason on stderr. A carried
# record no edit names is re-emitted line for line, and an edited one
# changes only on the lines its edits name.
carry_records() {
  if [ -n "$from" ]; then
    payload_name=--from
  else
    payload_name=stdin
  fi
  awk -v prog="$PROGRAM" -v round="$round" -v source="$payload_name" '
    function fail(msg) {
      print prog ": " msg | "cat 1>&2"
      failed = 1
      exit 2
    }
    function key_of(text,    k) {
      k = text
      sub(/:.*/, "", k)
      return k
    }
    BEGIN {
      rank["state"] = 1
      rank["state-detail"] = 2
      rank["settled-at"] = 3
      rank["severity-override"] = 4
      order[1] = "state"; order[2] = "state-detail"
      order[3] = "settled-at"; order[4] = "severity-override"
      n = 0
      last = 0
    }
    FNR == 1 { open = 0 }
    part == "carried" || part == "new" {
      if ($0 ~ /^[ \t\r]*$/) { open = 0; next }
      if (open) {
        lines[n]++
        line[n, lines[n]] = $0
        next
      }
      id = $0
      sub(/[ \t\r]+$/, "", id)
      if (part == "carried") {
        if (id !~ /^T[0-9]+$/)
          fail("the records of carried round " carried_round " hold a record whose id line is not T<n>: " $0)
      } else {
        where = source " line " FNR " (" $0 ")"
        if (id !~ /^T[0-9]+$/)
          fail(where " starts a new record whose id is not T<n>")
        if (id in idx && src[idx[id]] == "carried")
          fail(where " starts a new record whose id is already carried")
        if (substr(id, 2) + 0 != last + 1)
          fail(where " does not continue the id sequence, whose next id is T" (last + 1))
      }
      n++
      ids[n] = id
      num[n] = substr(id, 2) + 0
      src[n] = part
      lines[n] = 0
      idx[id] = n
      if (num[n] > last) last = num[n]
      open = 1
      next
    }
    part == "edits" {
      if ($0 == "") next
      where = "--edits line " FNR " (" $0 ")"
      t1 = index($0, "\t")
      if (!t1) fail(where " is not <id><tab><field><tab><value>")
      eid = substr($0, 1, t1 - 1)
      rest = substr($0, t1 + 1)
      t2 = index(rest, "\t")
      if (!t2) fail(where " is not <id><tab><field><tab><value>")
      field = substr(rest, 1, t2 - 1)
      value = substr(rest, t2 + 1)
      if (!(eid in idx))
        fail(where " names " eid ", which no carried record has")
      if (!(field in rank))
        fail(where " names field " field ", which is not state, state-detail, settled-at or severity-override")
      if (field == "state" && value != "disproved" && value != "unsettled" && value != "retired")
        fail(where " sets state " value ", which is not disproved, unsettled or retired")
      if ((eid, field) in edit)
        fail(where " is a second edit to " field " of " eid)
      edit[eid, field] = value
      next
    }
    END {
      if (failed) exit 2
      for (r = 1; r <= n; r++) {
        for (o = 1; o <= 4; o++) {
          f = order[o]
          if (!((ids[r], f) in edit)) continue
          v = edit[ids[r], f]
          text = (v == "") ? f ":" : f ": " v
          at = 0
          for (j = 1; j <= lines[r]; j++)
            if (key_of(line[r, j]) == f) { at = j; break }
          if (at) { line[r, at] = text; continue }
          # A field the record lacks goes in ahead of the first stamped
          # field that follows it in the records-file order.
          at = lines[r] + 1
          for (j = 1; j <= lines[r]; j++) {
            k = key_of(line[r, j])
            if ((k in rank) && rank[k] > rank[f]) { at = j; break }
          }
          for (j = lines[r]; j >= at; j--) line[r, j + 1] = line[r, j]
          line[r, at] = text
          lines[r]++
        }
      }
      missing = ""
      for (r = 1; r <= n; r++) {
        has = 0
        for (j = 1; j <= lines[r]; j++)
          if (key_of(line[r, j]) == "state") { has = 1; break }
        if (!has) missing = missing (missing == "" ? "" : ", ") ids[r]
      }
      if (missing != "")
        fail("round " round " would leave " missing " without a state, and every round from 1 on stamps one on every record")
      for (r = 1; r <= n; r++) sorted[r] = r
      for (r = 2; r <= n; r++) {
        s = sorted[r]
        for (j = r - 1; j >= 1 && num[sorted[j]] > num[s]; j--) sorted[j + 1] = sorted[j]
        sorted[j + 1] = s
      }
      for (r = 1; r <= n; r++) {
        s = sorted[r]
        if (r > 1) print ""
        print ids[s]
        for (j = 1; j <= lines[s]; j++) print line[s, j]
      }
    }
  ' carried_round="$best_round" part=carried "$best/records" \
    part=edits "${edits:-/dev/null}" \
    part=new "$1"
}

# Every mode that writes writes into the same directory; the reading
# modes and delete create nothing. A carried records write creates it
# only once its build has passed every refusal.
case "$mode" in
  print|print-records|print-round-records|print-review|list|delete) ;;
  records) [ -n "$carry" ] || mkdir -p "$dir" ;;
  *) mkdir -p "$dir" ;;
esac

case "$mode" in
  anchor)
    # Idempotent, because the anchor is one line among appends every
    # other actor makes: the write is keyed on whether an anchor is
    # already there, never on whether the file is — a child that starts
    # first creates it with its own enter record.
    old_head=
    if [ -e "$file" ]; then
      old_head=$(awk '$1=="anchor"{print $3; exit}' "$file")
    fi
    if [ -z "$old_head" ]; then
      printf 'anchor %s %s\n' "$(now)" "$head_sha" >> "$file"
    elif [ "$old_head" != "$head_sha" ]; then
      # A different head means the records describe a tree that no
      # longer exists, so they answer for nothing the new round will ask
      # — but they are still the evidence of what the voided round did,
      # so the round's whole directory is set aside rather than
      # overwritten. The result files go with the log because a reader
      # takes a report's existence as a settled theorem, and one left in
      # place under its own name would settle the fresh round's theorem
      # from the voided tree.
      stamp=$(date -u +%Y%m%dT%H%M%SZ)
      mv -- "$dir" "$dir.voided-$stamp"
      mkdir -p "$dir"
      printf 'anchor %s %s\n' "$(now)" "$head_sha" > "$file"
    fi
    # An anchor already naming this head is this same round's: the call
    # writes nothing and says so by exiting zero.
    ;;
  spawn)
    printf 'spawn %s %s %s %s %s %s\n' \
      "$theorem" "$stage" "$(now)" "$agent" "$model" "$effort" >> "$file"
    ;;
  enter)
    printf 'enter %s %s %s %s %s\n' \
      "$theorem" "$stage" "$(now)" "$(this_agent_id)" "$(transcript_path)" >> "$file"
    ;;
  leave)
    # The report is written before the record that names it, so a run
    # that dies between the two leaves the report readable rather than a
    # record pointing at nothing.
    store_payload "$result_file" report
    printf 'leave %s %s %s %s %s\n' \
      "$theorem" "$stage" "$(now)" "$(this_agent_id)" "$result_file" >> "$file"
    ;;
  return)
    printf 'return %s %s %s %s tokens=%s tools=%s ms=%s\n' \
      "$theorem" "$stage" "$(now)" "$agent_id" "$tokens" "$tools" "$ms" >> "$file"
    ;;
  stopped)
    printf 'stopped %s %s %s\n' "$theorem" "$stage" "$(now)" >> "$file"
    ;;
  print)
    [ -e "$file" ] || die "no round log at $file"
    cat -- "$file"
    # Every result file present, synthesized from the directory at read
    # time rather than stored: a report written by a child whose leave
    # record never landed still reaches the reader this way.
    for found in "$dir"/*; do
      [ -e "$found" ] || continue
      rest=${found##*/}
      case "$rest" in
        log|records|review|*.partial-*) continue ;;
      esac
      printf 'result %s %s %s\n' "${rest%%-*}" "${rest#*-}" "$found"
    done
    ;;
  records)
    if [ -z "$carry" ]; then
      store_payload "$records_file" records
    else
      latest_records_round
      [ -n "$best" ] || die "--mode records --carry found no round under $pr_dir holding a records file to carry"
      # A round no lower than --round holds this round's own stored
      # output or a later round's, and carrying it would take that as
      # this round's predecessor and apply the edits over it again.
      [ "$best_round" -lt "$round" ] ||
        die "--mode records --carry would carry round $best_round's records, which is not lower than --round $round"
      # With --carry the payload is only the round's new records, and a
      # round that mints none has none to send, so an absent one is
      # empty rather than refused. Stdin is not read from a terminal,
      # where nothing would ever arrive.
      payload=-
      if [ -n "$from" ]; then
        payload=$from
      elif [ -t 0 ]; then
        payload=/dev/null
      fi
      # The build is held in a variable, not streamed to the staging
      # name, so a refused one leaves no directory and no file behind.
      built=$(carry_records "$payload") || exit 2
      mkdir -p "$dir"
      staged="$records_file.partial-$$"
      printf '%s\n' "$built" > "$staged"
      mv -- "$staged" "$records_file"
    fi
    ;;
  review)
    store_payload "$review_file" review
    ;;
  print-records)
    # The caller names no round, and which round wrote the records is
    # what the first line of the output says.
    latest_records_round
    [ -n "$best" ] || die "no round under $pr_dir holds a records file"
    printf 'round %s\n' "$best_round"
    cat -- "$best/records"
    ;;
  print-round-records)
    [ -e "$records_file" ] || die "no round records at $records_file"
    cat -- "$records_file"
    ;;
  print-review)
    [ -e "$review_file" ] || die "no round review at $review_file"
    cat -- "$review_file"
    ;;
  list)
    # A repo no review has run against has no directory, which is an
    # empty list rather than an error.
    for found in "$repo_dir"/pr*; do
      [ -d "$found" ] || continue
      n=${found##*/pr}
      case "$n" in
        ''|*[!0-9]*) continue ;;
      esac
      printf '%s\n' "$n"
    done | sort -n
    ;;
  delete)
    # The one mode that deletes. A directory already gone is the state
    # the call asks for, so it succeeds silently.
    rm -rf -- "$pr_dir"
    ;;
esac
