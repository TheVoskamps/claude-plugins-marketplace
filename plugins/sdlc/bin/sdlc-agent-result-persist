#!/usr/bin/env bash
# Record one theorem-review round's progress in a log outside every
# worktree, and hold each child's full report, the round's theorem
# records and the round's argued review in files of their own, so a
# round completes from what is on disk rather than from what a caller
# heard back, and so the next round reads its predecessor's records off
# disk rather than off the PR. It also lists the PRs a repo holds state
# for and deletes one PR's state whole, which is the only way any of it
# is ever removed, and lists the repositories the state root holds.
#
# Every path is composed here and nowhere else — the round log, each
# result file, the records file, the review file, and each child's
# harness transcript — so no agent ever opens one of these files by a
# path string of its own, to mistype or to carry across a turn
# boundary. An agent that names the state root in prose, to point a
# human at the directory, is doing something else.
#
# The contract this implements — modes, flags, paths, line grammar — is
# plugins/sdlc/skills/agent-result-persist-interface/SKILL.md.
set -euo pipefail

readonly PROGRAM=${0##*/}

die() {
  printf '%s: %s\n' "$PROGRAM" "$1" >&2
  exit 2
}

usage() {
  cat <<EOF
usage: $PROGRAM --mode anchor|spawn|enter|leave|return|stopped|print
                       |records|review|print-records|print-round-records
                       |print-review|list|delete
                --repo <host>/<owner>/<repo> [--pr <n>] [--round <n>]
                [--head-sha <sha>] [--theorem <id>]
                [--stage generate|disprove|verify] [--agent <name>]
                [--model <name>] [--effort <name>] [--agent-id <id>]
                [--tokens <n>] [--tools <n>] [--ms <n>] [--from <path>]
                [--carry [--edits <path>]]
       $PROGRAM --mode repos
EOF
}

mode=
repo_ref=
pr=
round=
head_sha=
theorem=
stage=
agent=
model=
effort=
agent_id=
tokens=
tools=
ms=
from=
carry=
edits=

while [ "$#" -gt 0 ]; do
  flag=$1
  case "$flag" in
    --mode|--repo|--pr|--round|--head-sha|--theorem|--stage|--agent|--model|--effort|--agent-id|--tokens|--tools|--ms|--from|--edits)
      [ "$#" -ge 2 ] || die "$flag needs a value"
      value=$2
      shift 2
      ;;
    --carry)
      carry=1
      shift
      continue
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $flag"
      ;;
  esac
  case "$flag" in
    --mode)       mode=$value ;;
    --repo)       repo_ref=$value ;;
    --pr)         pr=$value ;;
    --round)      round=$value ;;
    --head-sha)   head_sha=$value ;;
    --theorem)    theorem=$value ;;
    --stage)      stage=$value ;;
    --agent)      agent=$value ;;
    --model)      model=$value ;;
    --effort)     effort=$value ;;
    --agent-id)   agent_id=$value ;;
    --tokens)     tokens=$value ;;
    --tools)      tools=$value ;;
    --ms)         ms=$value ;;
    --from)       from=$value ;;
    --edits)      edits=$value ;;
  esac
done

case "$mode" in
  anchor|spawn|enter|leave|return|stopped|print) ;;
  records|review|print-records|print-round-records|print-review) ;;
  list|delete|repos) ;;
  '') die "--mode is required" ;;
  *)  die "unknown --mode: $mode" ;;
esac

readonly state_root="${XDG_STATE_HOME:-$HOME/.local/state}/sdlc"

# is_old_layout <dir>: whether a directory two levels below the state
# root is a repository's state from before the host was part of the
# path. Such a directory is <owner>/<repo> by position and carries no
# repo.yml; a <host>/<owner> directory of the current layout sits at the
# same depth and carries a repo.yml one level down, in each repository.
is_old_layout() {
  [ -d "$1" ] || return 1
  [ -e "$1/repo.yml" ] && return 1
  for found in "$1"/*/repo.yml; do
    [ -e "$found" ] && return 1
  done
  return 0
}

# repos reads across every repository the state root holds, so it takes
# no identifying flag, and it reads each repository from its repo.yml.
if [ "$mode" = repos ]; then
  for pair in "repo:$repo_ref" "pr:$pr" "round:$round"; do
    [ -z "${pair#*:}" ] || die "--${pair%%:*} is not accepted in --mode repos: ${pair#*:}"
  done
  [ -d "$state_root" ] || exit 0
  find "$state_root" -name repo.yml -type f | sort | while IFS= read -r yml; do
    at=${yml%/repo.yml}
    at=${at#"$state_root"/}
    named=$(awk -F': *' '$1=="host"{h=$2} $1=="owner"{o=$2} $1=="repo"{r=$2} END{print h "/" o "/" r}' "$yml")
    if [ "$named" = "$at" ]; then
      printf 'repo %s %s\n' "$named" "$at"
    else
      printf 'mismatch %s %s\n' "$named" "$at"
    fi
  done
  for at in "$state_root"/*/*; do
    is_old_layout "$at" || continue
    printf 'old %s %s\n' "${at#"$state_root"/}" "${at#"$state_root"/}"
  done
  exit 0
fi

# --repo names the repository as host/owner/repo, each segment one level
# of the composed path. The host is part of it because one machine holds
# state for repositories on several hosts, and the same owner/repo on two
# of them is two repositories. A segment holding anything but letters,
# digits, ., _ and - could add a directory level, and a segment of . or
# .. names no directory of its own: .. climbs out of the level it stands
# at, and . lets another segment climb further, so either could compose a
# path outside the state root that every mode reads, writes or deletes
# under.
[ -n "$repo_ref" ] || die "--repo is required"
case "$repo_ref" in
  */*/*/*|*//*|/*|*/) die "--repo takes <host>/<owner>/<repo>: $repo_ref" ;;
  ?*/?*/?*) ;;
  *) die "--repo takes <host>/<owner>/<repo>: $repo_ref" ;;
esac
host=${repo_ref%%/*}
owner=${repo_ref#*/}
owner=${owner%/*}
repo=${repo_ref##*/}
for given in "$host" "$owner" "$repo"; do
  case "$given" in
    *[!A-Za-z0-9._-]*|.|..)
      die "--repo segments may hold only letters, digits, ., _ and -, and none may be . or ..: $repo_ref" ;;
  esac
done

# A mode refuses an identifying flag it does not act at: delete removes
# a whole PR's directory, and list reads above every PR's, so a caller
# passing one would be naming a round or a PR the mode is not going to
# touch. print-records selects the round itself, so a --round given to
# it bounds that selection from above rather than naming the round.
for pair in "pr:$pr" "round:$round"; do
  name=${pair%%:*}
  given=${pair#*:}
  case "$name:$mode" in
    round:delete|round:list|pr:list)
      [ -z "$given" ] || die "--$name is not accepted in --mode $mode: $given"
      continue
      ;;
    round:print-records)
      [ -n "$given" ] || continue
      ;;
  esac
  [ -n "$given" ] || die "--$name is required"
  case "$given" in
    *[!0-9]*) die "--$name must be a number: $given" ;;
  esac
done

# Every column of every record is whitespace-separated, so a value
# carrying whitespace would shift the columns of its line and
# desynchronise the reader's derivation from the writer's intent.
single_token() {
  case "$2" in
    *[!A-Za-z0-9._:-]*) die "--$1 must be a single token: $2" ;;
  esac
}

case "$mode" in
  spawn|enter|leave|return|stopped)
    [ -n "$theorem" ] || die "--theorem is required in --mode $mode"
    single_token theorem "$theorem"
    # A result file is named <theorem>-<agent> and --mode print splits
    # it back apart at the first dash, so the theorem id carries none
    # and the agent name is free to.
    case "$theorem" in
      *-*) die "--theorem must carry no dash: $theorem" ;;
    esac
    [ -n "$stage" ] || die "--stage is required in --mode $mode"
    case "$stage" in
      generate|disprove|verify) ;;
      *) die "--stage must be generate, disprove or verify: $stage" ;;
    esac
    ;;
esac

# The agent names which definition the record is about, and on a leave
# it is half the result file's name.
case "$mode" in
  spawn|leave)
    [ -n "$agent" ] || die "--agent is required in --mode $mode"
    single_token agent "$agent"
    ;;
esac

if [ "$mode" = spawn ]; then
  for pair in "model:$model" "effort:$effort"; do
    name=${pair%%:*}
    given=${pair#*:}
    [ -n "$given" ] || die "--$name is required in --mode spawn"
    single_token "$name" "$given"
  done
fi

# The agent id names which child a record is about, so a re-spawned
# theorem's second child is told apart from the first. A child derives
# its own from its worktree; only the caller has to pass one.
if [ "$mode" = return ]; then
  [ -n "$agent_id" ] || die "--agent-id is required in --mode return"
  single_token agent-id "$agent_id"
fi

if [ "$mode" = anchor ]; then
  [ -n "$head_sha" ] || die "--head-sha is required in --mode anchor"
  single_token head-sha "$head_sha"
fi

# --from names the file a writing mode reads its payload from in place
# of stdin. A mode that reads no payload refuses it rather than ignore a
# file the caller expected to be stored.
if [ -n "$from" ]; then
  case "$mode" in
    leave|records|review) ;;
    *) die "--from is not accepted in --mode $mode: $from" ;;
  esac
  [ -f "$from" ] || die "--from names no file: $from"
fi

# --carry is the records form that builds the round's file itself, and
# --edits is that form's input alone.
if [ -n "$carry" ] && [ "$mode" != records ]; then
  die "--carry is not accepted in --mode $mode"
fi
if [ -n "$edits" ]; then
  [ -n "$carry" ] || die "--edits is accepted only with --carry: $edits"
  [ -f "$edits" ] || die "--edits names no file: $edits"
fi

for pair in "tokens:$tokens" "tools:$tools" "ms:$ms"; do
  name=${pair%%:*}
  given=${pair#*:}
  [ -n "$given" ] || continue
  case "$given" in
    *[!0-9]*) die "--$name must be a number: $given" ;;
  esac
done

# The round gets a directory of its own under XDG state, composed from
# the identifying flags alone: no session is part of the path, so a
# round interrupted by a session ending is resumed from the same one.
readonly repo_dir="$state_root/$host/$owner/$repo"
readonly pr_dir="$repo_dir/pr$pr"
readonly dir="$pr_dir/round$round"
readonly file="$dir/log"
readonly result_file="$dir/$theorem-$agent"
readonly records_file="$dir/records"
readonly review_file="$dir/review"

now() {
  date -u +%Y-%m-%dT%H:%M:%SZ
}

# The repository's state directory carries repo.yml naming the repository
# it holds, so a reader identifies the directory from the file rather than
# from its path. write_repo_yml writes it into a directory that lacks one.
write_repo_yml() {
  [ -e "$repo_dir/repo.yml" ] && return 0
  printf 'schema-version: 1\nhost: %s\nowner: %s\nrepo: %s\n' "$host" "$owner" "$repo" \
    > "$repo_dir/repo.yml.partial-$$"
  mv -- "$repo_dir/repo.yml.partial-$$" "$repo_dir/repo.yml"
}

# State written before the host was part of the path sits at
# sdlc/<owner>/<repo>/. It moves to this repository's directory, host from
# --repo, before any mode reads or writes, so no reader falls back to the
# old path.
migrate_old_layout() {
  old="$state_root/$owner/$repo"
  is_old_layout "$old" || return 0
  [ ! -e "$repo_dir" ] \
    || die "state for $repo_ref is at both $old and $repo_dir; move one aside before running again"
  mkdir -p -- "${repo_dir%/*}"
  mv -- "$old" "$repo_dir"
  rmdir -- "$state_root/$owner" 2>/dev/null || :
  write_repo_yml
}

# The harness names an isolation: worktree worktree agent-<agent-id>,
# so a child's own id is the one thing its cwd already tells it.
this_agent_id() {
  base=${PWD##*/}
  printf '%s\n' "${base#agent-}"
}

# The harness writes a child's transcript to
# ~/.claude/projects/<project>/<session>/subagents/agent-<id>.jsonl,
# where <project> is the primary clone's path with each character
# outside [A-Za-z0-9-] replaced by a dash — measured on both a / and a
# dot. The child's own cwd is a worktree, so the primary root comes from
# the common git dir rather than from $PWD. Any part of that being
# unavailable yields a dash: the record is worth more than the path.
transcript_path() {
  common=$(git rev-parse --git-common-dir 2>/dev/null) || { printf -- '-\n'; return; }
  case "$common" in
    /*) ;;
    *) common=$PWD/$common ;;
  esac
  primary=$(dirname "$common")
  session=${CLAUDE_CODE_SESSION_ID:-}
  if [ -z "$session" ]; then
    printf -- '-\n'
    return
  fi
  project=$(printf '%s' "$primary" | tr -c 'A-Za-z0-9-' '-')
  printf '%s\n' "$HOME/.claude/projects/$project/$session/subagents/agent-$(this_agent_id).jsonl"
}

# Scratch for a payload on its way into state, removed on exit.
work=
make_work() {
  work=$(mktemp -d "${TMPDIR:-/tmp}/$PROGRAM.XXXXXX")
  trap 'rm -rf -- "$work"' EXIT
}

# read_payload <dest> <noun>: copies the payload, from the --from file
# when one is named and from stdin otherwise, to <dest>.
read_payload() {
  if [ -n "$from" ]; then
    cat -- "$from" > "$1" \
      || die "--mode $mode takes the $2 from --from, and $from could not be read"
  else
    cat > "$1"
  fi
}

# install_whole <source> <target>: the way every file stored whole — a
# result file, the records, the review — reaches its name, unlike the
# log, which grows by appends. It lands in a staging name and is renamed
# into place only once it is whole, because a stored file's mere
# existence is what a reader takes as settled: a file streamed straight
# to its own name would read as complete the moment the first byte
# landed, and a writer killed mid-write would leave that fragment there
# for good. The -$$ suffix is what keeps two writers from staging over
# each other.
install_whole() {
  staged="$2.partial-$$"
  if ! cp -- "$1" "$staged"; then
    rm -f -- "$staged"
    die "could not stage $2"
  fi
  mv -- "$staged" "$2"
}

# store_payload <target> <noun>: stores the payload whole at <target>,
# refusing an empty one.
store_payload() {
  make_work
  read_payload "$work/payload" "$2"
  if [ ! -s "$work/payload" ]; then
    if [ -n "$from" ]; then
      die "--mode $mode takes the $2 from --from, and $from is empty"
    fi
    die "--mode $mode takes the $2 on stdin, and nothing arrived"
  fi
  if [ "$mode" = leave ]; then
    check_report_theorem "$work/payload"
  fi
  install_whole "$work/payload" "$1"
}

# A disprover's or verifier's report names the theorem it answers on its
# THEOREM: line, and the stored file is named for --theorem, so a report
# handed over from another child would settle a theorem it never
# answered. The check runs on the read copy, before it is installed and
# before the leave record, so a refused report leaves neither behind. A
# generator's report is a theorem list and carries no such line.
check_report_theorem() {
  case "$stage" in
    disprove|verify) ;;
    *) return 0 ;;
  esac
  answered=$(awk '/^THEOREM:/ {
      sub(/^THEOREM:[ \t]*/, ""); sub(/[ \t\r]+$/, ""); print; exit
    }' "$1")
  if [ -z "$answered" ]; then
    rm -f -- "$1"
    die "--mode leave --stage $stage stores a report for --theorem $theorem, and the report has no THEOREM: line naming one"
  fi
  if [ "$answered" != "$theorem" ]; then
    rm -f -- "$1"
    die "--mode leave --stage $stage was given --theorem $theorem, and the report's THEOREM: line names $answered"
  fi
}

# The records to carry forward are the most recent ones there are, so
# this sets best_round and best to the highest-numbered round holding a
# records file, and leaves both empty when none does. Given a round
# number, it considers only the rounds below that one, and sets
# above_round to the highest round above it holding a records file,
# leaving it empty when none does. A voided round's directory carries
# its records with it under the .voided- name, and is skipped for the
# same reason its result files are — it describes a tree that no longer
# exists.
latest_records_round() {
  best=
  best_round=
  above_round=
  for candidate in "$pr_dir"/round*; do
    [ -d "$candidate" ] || continue
    base=${candidate##*/}
    case "$base" in
      *.voided-*) continue ;;
    esac
    n=${base#round}
    case "$n" in
      ''|*[!0-9]*) continue ;;
    esac
    [ -f "$candidate/records" ] || continue
    if [ -n "${1-}" ] && [ "$n" -ge "$1" ]; then
      if [ "$n" -gt "$1" ] && { [ -z "$above_round" ] || [ "$n" -gt "$above_round" ]; }; then
        above_round=$n
      fi
      continue
    fi
    if [ -z "$best_round" ] || [ "$n" -gt "$best_round" ]; then
      best_round=$n
      best=$candidate
    fi
  done
}

# The rounds below --round, for a call that reads records from there:
# sets best_round and best as latest_records_round does, and refuses when
# a round above --round holds records. Such a round was built from the
# records below it, so --round is not the round under way and what the
# rounds below hold is no longer the latest state.
records_below_round() {
  latest_records_round "$round"
  [ -z "$above_round" ] \
    || die "--mode $mode${carry:+ --carry} --round $round refused: round $above_round, above it, holds a records file"
}

# The carry form: the carried records with the edits applied, then the
# new records appended, written to stdout. An edit to a field a record
# already holds rewrites that line where it stands; an edit to a field
# it lacks appends the line after the record's others, in the order
# state, state-detail, settled-at, severity-override. Arguments are the
# carried records file, the edits file and the new-records file, either
# of the last two possibly empty. Every refusal is decided before the
# first record is printed, and exits 2 with its message on stderr. Only
# a round-0 seed may hold a record without a state, so a result for
# round 1 or later that leaves one unstamped is refused.
build_carried_records() {
  awk -v prog="$PROGRAM" -v round="$round" \
      -v carried_file="$1" -v edits_file="$2" -v new_file="$3" '
    function refuse(msg) {
      printf "%s: %s\n", prog, msg | "cat 1>&2"
      failed = 1
      exit 2
    }
    BEGIN {
      canon[1] = "state"; canon[2] = "state-detail"
      canon[3] = "settled-at"; canon[4] = "severity-override"
      for (i = 1; i <= 4; i++) editable[canon[i]] = 1
    }
    FNR == 1 { open = 0 }
    FILENAME == carried_file {
      if ($0 == "") { open = 0; next }
      if (!open) {
        if ($0 !~ /^T[0-9]+$/)
          refuse("the carried records file has a record opening with \"" $0 "\" rather than its id")
        open = 1
        cur = substr($0, 2) + 0
        carried[$0] = cur
        present[cur] = 1
        if (cur > max) max = cur
      }
      lines[cur, ++count[cur]] = $0
      next
    }
    FILENAME == edits_file {
      if ($0 == "") next
      tab = index($0, "\t")
      rest = substr($0, tab + 1)
      tab2 = index(rest, "\t")
      if (!tab || !tab2)
        refuse("--edits line " FNR " is not <id><tab><field><tab><value>: " $0)
      id = substr($0, 1, tab - 1)
      field = substr(rest, 1, tab2 - 1)
      value = substr(rest, tab2 + 1)
      if (!(id in carried))
        refuse("--edits line " FNR " names " id ", which no carried record has: " $0)
      if (!(field in editable))
        refuse("--edits line " FNR " names field " field ", which is not state, state-detail, settled-at or severity-override: " $0)
      if (field == "state" && value !~ /^(disproved|unsettled|retired)$/)
        refuse("--edits line " FNR " sets state " value ", which is not disproved, unsettled or retired: " $0)
      if ((id, field) in edit)
        refuse("--edits line " FNR " edits " field " of " id " a second time: " $0)
      edit[id, field] = value
      next
    }
    FILENAME == new_file {
      if ($0 == "") { open = 0; next }
      if (!open) {
        if ($0 in carried)
          refuse("the new record " $0 " has an id a carried record already holds")
        want = "T" (max + added + 1)
        if ($0 != want)
          refuse("the new record " $0 " is not the next id in sequence, which is " want)
        open = 1
        added++
        cur = substr($0, 2) + 0
        present[cur] = 1
      }
      lines[cur, ++count[cur]] = $0
    }
    END {
      if (failed) exit 2
      last = max + added
      for (n = 1; n <= last; n++) {
        if (!(n in present)) continue
        id = "T" n
        stamped = 0
        for (i = 2; i <= count[n]; i++) {
          key = lines[n, i]
          sub(/:.*/, "", key)
          if (key == "state") stamped = 1
          if ((id, key) in edit) {
            done[id, key] = 1
            lines[n, i] = key ":" (edit[id, key] == "" ? "" : " " edit[id, key])
          }
        }
        for (j = 1; j <= 4; j++) {
          key = canon[j]
          if (!((id, key) in edit) || ((id, key) in done)) continue
          if (key == "state") stamped = 1
          lines[n, ++count[n]] = key ":" (edit[id, key] == "" ? "" : " " edit[id, key])
        }
        if (round >= 1 && !stamped) unstamped = unstamped " " id
      }
      if (unstamped != "")
        refuse("round " round " would leave these records without a state:" unstamped)
      sep = ""
      for (n = 1; n <= last; n++) {
        if (!(n in present)) continue
        printf "%s", sep
        for (i = 1; i <= count[n]; i++) print lines[n, i]
        sep = "\n"
      }
    }
  ' "$1" "$2" "$3"
}

migrate_old_layout

# Every mode that writes writes into the same directory; the reading
# modes and delete create nothing, and neither does a refused carry,
# which creates the directory only once its file is built.
make_dir() {
  mkdir -p "$dir"
  write_repo_yml
}
case "$mode" in
  print|print-records|print-round-records|print-review|list|delete) ;;
  records) [ -n "$carry" ] || make_dir ;;
  *) make_dir ;;
esac

case "$mode" in
  anchor)
    # Idempotent, because the anchor is one line among appends every
    # other actor makes: the write is keyed on whether an anchor is
    # already there, never on whether the file is — a child that starts
    # first creates it with its own enter record.
    old_head=
    if [ -e "$file" ]; then
      old_head=$(awk '$1=="anchor"{print $3; exit}' "$file")
    fi
    if [ -z "$old_head" ]; then
      printf 'anchor %s %s\n' "$(now)" "$head_sha" >> "$file"
    elif [ "$old_head" != "$head_sha" ]; then
      # A different head means the records describe a tree that no
      # longer exists, so they answer for nothing the new round will ask
      # — but they are still the evidence of what the voided round did,
      # so the round's whole directory is set aside rather than
      # overwritten. The result files go with the log because a reader
      # takes a report's existence as a settled theorem, and one left in
      # place under its own name would settle the fresh round's theorem
      # from the voided tree.
      stamp=$(date -u +%Y%m%dT%H%M%SZ)
      mv -- "$dir" "$dir.voided-$stamp"
      mkdir -p "$dir"
      printf 'anchor %s %s\n' "$(now)" "$head_sha" > "$file"
    fi
    # An anchor already naming this head is this same round's: the call
    # writes nothing and says so by exiting zero.
    ;;
  spawn)
    printf 'spawn %s %s %s %s %s %s\n' \
      "$theorem" "$stage" "$(now)" "$agent" "$model" "$effort" >> "$file"
    ;;
  enter)
    printf 'enter %s %s %s %s %s\n' \
      "$theorem" "$stage" "$(now)" "$(this_agent_id)" "$(transcript_path)" >> "$file"
    ;;
  leave)
    # The report is written before the record that names it, so a run
    # that dies between the two leaves the report readable rather than a
    # record pointing at nothing.
    store_payload "$result_file" report
    printf 'leave %s %s %s %s %s\n' \
      "$theorem" "$stage" "$(now)" "$(this_agent_id)" "$result_file" >> "$file"
    ;;
  return)
    printf 'return %s %s %s %s tokens=%s tools=%s ms=%s\n' \
      "$theorem" "$stage" "$(now)" "$agent_id" "$tokens" "$tools" "$ms" >> "$file"
    ;;
  stopped)
    printf 'stopped %s %s %s\n' "$theorem" "$stage" "$(now)" >> "$file"
    ;;
  print)
    [ -e "$file" ] || die "no round log at $file"
    cat -- "$file"
    # Every result file present, synthesized from the directory at read
    # time rather than stored: a report written by a child whose leave
    # record never landed still reaches the reader this way.
    for found in "$dir"/*; do
      [ -e "$found" ] || continue
      rest=${found##*/}
      case "$rest" in
        log|records|review|*.partial-*) continue ;;
      esac
      printf 'result %s %s %s\n' "${rest%%-*}" "${rest#*-}" "$found"
    done
    ;;
  records)
    if [ -z "$carry" ]; then
      store_payload "$records_file" records
    else
      # The carried round is the one below --round, so a resumed reviewer
      # whose earlier instance already stored this round's records
      # rebuilds them from the same input rather than from its own
      # output.
      records_below_round
      [ -n "$best" ] || die "--carry found no round below --round $round under $pr_dir holding a records file"
      # The new records may be empty, so the payload is read rather than
      # stored through store_payload, which refuses an empty one. The
      # result is built beside it and installed into the round's
      # directory only once nothing refused it.
      make_work
      read_payload "$work/new" "new records"
      build_carried_records "$best/records" "${edits:-/dev/null}" "$work/new" > "$work/records" \
        || exit 2
      make_dir
      install_whole "$work/records" "$records_file"
    fi
    ;;
  review)
    store_payload "$review_file" review
    ;;
  print-records)
    # The caller does not name the round to read, and which round wrote
    # the records is what the first line of the output says. A --round bounds the
    # selection to the rounds below it, because a round whose records an
    # earlier instance of it already stored carries the round below's,
    # not its own. The bound refuses as the carry does, so a stale
    # --round fails at this read rather than at the carry that follows.
    if [ -n "$round" ]; then
      records_below_round
      [ -n "$best" ] || die "no round below --round $round under $pr_dir holds a records file"
    else
      latest_records_round
      [ -n "$best" ] || die "no round under $pr_dir holds a records file"
    fi
    printf 'round %s\n' "$best_round"
    cat -- "$best/records"
    ;;
  print-round-records)
    [ -e "$records_file" ] || die "no round records at $records_file"
    cat -- "$records_file"
    ;;
  print-review)
    [ -e "$review_file" ] || die "no round review at $review_file"
    cat -- "$review_file"
    ;;
  list)
    # A repo no review has run against has no directory, which is an
    # empty list rather than an error.
    for found in "$repo_dir"/pr*; do
      [ -d "$found" ] || continue
      n=${found##*/pr}
      case "$n" in
        ''|*[!0-9]*) continue ;;
      esac
      printf '%s\n' "$n"
    done | sort -n
    ;;
  delete)
    # The one mode that deletes. A directory already gone is the state
    # the call asks for, so it succeeds silently.
    rm -rf -- "$pr_dir"
    ;;
esac
