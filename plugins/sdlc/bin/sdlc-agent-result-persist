#!/usr/bin/env bash
# Record one theorem-review round's progress in a log outside every
# worktree, and hold each child's full report, the round's theorem
# records and the round's argued review in files of their own, so a
# round completes from what is on disk rather than from what a caller
# heard back, and so the next round reads its predecessor's records off
# disk rather than off the PR. It derives what a reviewer reads off that
# state — the arm a resumed round is in, each theorem's disposition,
# severity, state and the verdicts, and the posted review body — so no
# model re-derives them by hand. It also records every agent spawned for
# a PR and prints the agent ids its state names, lists the PRs a repo
# holds state for and deletes one PR's state whole, which is the only way
# any of it is ever removed, and lists the repositories the state root
# holds.
#
# Every path is composed here and nowhere else — the repository's
# repo.yml, the round log, each result file, the records file, the
# review file, the PR's agents log, and each child's harness transcript
# — so no agent ever opens one of these files by a path string of its
# own, to mistype or to carry across a turn boundary. An agent that names
# the state root in prose, to point a human at the directory, is doing
# something else.
#
# The contract this implements — modes, flags, paths, line grammar — is
# plugins/sdlc/skills/agent-result-persist-interface/SKILL.md.
set -euo pipefail

readonly PROGRAM=${0##*/}

die() {
  printf '%s: %s\n' "$PROGRAM" "$1" >&2
  exit 2
}

# A command that fails where the script does not handle it dies like
# every other failure here, naming the command, and never exits with the
# tool's own status. `set -E` carries the trap into functions and command
# substitutions; a substitution whose failure the script handles ends in
# `|| exit` inside it, so the trap stays quiet in the substitution's own
# shell.
set -E
trap 'die "\`$BASH_COMMAND\` failed (exit $?)"' ERR

usage() {
  cat <<EOF
usage: $PROGRAM --mode anchor|spawn|enter|leave|return|stopped|print
                       |print-in-flight|records|review|print-records
                       |print-round-records|print-review|print-root|agent
                       |print-agents|delete|next|dispose|summary
                --pr <host>/<owner>/<repo>#<n> [--round <n>]
                [--head-sha <sha>] [--round-type <type>] [--theorem <id>]
                [--stage generate|disprove|verify] [--agent <name>]
                [--model <name>] [--effort <name>] [--agent-id <id>]
                [--tokens <n>] [--tools <n>] [--ms <n>] [--from <path>]
                [--carry] [--edits <path>] [--full]
                [--deadline-minutes <n>] [--loop-exited] [--issues <issues>]
       $PROGRAM --mode list [((<host>/)<owner>/)<repo> | https://<host>/<owner>/<repo>]
       $PROGRAM --mode repos
EOF
}

mode=
pr_ref=
operand=
operands=0
pr=
round=
head_sha=
round_type=
theorem=
stage=
agent=
model=
effort=
agent_id=
tokens=
tools=
ms=
from=
carry=
edits=
full=
loop_exited=
deadline_minutes=
issues=

while [ "$#" -gt 0 ]; do
  flag=$1
  case "$flag" in
    --mode|--pr|--round|--head-sha|--round-type|--theorem|--stage|--agent|--model|--effort|--agent-id|--tokens|--tools|--ms|--from|--edits|--deadline-minutes|--issues)
      [ "$#" -ge 2 ] || die "$flag needs a value"
      value=$2
      shift 2
      ;;
    --carry)
      carry=1
      shift
      continue
      ;;
    --full)
      full=1
      shift
      continue
      ;;
    --loop-exited)
      loop_exited=1
      shift
      continue
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -*)
      die "unknown argument: $flag"
      ;;
    *)
      operand=$flag
      operands=$((operands + 1))
      shift
      continue
      ;;
  esac
  case "$flag" in
    --mode)       mode=$value ;;
    --pr)         pr_ref=$value ;;
    --round)      round=$value ;;
    --head-sha)   head_sha=$value ;;
    --round-type) round_type=$value ;;
    --theorem)    theorem=$value ;;
    --stage)      stage=$value ;;
    --agent)      agent=$value ;;
    --model)      model=$value ;;
    --effort)     effort=$value ;;
    --agent-id)   agent_id=$value ;;
    --tokens)     tokens=$value ;;
    --tools)      tools=$value ;;
    --ms)         ms=$value ;;
    --from)       from=$value ;;
    --edits)      edits=$value ;;
    --deadline-minutes) deadline_minutes=$value ;;
    --issues)     issues=$value ;;
  esac
done

case "$mode" in
  anchor|spawn|enter|leave|return|stopped|print|print-in-flight) ;;
  records|review|print-records|print-round-records|print-review|print-root) ;;
  agent|print-agents|list|delete|repos|next|dispose|summary) ;;
  '') die "--mode is required" ;;
  *)  die "unknown --mode: $mode" ;;
esac

# The state root as the script opens it, and as the signpost a human is
# shown, unexpanded; the two spell the same fallback and change together.
readonly state_root="${XDG_STATE_HOME:-$HOME/.local/state}/sdlc"
readonly state_root_form="\${XDG_STATE_HOME:-\$HOME/.local/state}/sdlc"

# is_old_layout <dir>: whether a directory two levels below the state
# root is a repository's state from before the host was part of the
# path. Such a directory is <owner>/<repo> by position, carries no
# repo.yml, and holds its pr<n> directories directly. A <host>/<owner>
# directory of the current layout sits at the same depth and holds
# repositories, so it is never old, with or without a repo.yml beneath it.
is_old_layout() {
  [ -d "$1" ] || return 1
  [ -e "$1/repo.yml" ] && return 1
  for found in "$1"/*/repo.yml; do
    [ -e "$found" ] && return 1
  done
  for found in "$1"/pr*; do
    case "${found##*/}" in
      pr|pr*[!0-9]*) continue ;;
    esac
    [ -d "$found" ] && return 0
  done
  return 1
}

# An operand names a repository, which list alone takes in that form:
# every other mode is named by its PR, and repos by nothing.
if [ "$operands" -gt 0 ]; then
  [ "$mode" = list ] || die "--mode $mode takes no operand: $operand"
  [ "$operands" -eq 1 ] || die "--mode list takes at most one repository"
fi

# repos reads across every repository the state root holds, so it takes
# no identifying flag. It reads each repository from its repo.yml, and
# names a directory of the old layout, which has none, by its path.
if [ "$mode" = repos ]; then
  for pair in "pr:$pr_ref" "round:$round"; do
    [ -z "${pair#*:}" ] || die "--${pair%%:*} is not accepted in --mode repos: ${pair#*:}"
  done
  [ -d "$state_root" ] || exit 0
  find "$state_root" -name repo.yml -type f | sort | while IFS= read -r yml; do
    at=${yml%/repo.yml}
    at=${at#"$state_root"/}
    named=$(awk -F': *' '$1=="host"{h=$2} $1=="owner"{o=$2} $1=="repo"{r=$2} END{print h "/" o "/" r}' "$yml")
    if [ "$named" = "$at" ]; then
      printf 'repo %s %s\n' "$named" "$at"
    else
      printf 'mismatch %s %s\n' "$named" "$at"
    fi
  done
  for at in "$state_root"/*/*; do
    is_old_layout "$at" || continue
    printf 'old %s %s\n' "${at#"$state_root"/}" "${at#"$state_root"/}"
  done
  exit 0
fi

# split_repo <host/owner/repo> <message>: sets repo_ref to the reference
# whole and host, owner and repo to its segments, each one level of the
# composed path, or dies with <message> when the reference is not three
# segments. The host is a segment because one machine holds state for
# repositories on several hosts, and the same owner/repo on two of them
# is two repositories. A segment holding anything but letters, digits,
# ., _ and - could add a directory level, and a segment of . or .. names
# no directory of its own: .. climbs out of the level it stands at, and
# . lets another segment climb further, so either could compose a path
# outside the state root that every mode reads, writes or deletes under.
split_repo() {
  case "$1" in
    */*/*/*|*//*|/*|*/) die "$2" ;;
    ?*/?*/?*) ;;
    *) die "$2" ;;
  esac
  repo_ref=$1
  host=${1%%/*}
  owner=${1#*/}
  owner=${owner%/*}
  repo=${1##*/}
  for given in "$host" "$owner" "$repo"; do
    case "$given" in
      *[!A-Za-z0-9._-]*|.|..)
        die "a repository's segments may hold only letters, digits, ., _ and -, and none may be . or ..: $repo_ref" ;;
    esac
  done
}

# current_repo: the current repository as host/owner/repo, from the URL
# gh reports for the checkout, whose remote names the host. Dies when gh
# cannot resolve it.
current_repo() {
  url=$(gh repo view --json url --jq .url || exit) \
    || die "cannot resolve the current repository with gh repo view"
  url=${url#https://}
  printf '%s\n' "${url%/}"
}

# list names its repository by the operand: host/owner/repo, an
# https://host/owner/repo URL, or a shorter form whose missing leading
# segments come from the current repository; with no operand, list reads
# the current repository itself. Every other mode names its PR by --pr,
# host/owner/repo#n, the host included and nothing taken from the
# checkout.
if [ "$mode" = list ]; then
  [ -z "$pr_ref" ] || die "--pr is not accepted in --mode list: $pr_ref"
  bad_operand="--mode list takes ((<host>/)<owner>/)<repo> or https://<host>/<owner>/<repo>: $operand"
  case "$operand" in
    https://*)
      given=${operand#https://}
      given=${given%/}
      ;;
    *://*|-*) die "$bad_operand" ;;
    */*/*) given=$operand ;;
    */*)
      [ -n "${operand%%/*}" ] || die "$bad_operand"
      here=$(current_repo) || exit $?
      given=${here%%/*}/$operand
      ;;
    '') given=$(current_repo) || exit $? ;;
    *)
      here=$(current_repo) || exit $?
      given=${here%/*}/$operand
      ;;
  esac
  split_repo "$given" "$bad_operand"
else
  [ -n "$pr_ref" ] || die "--pr is required"
  bad_pr="--pr takes <host>/<owner>/<repo>#<n>: $pr_ref"
  case "$pr_ref" in
    *'#'*) ;;
    *) die "$bad_pr" ;;
  esac
  pr=${pr_ref##*'#'}
  case "$pr" in
    ''|*[!0-9]*) die "$bad_pr" ;;
  esac
  split_repo "${pr_ref%'#'*}" "$bad_pr"
fi

# A mode refuses an identifying flag it does not act at: delete removes
# a whole PR's directory, print-root names it, agent and print-agents
# write and read the PR's agents log beside its rounds, and list reads
# above every PR's, so a caller passing one would be naming a round the
# mode is not going to touch. print-records selects the round itself, so
# a --round given to it bounds that selection from above rather than
# naming the round.
case "$mode" in
  delete|list|print-root|agent|print-agents)
    [ -z "$round" ] || die "--round is not accepted in --mode $mode: $round"
    ;;
  print-records)
    ;;
  *)
    [ -n "$round" ] || die "--round is required"
    ;;
esac
case "$round" in
  *[!0-9]*) die "--round must be a number: $round" ;;
esac

# Every column of every record is whitespace-separated, so a value
# carrying whitespace would shift the columns of its line and
# desynchronise the reader's derivation from the writer's intent.
single_token() {
  case "$2" in
    *[!A-Za-z0-9._:-]*) die "--$1 must be a single token: $2" ;;
  esac
}

case "$mode" in
  spawn|enter|leave|return|stopped)
    [ -n "$theorem" ] || die "--theorem is required in --mode $mode"
    single_token theorem "$theorem"
    # A result file is named <theorem>-<agent> and --mode print splits
    # it back apart at the first dash, so the theorem id carries none
    # and the agent name is free to.
    case "$theorem" in
      *-*) die "--theorem must carry no dash: $theorem" ;;
    esac
    ;;
esac
case "$mode" in
  spawn|enter|leave|return|stopped|print-in-flight)
    [ -n "$stage" ] || die "--stage is required in --mode $mode"
    case "$stage" in
      generate|disprove|verify) ;;
      *) die "--stage must be generate, disprove or verify: $stage" ;;
    esac
    ;;
esac

# The agent names which definition the record is about, and on a leave
# it is half the result file's name, which is what print-in-flight
# looks for.
case "$mode" in
  spawn|leave|print-in-flight|agent)
    [ -n "$agent" ] || die "--agent is required in --mode $mode"
    single_token agent "$agent"
    ;;
esac

if [ "$mode" = spawn ]; then
  for pair in "model:$model" "effort:$effort"; do
    name=${pair%%:*}
    given=${pair#*:}
    [ -n "$given" ] || die "--$name is required in --mode spawn"
    single_token "$name" "$given"
  done
fi

# The agent id names which child a record is about, so a re-spawned
# theorem's second child is told apart from the first. A child derives
# its own from its worktree; only the caller has to pass one. A stopped
# record without one could only name the theorem, and would write off
# whichever child the theorem had when it landed — a replacement
# included. An agent record names the spawned agent's worktree,
# agent-<agent-id>, which is what the cleanup removes.
case "$mode" in
  return|stopped|agent)
    [ -n "$agent_id" ] || die "--agent-id is required in --mode $mode"
    single_token agent-id "$agent_id"
    ;;
esac

if [ "$mode" = anchor ]; then
  [ -n "$head_sha" ] || die "--head-sha is required in --mode anchor"
  single_token head-sha "$head_sha"
  [ -n "$round_type" ] || die "--round-type is required in --mode anchor"
fi
if [ "$mode" = next ] && [ -n "$head_sha" ]; then
  single_token head-sha "$head_sha"
fi

# A round's type is the class of file it reviews, fixed by its anchor.
# The anchor writes it; print-records without a --round selects by it,
# and every read bounded by a --round takes the type that round's anchor
# wrote rather than one a caller passes beside it.
readonly default_round_type=code-and-instruction-markdown
if [ -n "$round_type" ]; then
  case "$mode" in
    anchor) ;;
    print-records)
      [ -z "$round" ] || die "--round-type is not accepted with --round in --mode print-records: the anchor of round $round names its type"
      ;;
    *) die "--round-type is not accepted in --mode $mode: $round_type" ;;
  esac
  case "$round_type" in
    code-and-instruction-markdown|documentation) ;;
    *) die "--round-type must be code-and-instruction-markdown or documentation: $round_type" ;;
  esac
fi

# --from names the file a writing mode reads its payload from in place
# of stdin, and the file next and dispose read the round's new records
# from. A mode that reads no such file refuses it rather than ignore a
# file the caller expected to be read.
if [ -n "$from" ]; then
  case "$mode" in
    leave|records|review|next|dispose) ;;
    *) die "--from is not accepted in --mode $mode: $from" ;;
  esac
  [ -f "$from" ] || die "--from names no file: $from"
fi

# --carry is the records form that builds the round's file itself.
# --edits is that form's input, and next's and dispose's adjustments to
# the carried records.
if [ -n "$carry" ] && [ "$mode" != records ]; then
  die "--carry is not accepted in --mode $mode"
fi
if [ -n "$edits" ]; then
  case "$mode" in
    next|dispose) ;;
    *) [ -n "$carry" ] || die "--edits is accepted only with --carry, or in --mode next or dispose: $edits" ;;
  esac
  [ -f "$edits" ] || die "--edits names no file: $edits"
fi

# --full widens the live list next and dispose derive; --deadline-minutes
# is next's alone, and --loop-exited dispose's.
if [ -n "$full" ]; then
  case "$mode" in
    next|dispose) ;;
    *) die "--full is not accepted in --mode $mode" ;;
  esac
fi
if [ -n "$deadline_minutes" ]; then
  [ "$mode" = next ] || die "--deadline-minutes is not accepted in --mode $mode: $deadline_minutes"
  case "$deadline_minutes" in
    *[!0-9]*) die "--deadline-minutes must be a number: $deadline_minutes" ;;
  esac
fi
if [ -n "$loop_exited" ] && [ "$mode" != dispose ]; then
  die "--loop-exited is not accepted in --mode $mode"
fi

# --issues is the issue set dispose gives a verdict line each, whether or
# not a record tags it: the members separated by spaces or commas, each
# with or without its leading #.
if [ "$mode" = dispose ]; then
  issue_list=$(printf '%s\n' "$issues" \
    | awk '{ gsub(/,/, " "); for (i = 1; i <= NF; i++) { s = $i; sub(/^#/, "", s); printf "%s ", s } }')
  [ -n "$issue_list" ] || die "--issues is required in --mode dispose"
  case "$issue_list" in
    *[!A-Za-z0-9._\ -]*) die "--issues must name each issue as N or #N: $issues" ;;
  esac
elif [ -n "$issues" ]; then
  die "--issues is not accepted in --mode $mode: $issues"
fi

for pair in "tokens:$tokens" "tools:$tools" "ms:$ms"; do
  name=${pair%%:*}
  given=${pair#*:}
  [ -n "$given" ] || continue
  case "$given" in
    *[!0-9]*) die "--$name must be a number: $given" ;;
  esac
done

# The round gets a directory of its own under XDG state, composed from
# the identifying flags alone: no session is part of the path, so a
# round interrupted by a session ending is resumed from the same one.
readonly repo_dir="$state_root/$host/$owner/$repo"
readonly pr_dir="$repo_dir/pr$pr"
readonly dir="$pr_dir/round$round"
readonly file="$dir/log"
readonly result_file="$dir/$theorem-$agent"
readonly records_file="$dir/records"
readonly review_file="$dir/review"
readonly agents_file="$pr_dir/agents"

# A leave record carries the result file's path as one column, and the
# path runs through the state root the environment names, which no flag
# check reaches. The refusal comes before the report is stored, so it
# leaves neither the file nor the record behind.
if [ "$mode" = leave ]; then
  case "$result_file" in
    *[[:space:]]*) die "--mode leave records the result file's path as one column, and $result_file carries whitespace" ;;
  esac
fi

now() {
  date -u +%Y-%m-%dT%H:%M:%SZ
}

# The repository's state directory carries repo.yml naming the repository
# it holds, so a reader identifies the directory from the file rather than
# from its path. write_repo_yml writes it into a directory that lacks one.
write_repo_yml() {
  [ -e "$repo_dir/repo.yml" ] && return 0
  printf 'schema-version: 1\nhost: %s\nowner: %s\nrepo: %s\n' "$host" "$owner" "$repo" \
    > "$repo_dir/repo.yml.partial-$$"
  mv -- "$repo_dir/repo.yml.partial-$$" "$repo_dir/repo.yml"
}

# State written before the host was part of the path sits at
# sdlc/<owner>/<repo>/. It moves to this repository's directory, host from
# the repository split_repo parsed, before any mode reads or writes, so no
# reader falls back to the old path.
migrate_old_layout() {
  old="$state_root/$owner/$repo"
  is_old_layout "$old" || return 0
  [ ! -e "$repo_dir" ] \
    || die "state for $repo_ref is at both $old and $repo_dir; move one aside before running again"
  mkdir -p -- "${repo_dir%/*}"
  if ! mv -- "$old" "$repo_dir"; then
    # A failed move leaves no empty <host> or <host>/<owner> directory
    # behind; rmdir removes neither when it holds anything.
    rmdir -- "${repo_dir%/*}" 2>/dev/null && rmdir -- "$state_root/$host" 2>/dev/null || :
    die "could not move state for $repo_ref from $old to $repo_dir"
  fi
  rmdir -- "$state_root/$owner" 2>/dev/null || :
  write_repo_yml
}

# The harness names an isolation: worktree worktree agent-<agent-id>,
# so a child's own id is the one thing its cwd already tells it.
this_agent_id() {
  base=${PWD##*/}
  printf '%s\n' "${base#agent-}"
}

# The harness writes a child's transcript to
# ~/.claude/projects/<project>/<session>/subagents/agent-<id>.jsonl,
# where <project> is the primary clone's path with each character
# outside [A-Za-z0-9-] replaced by a dash — measured on both a / and a
# dot. The child's own cwd is a worktree, so the primary root comes from
# the common git dir rather than from $PWD. Any part of that being
# unavailable yields a dash: the record is worth more than the path.
transcript_path() {
  common=$(git rev-parse --git-common-dir 2>/dev/null || exit) || { printf -- '-\n'; return; }
  case "$common" in
    /*) ;;
    *) common=$PWD/$common ;;
  esac
  primary=$(dirname "$common")
  session=${CLAUDE_CODE_SESSION_ID:-}
  if [ -z "$session" ]; then
    printf -- '-\n'
    return
  fi
  project=$(printf '%s' "$primary" | tr -c 'A-Za-z0-9-' '-')
  printf '%s\n' "$HOME/.claude/projects/$project/$session/subagents/agent-$(this_agent_id).jsonl"
}

# Scratch for a payload on its way into state, or for the files a
# derivation reads, removed on exit.
work=
make_work() {
  work=$(mktemp -d "${TMPDIR:-/tmp}/$PROGRAM.XXXXXX")
  trap 'rm -rf -- "$work"' EXIT
}

# read_payload <dest> <noun>: copies the payload, from the --from file
# when one is named and from stdin otherwise, to <dest>.
read_payload() {
  if [ -n "$from" ]; then
    cat -- "$from" > "$1" \
      || die "--mode $mode takes the $2 from --from, and $from could not be read"
  else
    cat > "$1"
  fi
}

# install_whole <source> <target>: the way every file stored whole — a
# result file, the records, the review — reaches its name, unlike the
# log, which grows by appends. It lands in a staging name and is renamed
# into place only once it is whole, because a stored file's mere
# existence is what a reader takes as settled: a file streamed straight
# to its own name would read as complete the moment the first byte
# landed, and a writer killed mid-write would leave that fragment there
# for good. The -$$ suffix is what keeps two writers from staging over
# each other.
install_whole() {
  staged="$2.partial-$$"
  if ! cp -- "$1" "$staged"; then
    rm -f -- "$staged"
    die "could not stage $2"
  fi
  mv -- "$staged" "$2"
}

# store_payload <target> <noun>: stores the payload whole at <target>,
# refusing an empty one.
store_payload() {
  make_work
  read_payload "$work/payload" "$2"
  if [ ! -s "$work/payload" ]; then
    if [ -n "$from" ]; then
      die "--mode $mode takes the $2 from --from, and $from is empty"
    fi
    die "--mode $mode takes the $2 on stdin, and nothing arrived"
  fi
  if [ "$mode" = leave ]; then
    check_report_theorem "$work/payload"
    check_report_ids "$work/payload"
  fi
  install_whole "$work/payload" "$1"
}

# A disprover's or verifier's report names the theorem it answers on its
# THEOREM: line, and the stored file is named for --theorem, so a report
# handed over from another child would settle a theorem it never
# answered. The check runs on the read copy, before it is installed and
# before the leave record, so a refused report leaves neither behind. A
# generator's report is a theorem list and carries no such line.
check_report_theorem() {
  case "$stage" in
    disprove|verify) ;;
    *) return 0 ;;
  esac
  answered=$(awk '/^THEOREM:/ {
      sub(/^THEOREM:[ \t]*/, ""); sub(/[ \t\r]+$/, ""); print; exit
    }' "$1")
  if [ -z "$answered" ]; then
    rm -f -- "$1"
    die "--mode leave --stage $stage stores a report for --theorem $theorem, and the report has no THEOREM: line naming one"
  fi
  if [ "$answered" != "$theorem" ]; then
    rm -f -- "$1"
    die "--mode leave --stage $stage was given --theorem $theorem, and the report's THEOREM: line names $answered"
  fi
}

# The rule every new theorem id is held to, as awk source both the carry
# form and a generator's leave load: new_id_refusal returns why <id>
# cannot be the next new record's id — one a carried record holds, or
# one out of sequence — naming the id expected instead, or returns empty
# and counts the id as added. The caller keeps the carried ids in
# carried[], the highest carried number in max, the highest number any
# round below holds, of either type, in floor, and the ids accepted so
# far in added. Ids run in one sequence per PR across both round types,
# so the next one is above whichever of max and floor is higher.
readonly new_id_rule='
  function id_base() { return (floor + 0 > max + 0) ? floor + 0 : max + 0 }
  function new_id_refusal(id,    want) {
    want = "T" (id_base() + added + 1)
    if (id in carried)
      return "the new record " id " has an id a carried record already holds; the next id in sequence is " want
    if (id != want)
      return "the new record " id " is not the next id in sequence, which is " want
    added++
    return ""
  }'

# A generator's report is the round's new theorems, and an id it gives
# one must continue the PR's sequence: one above the highest id any round
# below --round holds, of either type, or T1 when none holds any. The
# records it checks a collision against are the round's carried ones,
# those print-records would read. The ids are the lines holding nothing
# but T<n> above any RETIREMENTS line, checked in order against
# new_id_rule before the report is installed, so a refused list leaves no
# result file and no leave record behind.
check_report_ids() {
  [ "$stage" = generate ] || return 0
  records_below_round
  carried_file=/dev/null
  [ -z "$best" ] || carried_file=$best/records
  refusal=$(awk -v carried_file="$carried_file" -v floor="$id_floor" "$new_id_rule"'
    FNR == 1 { open = 0 }
    FILENAME == carried_file {
      if ($0 == "") { open = 0; next }
      if (!open) {
        open = 1
        carried[$0] = 1
        if (substr($0, 2) + 0 > max) max = substr($0, 2) + 0
      }
      next
    }
    { line = $0; sub(/[ \t\r]+$/, "", line) }
    line == "RETIREMENTS" { exit }
    line ~ /^T[0-9]+$/ {
      msg = new_id_refusal(line)
      if (msg != "") { print msg; exit }
    }' "$carried_file" "$1" || exit) || die "could not read the ids of the report for --round $round"
  if [ -n "$refusal" ]; then
    rm -f -- "$1"
    die "--mode leave --stage generate --round $round refused: $refusal"
  fi
}

# round_type_of <round directory>: the type the round's anchor wrote. A
# round with no anchor naming one — round 0, which holds the seed and
# its generator's spawn record, or a round anchored before rounds had a
# type — reviewed code and instruction Markdown.
round_type_of() {
  anchored_type=
  if [ -f "$1/log" ]; then
    anchored_type=$(awk '$1 == "anchor" { print $4; exit }' "$1/log")
  fi
  printf '%s\n' "${anchored_type:-$default_round_type}"
}

# The records to carry forward are the most recent ones there are, so
# this sets best_round and best to the highest-numbered round holding a
# records file, and leaves both empty when none does. Given a round
# number, it considers only the rounds below that one, and sets
# above_round to the highest round above it holding a records file, of
# either type, leaving it empty when none does. Given a type, with or
# without a round number, it sets best_round and best from the rounds of
# that type alone, since a round carries only the records of its own
# type. Either way it sets id_floor to the highest theorem id the
# records of every round it considers hold, of either type, 0 when they
# hold none, because ids run in one sequence across both types. A voided
# round's directory carries its records with it under the .voided- name,
# and is skipped for the same reason its result files are — it describes
# a tree that no longer exists.
latest_records_round() {
  best=
  best_round=
  above_round=
  id_floor=0
  for candidate in "$pr_dir"/round*; do
    [ -d "$candidate" ] || continue
    base=${candidate##*/}
    case "$base" in
      *.voided-*) continue ;;
    esac
    n=${base#round}
    case "$n" in
      ''|*[!0-9]*) continue ;;
    esac
    [ -f "$candidate/records" ] || continue
    if [ -n "${1-}" ] && [ "$n" -ge "$1" ]; then
      if [ "$n" -gt "$1" ] && { [ -z "$above_round" ] || [ "$n" -gt "$above_round" ]; }; then
        above_round=$n
      fi
      continue
    fi
    top=$(awk '/^T[0-9]+$/ { n = substr($0, 2) + 0; if (n > m) m = n } END { print m + 0 }' \
      "$candidate/records")
    [ "$top" -le "$id_floor" ] || id_floor=$top
    if [ -n "${2-}" ] && [ "$(round_type_of "$candidate")" != "$2" ]; then
      continue
    fi
    if [ -z "$best_round" ] || [ "$n" -gt "$best_round" ]; then
      best_round=$n
      best=$candidate
    fi
  done
}

# The rounds below --round, for a call that reads records from there:
# sets best_round, best and id_floor as latest_records_round does for the
# type the round's own anchor wrote, and refuses when a round above
# --round holds records. Such a round was built from the records below
# it, so --round is not the round under way and what the rounds below
# hold is no longer the latest state.
records_below_round() {
  latest_records_round "$round" "$(round_type_of "$dir")"
  [ -z "$above_round" ] \
    || die "--mode $mode${carry:+ --carry} --round $round refused: round $above_round, above it, holds a records file"
}

# The carry form: the carried records with the edits applied, then the
# new records appended, written to stdout. An edit to a field a record
# already holds rewrites that line where it stands; an edit to a field
# it lacks appends the line after the record's others, in the order
# state, state-detail, settled-at, severity-override. Arguments are the
# carried records file, the edits file, the new-records file and the id
# floor records_below_round set, the edits and new-records files each
# possibly empty. Every refusal is decided before the first record is
# printed, and exits 2 with its message on stderr. Only a round-0 seed
# may hold a record without a state, so a result for round 1 or later
# that leaves one unstamped is refused — unless the fifth argument is
# "unstamped", which next and dispose pass: they read the round's records
# before its states are stamped.
build_carried_records() {
  awk -v prog="$PROGRAM" -v round="$round" -v floor="$4" -v unstamped_ok="${5-}" \
      -v carried_file="$1" -v edits_file="$2" -v new_file="$3" "$new_id_rule"'
    function refuse(msg) {
      printf "%s: %s\n", prog, msg | "cat 1>&2"
      failed = 1
      exit 2
    }
    BEGIN {
      canon[1] = "state"; canon[2] = "state-detail"
      canon[3] = "settled-at"; canon[4] = "severity-override"
      for (i = 1; i <= 4; i++) editable[canon[i]] = 1
    }
    FNR == 1 { open = 0 }
    FILENAME == carried_file {
      if ($0 == "") { open = 0; next }
      if (!open) {
        if ($0 !~ /^T[0-9]+$/)
          refuse("the carried records file has a record opening with \"" $0 "\" rather than its id")
        open = 1
        cur = substr($0, 2) + 0
        carried[$0] = cur
        present[cur] = 1
        if (cur > max) max = cur
      }
      lines[cur, ++count[cur]] = $0
      next
    }
    FILENAME == edits_file {
      if ($0 == "") next
      tab = index($0, "\t")
      rest = substr($0, tab + 1)
      tab2 = index(rest, "\t")
      if (!tab || !tab2)
        refuse("--edits line " FNR " is not <id><tab><field><tab><value>: " $0)
      id = substr($0, 1, tab - 1)
      field = substr(rest, 1, tab2 - 1)
      value = substr(rest, tab2 + 1)
      if (!(id in carried))
        refuse("--edits line " FNR " names " id ", which no carried record has: " $0)
      if (!(field in editable))
        refuse("--edits line " FNR " names field " field ", which is not state, state-detail, settled-at or severity-override: " $0)
      if (field == "state" && value !~ /^(disproved|unsettled|retired)$/)
        refuse("--edits line " FNR " sets state " value ", which is not disproved, unsettled or retired: " $0)
      if ((id, field) in edit)
        refuse("--edits line " FNR " edits " field " of " id " a second time: " $0)
      edit[id, field] = value
      next
    }
    FILENAME == new_file {
      if ($0 == "") { open = 0; next }
      if (!open) {
        msg = new_id_refusal($0)
        if (msg != "") refuse(msg)
        open = 1
        cur = substr($0, 2) + 0
        present[cur] = 1
      }
      lines[cur, ++count[cur]] = $0
    }
    END {
      if (failed) exit 2
      last = id_base() + added
      for (n = 1; n <= last; n++) {
        if (!(n in present)) continue
        id = "T" n
        stamped = 0
        for (i = 2; i <= count[n]; i++) {
          key = lines[n, i]
          sub(/:.*/, "", key)
          if (key == "state") stamped = 1
          if ((id, key) in edit) {
            done[id, key] = 1
            lines[n, i] = key ":" (edit[id, key] == "" ? "" : " " edit[id, key])
          }
        }
        for (j = 1; j <= 4; j++) {
          key = canon[j]
          if (!((id, key) in edit) || ((id, key) in done)) continue
          if (key == "state") stamped = 1
          lines[n, ++count[n]] = key ":" (edit[id, key] == "" ? "" : " " edit[id, key])
        }
        if (round >= 1 && !stamped && unstamped_ok != "unstamped") unstamped = unstamped " " id
      }
      if (unstamped != "")
        refuse("round " round " would leave these records without a state:" unstamped)
      sep = ""
      for (n = 1; n <= last; n++) {
        if (!(n in present)) continue
        printf "%s", sep
        for (i = 1; i <= count[n]; i++) print lines[n, i]
        sep = "\n"
      }
    }
  ' "$1" "$2" "$3"
}

# list_results <round directory>: one "<theorem> <agent> <path>" line per
# result file the directory holds: the log, the records, the review and a
# staging file are not results.
list_results() {
  for found in "$1"/*; do
    [ -e "$found" ] || continue
    rest=${found##*/}
    case "$rest" in
      log|records|review|*.partial-*) continue ;;
    esac
    printf '%s %s %s\n' "${rest%%-*}" "${rest#*-}" "$found"
  done
}

# The round's records as next and dispose read them, into $work/records:
# the carried records the carry form would read, the --edits adjustments
# applied, and the --from new records appended, no state yet required.
# Their refusals are the carry form's.
load_round_records() {
  records_below_round
  carried_file=/dev/null
  [ -z "$best" ] || carried_file=$best/records
  build_carried_records "$carried_file" "${edits:-/dev/null}" "${from:-/dev/null}" "$id_floor" unstamped \
    > "$work/records" || exit 2
}

# The derivation next and dispose share, as awk source. It reads the
# round's records (records_file), the --edits file (edits_file), the round
# log (log_file) and the round's result files (results_file, as
# list_results prints them), and leaves in END: ids[1..nid] in id order
# with rec[id, field], and, from the log, which child each stage's
# theorem has and how it ended. derive_live() fills the live list,
# live[1..nlive] with islive[id], and the appended program calls it.
#
# A theorem is live unless this round's edits retire it; on a default
# round it is live when it holds no state, or disproved or unsettled; on a
# --full round unless its state-detail is human-refuted.
#
# read_report classifies a disprover's or verifier's report on the
# grammar theorem-disprover.md and counterexample-verifier.md give under
# "Output", setting rv to its verdict, empty unless the report holds
# exactly one VERDICT: line, rc to its consequence class when that is
# one of the four tokens and empty otherwise, and rok to 1 when the
# report is well formed for its verdict. A DISPROVED report whose class
# line holds no token is well formed; only the class is underivable.
# Whether a quote is verbatim is the verifier's to check, not the
# grammar's.
derive_lib() {
  cat <<'AWK'
  function trim(s) { sub(/^[ \t\r]+/, "", s); sub(/[ \t\r]+$/, "", s); return s }
  function is_class(c) {
    return c ~ /^(breaks-production|behavior-broken-or-criterion-unmet|defect-no-shipped-breakage|optional-polish)$/
  }
  function stage_agent(st) { return st == "disprove" ? "theorem-disprover" : "counterexample-verifier" }
  # A stage other than generate has one definition, and its file is the
  # one. The list is the file of the generator the last spawn record for
  # list names, since a replacement at another tier writes a file of its
  # own; the file of any generator settles it while no spawn record names
  # one.
  function has_result(st, t) {
    if (st != "generate") return (t SUBSEP stage_agent(st)) in result
    return (t in gen_agent) ? ((t SUBSEP gen_agent[t]) in result) : list_result
  }
  # settled(st, t): whether the stage is done with the theorem, by a
  # leave record for it or by its result file. For the list, only a leave
  # by the generator the last spawn record names counts.
  function settled(st, t) {
    if (st == "generate" && (t in gen_agent)) return ((t SUBSEP gen_agent[t]) in left_as) || has_result(st, t)
    return ((st SUBSEP t) in left) || has_result(st, t)
  }
  function read_report(path, stage,    line, key, v, nv, has, content, val, quoted, last) {
    split("", has); split("", content); split("", val)
    nv = 0; quoted = 0; last = ""
    while ((getline line < path) > 0) {
      if (match(line, /^(VERDICT|THEOREM|COUNTEREXAMPLE|EVIDENCE|CONSEQUENCE|CONSEQUENCE-CLASS|CHECKED|REASON):/)) {
        key = substr(line, 1, RLENGTH - 1)
        v = trim(substr(line, RLENGTH + 1))
        if (key == "VERDICT") nv++
        if (!(key in has)) { has[key] = 1; val[key] = v }
        if (v != "") content[key] = 1
        last = key
        continue
      }
      if (last == "EVIDENCE" && line ~ /^>/) quoted = 1
      if (last != "" && trim(line) != "") content[last] = 1
    }
    close(path)
    rv = nv == 1 ? val["VERDICT"] : ""
    rc = is_class(val["CONSEQUENCE-CLASS"]) ? val["CONSEQUENCE-CLASS"] : ""
    rok = 0
    if (stage == "disprove") {
      if (rv == "SURVIVED") rok = ("CHECKED" in content)
      else if (rv == "DISPROVED")
        rok = ("COUNTEREXAMPLE" in content) && quoted && ("CONSEQUENCE" in content) && ("CONSEQUENCE-CLASS" in has)
    } else {
      if (rv == "REFUTED") rok = ("REASON" in content)
      else if (rv == "STANDS") rok = ("CONSEQUENCE" in content) && rc != ""
    }
  }
  # disproved_ok(t): whether the disprover report of t is a well-formed
  # DISPROVED one, which is what earns it a verifier.
  function disproved_ok(t) {
    if (!has_result("disprove", t)) return 0
    read_report(result[t, "theorem-disprover"], "disprove")
    return rv == "DISPROVED" && rok
  }
  FNR == 1 { open = 0 }
  FILENAME == records_file {
    if ($0 == "") { open = 0; next }
    if (!open) { open = 1; cur = $0; ids[++nid] = cur; next }
    key = $0; sub(/:.*/, "", key)
    v = $0; sub(/^[^:]*:[ ]?/, "", v)
    rec[cur, key] = v
    next
  }
  FILENAME == edits_file {
    split($0, f, "\t")
    if (f[2] == "state" && f[3] == "retired") retired_now[f[1]] = 1
    next
  }
  FILENAME == log_file {
    if ($1 == "anchor") { if (anchor == "") anchor = $3; next }
    if ($1 == "spawn" || $1 == "enter") fanned = 1
    t = $2; st = $3
    if ($1 == "spawn" && st == "generate") gen_agent[t] = $5
    if ($1 == "enter") {
      if (!((st SUBSEP t) in child)) entered[st, ++nentered[st]] = t
      child[st, t] = $5; at[st, t] = $4
    }
    if ($1 == "leave") {
      left[st, t] = 1; ended[st, t, $5] = 1
      # The agent a leave wrote for is the name of its result file past
      # the theorem and its dash.
      name = $6; sub(/.*\//, "", name)
      if (st == "generate") left_as[t, substr(name, length(t) + 2)] = 1
    }
    if ($1 == "stopped") ended[st, t, $5] = 1
    if ($1 == "return") returned[st, t, $5] = 1
    next
  }
  FILENAME == results_file {
    result[$1, $2] = $3
    if ($1 == "list") list_result = 1
    next
  }
  function derive_live(    i, t, s) {
    for (i = 1; i <= nid; i++) {
      t = ids[i]
      if (t in retired_now) continue
      s = rec[t, "state"]
      if (full) { if (rec[t, "state-detail"] == "human-refuted") continue }
      else if (s != "" && s != "disproved" && s != "unsettled") continue
      live[++nlive] = t
      islive[t] = 1
    }
  }
AWK
}

# derive <awk program> [-v name=value]...: runs the shared derivation
# with the program appended, over the records load_round_records left in
# $work, the --edits file, the round log and the result files it lists
# itself.
derive() {
  prog=$1
  shift
  list_results "$dir" > "$work/results"
  log_in=/dev/null
  [ ! -e "$file" ] || log_in=$file
  awk -v prog="$PROGRAM" -v full="$full" -v records_file="$work/records" \
      -v edits_file="${edits:-/dev/null}" -v log_file="$log_in" -v results_file="$work/results" \
      "$@" "$(derive_lib)$prog" "$work/records" "${edits:-/dev/null}" "$log_in" "$work/results"
}

# next: the arm the round is in, then one line per theorem of each stage
# up to the arm's that is outstanding, in flight, overdue or returned
# without saving; or moved-head alone, when --head-sha names a head other
# than the anchor's.
readonly next_prog='
  # epoch(ts): the seconds since 1970 of a UTC YYYY-MM-DDTHH:MM:SSZ
  # timestamp, by the days-from-civil count, since awk has no portable
  # time parser.
  function epoch(ts,    y, m, d, era, yoe, doy, doe) {
    y = substr(ts, 1, 4) + 0; m = substr(ts, 6, 2) + 0; d = substr(ts, 9, 2) + 0
    if (m <= 2) y--
    era = int(y / 400); yoe = y - era * 400
    doy = int((153 * (m > 2 ? m - 3 : m + 9) + 2) / 5) + d - 1
    doe = yoe * 365 + int(yoe / 4) - int(yoe / 100) + doy
    return (era * 146097 + doe - 719468) * 86400 \
      + substr(ts, 12, 2) * 3600 + substr(ts, 15, 2) * 60 + substr(ts, 18, 2)
  }
  # flight(st, t): the state of the child the theorem has in flight in
  # the stage, or empty when it has none. A child is in flight when the
  # last enter of the theorem names it, no leave or stopped names it, and
  # no result file settles the theorem.
  function flight(st, t,    id) {
    if (!((st SUBSEP t) in child)) return ""
    id = child[st, t]
    if ((st SUBSEP t SUBSEP id) in ended || has_result(st, t)) return ""
    if ((st SUBSEP t SUBSEP id) in returned) return "returned-unsaved"
    if (deadline != "" && now + 0 >= epoch(at[st, t]) + deadline * 60) return "overdue"
    return "in-flight"
  }
  # consider(st, t, member): adds the line the theorem gets in the stage,
  # if any, and says whether the stage still has work on it. A theorem
  # with no child in flight is outstanding only when it is a member of
  # the stage and the stage has not settled it. A theorem already
  # considered in the stage adds no second line and returns 0, so the
  # answer of the first call is the one that counts.
  function consider(st, t, member,    f) {
    if ((st SUBSEP t) in seen) return 0
    seen[st, t] = 1
    f = flight(st, t)
    if (f != "") {
      out[++nout] = st "\t" t "\t" f "\t" child[st, t] "\t" at[st, t]
      return 1
    }
    if (member && !settled(st, t)) {
      out[++nout] = st "\t" t "\t" "outstanding" "\t\t"
      return 1
    }
    return 0
  }
  # sweep(st): considers every theorem a child entered the stage for,
  # member or not, so a child in flight is printed even off the live
  # list, and says whether any of them not already considered still has
  # work.
  function sweep(st,    i, open) {
    open = 0
    for (i = 1; i <= nentered[st]; i++) if (consider(st, entered[st, i], 0)) open = 1
    return open
  }
  END {
    if (head != "" && anchor != "" && anchor != head) { print "moved-head"; exit }
    derive_live()
    gen_open = consider("generate", "list", 1)
    sweep("generate")
    dis_open = 0
    for (i = 1; i <= nlive; i++) if (consider("disprove", live[i], 1)) dis_open = 1
    if (sweep("disprove")) dis_open = 1
    ver_open = 0
    for (i = 1; i <= nlive; i++)
      if (disproved_ok(live[i]) && consider("verify", live[i], 1)) ver_open = 1
    if (sweep("verify")) ver_open = 1
    # A stage past the arm is not under way, so its lines would only
    # tempt a spawn across the barrier between stages.
    arm = gen_open ? "generate" : dis_open ? "disprove" : ver_open ? "verify" : "dispose"
    print arm
    upto = arm == "generate" ? "generate" : arm == "disprove" ? "generate disprove" : "generate disprove verify"
    for (i = 1; i <= nout; i++) {
      split(out[i], f, "\t")
      if (index(" " upto " ", " " f[1] " ")) print out[i]
    }
  }'

# dispose: one row per live theorem, then the verdicts, one for each of
# members, the space-separated issue set, and for each other issue a
# record tags; no row at all on a round whose log holds no spawn and no
# enter. Without loop_exited, a live theorem with no result file for its
# stage makes it print nothing, name each such theorem and stage on
# stderr, and exit 3. An override that is no severity exits 2.
readonly dispose_prog='
  function sev_rank(s) { return s == "Critical" ? 4 : s == "High" ? 3 : s == "Medium" ? 2 : s == "Low" ? 1 : 0 }
  function class_sev(c) {
    return c == "breaks-production" ? "Critical" \
      : c == "behavior-broken-or-criterion-unmet" ? "High" \
      : c == "defect-no-shipped-breakage" ? "Medium" : "Low"
  }
  # override(t): the theorem record'"'"'s severity-override, spelled as a
  # severity, or empty when it has none. An override that is no severity
  # is refused on stderr, setting failed and exiting 2.
  function override(t,    o) {
    o = tolower(trim(rec[t, "severity-override"]))
    if (o == "") return ""
    if (o == "critical") return "Critical"
    if (o == "high") return "High"
    if (o == "medium") return "Medium"
    if (o == "low") return "Low"
    printf "%s: the severity-override of %s is %s, which is not Critical, High, Medium or Low\n", \
      prog, t, rec[t, "severity-override"] | "cat 1>&2"
    failed = 1
    exit 2
  }
  # severity(t, cls): the severity class_sev gives the class, High for
  # class-underivable, replaced by the override on the theorem when it
  # has one.
  function severity(t, cls,    s, o) {
    s = cls == "class-underivable" ? "High" : class_sev(cls)
    o = override(t)
    return o != "" ? o : s
  }
  # contribute(t, sev, blocked): marks each issue the theorem tags, and
  # the overall verdict, BLOCKED when blocked is set and NEEDS_CHANGES
  # when sev is Medium or worse.
  function contribute(t, sev, blocked,    n, parts, i, issue) {
    n = split(rec[t, "issues"], parts, ",")
    for (i = 1; i <= n; i++) {
      issue = trim(parts[i]); sub(/^#/, "", issue)
      if (issue == "") continue
      if (blocked) block[issue] = 1
      if (sev_rank(sev) >= sev_rank("Medium")) needs[issue] = 1
    }
    if (blocked) block_all = 1
    if (sev_rank(sev) >= sev_rank("Medium")) needs_all = 1
  }
  function verdict(b, n) { return b ? "BLOCKED" : n ? "NEEDS_CHANGES" : "APPROVED" }
  END {
    if (failed) exit 2
    derive_live()
    # The round that spawned nothing, the empty-delta one, gives no
    # theorem a row: none got a disprover this round.
    for (i = 1; fanned && i <= nlive; i++) {
      t = live[i]
      cls = "-"; sev = "-"
      if (!has_result("disprove", t)) {
        if (!loop_exited) { missing = missing " " t " (disprove)"; continue }
        disp = "unsettled-no-verdict"
      } else {
        read_report(result[t, "theorem-disprover"], "disprove")
        if (!rok) disp = "unsettled-disprover-malformed"
        else if (rv == "SURVIVED") disp = "verified-survived"
        else {
          dclass = rc
          if (!has_result("verify", t)) {
            if (!loop_exited) { missing = missing " " t " (verify)"; continue }
            disp = "disproved-unverified"
          } else {
            read_report(result[t, "counterexample-verifier"], "verify")
            if (rok && rv == "REFUTED") disp = "verified-refuted"
            else if (rok) { disp = "finding"; cls = rc }
            else { disp = "finding-verifier-malformed"; cls = dclass != "" ? dclass : "class-underivable" }
          }
        }
      }
      if (disp ~ /^finding/) { sev = severity(t, cls); if (failed) exit 2 }
      row[t] = 1; rdisp[t] = disp; rcls[t] = cls; rsev[t] = sev
      rows[++nrows] = t
    }
    if (missing != "") {
      printf "%s: --mode dispose --round %s: these theorems have no result file for their stage:%s\n", \
        prog, round, missing | "cat 1>&2"
      exit 3
    }
    # Findings are numbered by severity, highest first, then by id.
    for (n = 1; ; n++) {
      pick = ""
      for (i = 1; i <= nrows; i++) {
        t = rows[i]
        if (rdisp[t] !~ /^finding/ || (t in number)) continue
        if (pick == "" || sev_rank(rsev[t]) > sev_rank(rsev[pick])) pick = t
      }
      if (pick == "") break
      number[pick] = n
    }
    for (i = 1; i <= nrows; i++) {
      t = rows[i]; disp = rdisp[t]
      if (disp == "verified-survived") { st = "retired"; detail = "survived" }
      else if (disp == "verified-refuted") { st = "retired"; detail = "disproved-but-refuted" }
      else if (disp == "disproved-unverified") { st = "disproved"; detail = "unverified" }
      else if (disp ~ /^unsettled/) { st = "unsettled"; detail = "-" }
      else {
        st = "disproved"
        detail = "finding " number[t] ", " rsev[t] (rcls[t] == "class-underivable" ? ", class-underivable" : "")
      }
      printf "%s\t%s\t%s\t%s\t%s\t%s\n", t, disp, rcls[t], rsev[t], st, detail
    }
    # Every member gets a verdict line, a member no record tags included,
    # and so does an issue a record tags outside the set.
    nm = split(members, m, " ")
    for (i = 1; i <= nm; i++)
      if (!(m[i] in listed)) { listed[m[i]] = 1; issues[++nissues] = m[i] }
    # Every recorded theorem contributes to the verdicts: one with a row
    # by its row, any other by the state it carries.
    for (i = 1; i <= nid; i++) {
      t = ids[i]
      n = split(rec[t, "issues"], parts, ",")
      for (j = 1; j <= n; j++) {
        issue = trim(parts[j]); sub(/^#/, "", issue)
        if (issue != "" && !(issue in listed)) { listed[issue] = 1; issues[++nissues] = issue }
      }
      if (t in row) {
        contribute(t, rsev[t], rdisp[t] ~ /^unsettled/)
        continue
      }
      s = rec[t, "state"]; d = rec[t, "state-detail"]
      if (s == "unsettled") contribute(t, "-", 1)
      else if (s == "disproved" && match(d, /^finding [0-9]+, (Critical|High|Medium|Low)/)) {
        sev = substr(d, 1, RLENGTH); sub(/.*, /, "", sev)
        o = override(t)
        if (failed) exit 2
        contribute(t, o != "" ? o : sev, 0)
      }
    }
    for (i = 1; i <= nissues; i++)
      printf "verdict\t%s\t%s\n", issues[i], verdict(issues[i] in block, issues[i] in needs)
    printf "verdict\toverall\t%s\n", verdict(block_all, needs_all)
  }'

# summary: the posted review body, from the round's review file
# (review_file), its records (records_file), the records it carried
# (prev_file) and one "<round> <theorem> <name>" line per result file of
# this round and every round below (results_file). It copies four review
# sections through unchanged and writes one line per theorem and per
# finding, each ending with the paths of the files holding its detail,
# relative to the PR's state root (root) it names once.
summary_prog() {
  cat <<'AWK'
  function trim(s) { sub(/^[ \t\r]+/, "", s); sub(/[ \t\r]+$/, "", s); return s }
  function chomp(s) { sub(/[ \t\r\n]+$/, "", s); return s }
  function refuse(msg) { printf "%s: %s\n", prog, msg | "cat 1>&2"; failed = 1; exit 2 }
  # text(s, d): a state and its state-detail as a theorem line spells
  # them, "unattacked" standing for no state and the detail left out
  # where there is none.
  function text(s, d) { return (s == "" ? "unattacked" : s) (d == "" ? "" : ", " d) }
  FNR == 1 { open = 0; cur = "" }
  FILENAME == review_file {
    if (!fence && $0 ~ /^## /) {
      h = $0; sub(/^## +/, "", h); h = trim(h)
      if (h in body) { cur = ""; next }
      cur = h; body[h] = $0
      next
    }
    if ($0 ~ /^[ \t]*```/) fence = !fence
    if (cur != "") body[cur] = body[cur] "\n" $0
    next
  }
  FILENAME == records_file || FILENAME == prev_file {
    if ($0 == "") { open = 0; next }
    which = FILENAME == records_file ? "now" : "was"
    if (!open) { open = 1; id = $0; if (which == "now") ids[++nid] = id; has[which, id] = 1; next }
    key = $0; sub(/:.*/, "", key)
    v = $0; sub(/^[^:]*:[ ]?/, "", v)
    rec[which, id, key] = v
    next
  }
  FILENAME == results_file {
    # A theorem points at its result files in this round when it has
    # any, and otherwise at those of the highest round below that does.
    if ($1 == round) { here[$2] = here[$2] (here[$2] == "" ? "" : ", ") "`round" $1 "/" $3 "`"; next }
    if (!($2 in older) || $1 + 0 > older[$2] + 0) { older[$2] = $1; olderp[$2] = "" }
    if ($1 + 0 == older[$2] + 0)
      olderp[$2] = olderp[$2] (olderp[$2] == "" ? "" : ", ") "`round" $1 "/" $3 "`"
    next
  }
  END {
    if (failed) exit 2
    split("Verdicts|Review method|Overall verdict|Closing-line corrections", need, "|")
    for (i = 1; i <= 4; i++)
      if (!(need[i] in body)) refuse("the review of round " round " has no \"## " need[i] "\" section")
    print chomp(body["Verdicts"]); print ""
    print chomp(body["Review method"]); print ""
    print "## Theorems"; print ""
    print "Detail for this round is under `" root "`."; print ""
    for (i = 1; i <= nid; i++) {
      t = ids[i]
      s = rec["now", t, "state"]; d = rec["now", t, "state-detail"]
      if (!has["was", t]) change = "new"
      else if (s == rec["was", t, "state"] && d == rec["was", t, "state-detail"] \
               && rec["now", t, "settled-at"] == rec["was", t, "settled-at"]) change = "unchanged"
      else change = "was " text(rec["was", t, "state"], rec["was", t, "state-detail"])
      paths = ""
      if (s == "disproved" && d ~ /^finding [0-9]+, /) paths = "`round" round "/review`"
      p = (t in here) ? here[t] : (t in older) ? olderp[t] : ""
      if (p != "") paths = paths (paths == "" ? "" : ", ") p
      if (paths == "") paths = "`round" round "/records`"
      print "- " t " — " text(s, d) " — " change " — " paths
      if (s == "disproved" && match(d, /^finding [0-9]+, [A-Za-z]+/)) {
        f = substr(d, 1, RLENGTH); sub(/^finding /, "", f)
        n = f; sub(/,.*/, "", n); sev = f; sub(/^[0-9]+, /, "", sev)
        finding[n + 0] = "- " n " — " sev " — from " t ", " rec["now", t, "issues"] " — `round" round "/review`"
        if (n + 0 > maxf) maxf = n + 0
      }
    }
    if (nid == 0) print "none"
    print ""; print "## Findings"; print ""
    for (n = 1; n <= maxf; n++) if (n in finding) { print finding[n]; anyf = 1 }
    if (!anyf) print "none"
    print ""
    print chomp(body["Overall verdict"]); print ""
    print chomp(body["Closing-line corrections"])
  }
AWK
}

migrate_old_layout

# Every mode that writes creates the directory it writes into, and the
# repository's repo.yml with it: the round's directory, or the PR's for
# agent, which writes no round. Past migrate_old_layout's move, the
# reading modes and delete create nothing, and neither does a refused
# carry, which creates the directory only once its file is built.
make_dir() {
  mkdir -p "$dir"
  write_repo_yml
}
case "$mode" in
  print|print-in-flight|print-records|print-round-records|print-review|print-root|print-agents|list|delete) ;;
  next|dispose|summary) ;;
  records) [ -n "$carry" ] || make_dir ;;
  agent)
    mkdir -p "$pr_dir"
    write_repo_yml
    ;;
  *) make_dir ;;
esac

case "$mode" in
  anchor)
    # Idempotent, because the anchor is one line among appends every
    # other actor makes: the write is keyed on whether an anchor is
    # already there, never on whether the file is — a child that starts
    # first creates it with its own enter record.
    old_head=
    if [ -e "$file" ]; then
      old_head=$(awk '$1=="anchor"{print $3; exit}' "$file")
    fi
    if [ -z "$old_head" ]; then
      printf 'anchor %s %s %s\n' "$(now)" "$head_sha" "$round_type" >> "$file"
    elif [ "$old_head" != "$head_sha" ]; then
      # A different head means the records describe a tree that no
      # longer exists, so they answer for nothing the new round will ask
      # — but they are still the evidence of what the voided round did,
      # so the round's whole directory is set aside rather than
      # overwritten. The result files go with the log because a reader
      # takes a report's existence as a settled theorem, and one left in
      # place under its own name would settle the fresh round's theorem
      # from the voided tree.
      stamp=$(date -u +%Y%m%dT%H%M%SZ)
      mv -- "$dir" "$dir.voided-$stamp"
      mkdir -p "$dir"
      printf 'anchor %s %s %s\n' "$(now)" "$head_sha" "$round_type" > "$file"
    elif [ "$(round_type_of "$dir")" != "$round_type" ]; then
      # The same head under another type is not this round: its records
      # answer the other loop's questions, and voiding them would discard
      # a round nothing moved.
      die "--mode anchor --round $round refused: the round is anchored as $(round_type_of "$dir"), not $round_type"
    fi
    # An anchor already naming this head and type is this same round's:
    # the call writes nothing and says so by exiting zero.
    ;;
  spawn)
    printf 'spawn %s %s %s %s %s %s\n' \
      "$theorem" "$stage" "$(now)" "$agent" "$model" "$effort" >> "$file"
    ;;
  enter)
    printf 'enter %s %s %s %s %s\n' \
      "$theorem" "$stage" "$(now)" "$(this_agent_id)" "$(transcript_path)" >> "$file"
    ;;
  leave)
    # The report is written before the record that names it, so a run
    # that dies between the two leaves the report readable rather than a
    # record pointing at nothing.
    store_payload "$result_file" report
    printf 'leave %s %s %s %s %s\n' \
      "$theorem" "$stage" "$(now)" "$(this_agent_id)" "$result_file" >> "$file"
    # The path is printed only once both writes landed, so a child that
    # opens its hand-back with it is reporting a leave that happened.
    printf '%s\n' "$result_file"
    ;;
  return)
    printf 'return %s %s %s %s tokens=%s tools=%s ms=%s\n' \
      "$theorem" "$stage" "$(now)" "$agent_id" "$tokens" "$tools" "$ms" >> "$file"
    ;;
  stopped)
    printf 'stopped %s %s %s %s\n' "$theorem" "$stage" "$(now)" "$agent_id" >> "$file"
    ;;
  agent)
    printf 'agent %s %s %s\n' "$(now)" "$agent" "$agent_id" >> "$agents_file"
    ;;
  print-agents)
    # Every agent the PR's state names: the spawns recorded in its agents
    # log, and each child that entered a round, voided rounds included,
    # since a voided round's children left worktrees too. A PR with no
    # state names none.
    [ -d "$pr_dir" ] || exit 0
    for found in "$agents_file" "$pr_dir"/round*/log; do
      [ -f "$found" ] || continue
      awk '$1 == "agent" { print $4 } $1 == "enter" { print $5 }' "$found"
    done | sort -u
    ;;
  print-in-flight)
    # A theorem is in flight in --stage when its last enter there names a
    # child that no leave and no stopped of that theorem names, and no
    # result file for it under --agent exists. A stopped is matched to
    # the enter by agent id, never by position, so an original child's
    # stopped landing after its replacement's enter writes off the
    # original alone.
    [ -e "$file" ] || die "no round log at $file"
    awk -v stage="$stage" '
      $3 != stage { next }
      $1 == "enter" {
        if (!($2 in child)) order[++n] = $2
        child[$2] = $5; at[$2] = $4
      }
      $1 == "leave" || $1 == "stopped" { ended[$2 " " $5] = 1 }
      END {
        for (i = 1; i <= n; i++) {
          t = order[i]
          if (!((t " " child[t]) in ended)) print t, child[t], at[t]
        }
      }' "$file" | while read -r t id entered; do
      [ -e "$dir/$t-$agent" ] && continue
      printf '%s %s %s\n' "$t" "$id" "$entered"
    done
    ;;
  print)
    [ -e "$file" ] || die "no round log at $file"
    cat -- "$file"
    # Every result file present, synthesized from the directory at read
    # time rather than stored: a report written by a child whose leave
    # record never landed still reaches the reader this way.
    list_results "$dir" | while read -r t name found; do
      printf 'result %s %s %s\n' "$t" "$name" "$found"
    done
    # The round's type, as every reader of a round takes it: the one its
    # anchor wrote, or the type a round with none reviewed.
    printf 'round-type %s\n' "$(round_type_of "$dir")"
    ;;
  records)
    if [ -z "$carry" ]; then
      store_payload "$records_file" records
    else
      # The carried round is the one below --round, so a resumed reviewer
      # whose earlier instance already stored this round's records
      # rebuilds them from the same input rather than from its own
      # output.
      records_below_round
      [ -n "$best" ] \
        || die "--carry found no round below --round $round under $pr_dir holding a records file of type $(round_type_of "$dir")"
      # The new records may be empty, so the payload is read rather than
      # stored through store_payload, which refuses an empty one. The
      # result is built beside it and installed into the round's
      # directory only once nothing refused it.
      make_work
      read_payload "$work/new" "new records"
      build_carried_records "$best/records" "${edits:-/dev/null}" "$work/new" "$id_floor" > "$work/records" \
        || exit 2
      make_dir
      install_whole "$work/records" "$records_file"
    fi
    ;;
  review)
    store_payload "$review_file" review
    ;;
  print-records)
    # The caller does not name the round to read, and which round wrote
    # the records is what the first line of the output says. A --round
    # bounds the selection to the rounds below it, of that round's own
    # type, because a round whose records an earlier instance of it
    # already stored carries the round below's, not its own. The bound
    # refuses as the carry does, so a stale --round fails at this read
    # rather than at the carry that follows. Without one, --round-type
    # narrows the selection to the rounds of that type.
    if [ -n "$round" ]; then
      records_below_round
      [ -n "$best" ] \
        || die "no round below --round $round under $pr_dir holds a records file of type $(round_type_of "$dir")"
    else
      latest_records_round "" "$round_type"
      [ -n "$best" ] || die "no round under $pr_dir holds a records file${round_type:+ of type $round_type}"
    fi
    printf 'round %s\n' "$best_round"
    cat -- "$best/records"
    ;;
  print-round-records)
    [ -e "$records_file" ] || die "no round records at $records_file"
    cat -- "$records_file"
    ;;
  print-review)
    [ -e "$review_file" ] || die "no round review at $review_file"
    cat -- "$review_file"
    ;;
  print-root)
    # The PR's state root, for a caller that names a file under it to a
    # human relative to it: expanded, then as the signpost a human is
    # shown. Whether it exists yet is not this mode's to say.
    printf '%s/\n' "$pr_dir"
    printf '%s/\n' "$state_root_form/$host/$owner/$repo/pr$pr"
    ;;
  list)
    # A repo no review has run against has no directory, which is an
    # empty list rather than an error. Each PR prints as the reference
    # --pr takes, so a caller hands it on without composing one.
    for found in "$repo_dir"/pr*; do
      [ -d "$found" ] || continue
      n=${found##*/pr}
      case "$n" in
        ''|*[!0-9]*) continue ;;
      esac
      printf '%s\n' "$n"
    done | sort -n | while IFS= read -r n; do
      printf '%s#%s\n' "$repo_ref" "$n"
    done
    ;;
  delete)
    # The one mode that deletes. A directory already gone is the state
    # the call asks for, so it succeeds silently.
    rm -rf -- "$pr_dir"
    ;;
  next)
    # No log is the fresh round, which reads nothing else.
    if [ ! -e "$file" ]; then
      printf 'no-log\n'
      exit 0
    fi
    make_work
    load_round_records
    derive "$next_prog" -v head="$head_sha" -v deadline="$deadline_minutes" -v now="$(date -u +%s)" \
      || exit 2
    ;;
  dispose)
    make_work
    load_round_records
    status=0
    derive "$dispose_prog" -v loop_exited="$loop_exited" -v round="$round" -v members="$issue_list" \
      || status=$?
    # 3 is a theorem with no result file for its stage, named on stderr;
    # any other failure is a refusal.
    case "$status" in
      0) ;;
      3) exit 3 ;;
      *) exit 2 ;;
    esac
    ;;
  summary)
    [ -e "$records_file" ] || die "no round records at $records_file"
    [ -e "$review_file" ] || die "no round review at $review_file"
    latest_records_round "$round" "$(round_type_of "$dir")"
    prev_file=/dev/null
    [ -z "$best" ] || prev_file=$best/records
    make_work
    for candidate in "$pr_dir"/round*; do
      [ -d "$candidate" ] || continue
      n=${candidate##*/round}
      case "$n" in
        ''|*[!0-9]*) continue ;;
      esac
      [ "$n" -le "$round" ] || continue
      list_results "$candidate" | while read -r t _ found; do
        printf '%s %s %s\n' "$n" "$t" "${found##*/}"
      done
    done > "$work/results"
    awk -v prog="$PROGRAM" -v round="$round" -v review_file="$review_file" \
        -v records_file="$records_file" -v prev_file="$prev_file" -v results_file="$work/results" \
        -v root="$state_root_form/$host/$owner/$repo/pr$pr/" \
        "$(summary_prog)" "$review_file" "$records_file" "$prev_file" "$work/results" \
      || exit 2
    ;;
esac
