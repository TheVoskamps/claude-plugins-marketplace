#!/usr/bin/env bash
#
# sdlc-pr-post-theorem-records -- post a finished PR's review detail,
# assembled from its state under XDG state, as a chain of comments whose
# first lines are <!-- sdlc:theorem-records <first>-<last> <i>/<N> -->,
# <first> and <last> being the lowest and highest round the chain holds
# of those sdlc-agent-result-persist --mode rounds lists, or the round of
# the records it holds when it holds none of those.
# pr-finalizer runs it once per close-out.
#
#   usage: sdlc-pr-post-theorem-records <host>/<owner>/<repo>#<n>
#
# The covered round is the highest <last> among the complete chains
# sdlc-records-chain reports. A partial chain covers no round, and nor
# does a complete chain of the old form, which names none. The chain this
# script posts holds only what lies above the covered round, so a review
# round run after a close-out reaches the PR as a supplementary chain and
# nothing already posted is posted again. It is assembled in this order,
# each file headed by its path relative to the PR's state root,
# round<n>/<file>:
#
#   1. the final theorem records of each round type, code and
#      instruction Markdown first, from --mode print-records
#      --round-type, when their round is above the covered round and,
#      when any round has a log, no higher than the latest one;
#   2. per round above the covered round, ascending, every round with a
#      log, as sdlc-agent-result-persist --mode rounds lists them: its
#      generator files, list-<agent>, in agent-name order; its review,
#      when it stored one; then its children's result files grouped by
#      theorem, in theorem-id order, a theorem's disprover report before
#      its verifier report.
#
# Each of those is a piece, except that one theorem's result files in a
# round form one piece together. No chunk, marker line included, exceeds
# MAX_CHUNK_BYTES, and a chunk breaks between pieces except inside a
# piece too large for a chunk of its own, which starts a chunk and
# continues across as many consecutive chunks as it needs. Such a piece
# breaks between lines, and only a line too long for the room the next
# chunk would leave it is cut, at a UTF-8 character boundary, its first
# part filling the chunk it is in. A code fence open at a break is
# closed in that chunk and reopened in the next with the same fence
# line, or with its bare marker when that line leaves no room in a
# chunk for the line that follows, and each continuation chunk opens
# with its file's heading plus `(continued)`. In every piece, whole or
# split, a fence a file leaves open is closed at that file's end, so it
# never runs into the next file's heading. When a continuation
# chunk has no room for any part of a line, the layout fails and nothing
# is posted.
#
# On success it exits 0 and prints on stdout:
#
#   existing chain: rounds <first>-<last>, <N> comments
#       one line per complete chain already there that names its rounds,
#       in the order sdlc-records-chain reports them; then
#   posted chain: rounds <first>-<last>, <N> comments
#       when it posted a chain, followed by one comment URL per line, in
#       chunk order.
#
# With nothing above the covered round it posts nothing and prints only
# the existing chain lines, or `nothing to assemble` when there are none.
#
# Every other exit writes its reason to stderr:
#
#   1  an unexpected failure not covered below
#   2  a usage error: the argument is missing, or is not a
#      <host>/<owner>/<repo>#<n> reference
#   3  a required command is not on PATH; stderr names it
#   4  sdlc-records-chain failed; the chain state is unknown and nothing
#      was posted
#   5  a pr-comment post failed; stderr names the chunk, and stdout lists
#      only the URLs of the chunks already posted
#   6  the chain needs more chunks than the marker's four digits can
#      number; nothing was posted
#
# It reaches the state directory through sdlc-agent-result-persist and
# the result-file paths that script prints, and calls it, pr-comment and
# sdlc-records-chain by name off PATH. Runs under the bash 3.2 macOS
# ships.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=lib/sdlc-pr-common.sh
. "${BASH_SOURCE[0]%/*}/lib/sdlc-pr-common.sh"

# GitHub caps a comment body at 65,536 characters. A character is at
# least one byte, so a byte limit below that holds whatever the
# characters are, with headroom.
readonly MAX_CHUNK_BYTES=60000
# The largest total the marker's room, reserved for four digits, numbers.
readonly MAX_CHUNKS=9999
readonly TAB=$'\t'

usage() {
  echo "usage: $SP_PROGRAM <host>/<owner>/<repo>#<n>"
}

[ "$#" -eq 1 ] || sp_usage_error "Pass exactly one PR."
sp_parse_pr "$1"

for cmd in pr-comment sdlc-records-chain sdlc-agent-result-persist; do
  command -v "$cmd" >/dev/null 2>&1 || sp_fail 3 "\`$cmd\` is not on PATH."
done

work=$(mktemp -d "${TMPDIR:-/tmp}/$SP_PROGRAM.XXXXXX")
trap 'rm -rf -- "$work"' EXIT

persist() {
  sdlc-agent-result-persist --pr "$SP_REF" "$@"
}

# The PR's state root, expanded, to strip from a result file's path.
roots=$(persist --mode print-root || exit) ||
  sp_fail 1 "sdlc-agent-result-persist --mode print-root failed"
root=${roots%%$'\n'*}

# --- the chains already posted ----------------------------------------------

rc=0
chains=$(sdlc-records-chain "$SP_REF" 2>"$work/err" || exit) || rc=$?
covered=
existing=
case "$rc" in
  0)
    while IFS="$TAB" read -r state range total; do
      case "$state:$range" in
        complete:-) continue ;;
        complete:?*-?*) ;;
        *) sp_fail 4 "sdlc-records-chain printed \`$state$TAB$range$TAB$total\`, not a complete chain's line; nothing was posted." ;;
      esac
      case "${range%-*}:${range#*-}:$total" in
        *[!0-9:]* | *::* | :* | *:)
          sp_fail 4 "sdlc-records-chain printed \`$state$TAB$range$TAB$total\`, not a complete chain's line; nothing was posted."
          ;;
      esac
      if [ -z "$covered" ] || [ "${range#*-}" -gt "$covered" ]; then
        covered=${range#*-}
      fi
      existing="${existing}existing chain: rounds $range, $total comments"$'\n'
    done <<<"$chains"
    ;;
  3) ;;
  *)
    cat -- "$work/err" >&2
    sp_fail 4 "sdlc-records-chain failed (exit $rc); the chain state is unknown and nothing was posted."
    ;;
esac

# --- the pieces -------------------------------------------------------------
# $work/manifest holds one line per file, <piece> <relative path> <content
# path>, tab-separated, the relative path being under the state root.

pieces=0
first=
last=
: >"$work/manifest"

# above_covered <round>: whether <round> lies above the covered round.
above_covered() {
  [ -z "$covered" ] || [ "$1" -gt "$covered" ]
}

# hold <round>: widens the chain's range to take in <round>.
hold() {
  if [ -z "$first" ] || [ "$1" -lt "$first" ]; then
    first=$1
  fi
  if [ -z "$last" ] || [ "$1" -gt "$last" ]; then
    last=$1
  fi
}

# new_piece: starts a piece and makes it the one add_file appends to.
new_piece() {
  pieces=$((pieces + 1))
}

# add_file <relative path> <content file>: appends one file to the
# current piece.
add_file() {
  printf '%s\t%s\t%s\n' "$pieces" "$1" "$2" >>"$work/manifest"
}

# read_state <absent message> <persist args...>: runs persist into
# $work/out. Returns 1 when it fails saying <absent message>, the file
# being absent; any other failure is the script's. Each <absent message>
# below is a fragment of the error sdlc-agent-result-persist dies with
# when that file is absent, so it changes with that script's wording.
read_state() {
  local absent=$1 rc=0
  shift
  persist "$@" >"$work/out" 2>"$work/err" || rc=$?
  [ "$rc" -ne 0 ] || return 0
  if grep -q -- "$absent" "$work/err"; then
    return 1
  fi
  cat -- "$work/err" >&2
  sp_fail 1 "sdlc-agent-result-persist $* failed (exit $rc)"
}

rounds=$(persist --mode rounds || exit) ||
  sp_fail 1 "sdlc-agent-result-persist --mode rounds failed"
latest=
for round in $rounds; do
  latest=$round
done

# Each round carries only the records of its own type, so the latest
# records of one type say nothing of the other's theorems. The records'
# round widens the range only when no round --mode rounds lists is held:
# a listed one is held by the loop below, and an unlisted one, such as
# the seed's round 0, would name a round no other read reaches.
records_rounds=
for round_type in code-and-instruction-markdown documentation; do
  if read_state ' holds a records file' --mode print-records --round-type "$round_type"; then
    records_round=$(sed -n '1s/^round //p' "$work/out")
    above_covered "$records_round" || continue
    [ -z "$latest" ] || [ "$records_round" -le "$latest" ] || continue
    sed '1d' "$work/out" >"$work/records-$round_type"
    new_piece
    records_rounds="$records_rounds $records_round"
    add_file "round$records_round/records" "$work/records-$round_type"
  fi
done

# Every round above the covered round that --mode rounds lists, so a round
# number with no log, at the start or between two rounds, ends nothing.
for round in $rounds; do
  above_covered "$round" || continue
  read_state 'no round log at ' --mode print --round "$round" ||
    sp_fail 1 "round $round, which sdlc-agent-result-persist --mode rounds listed, has no round log"
  : >"$work/generators"
  : >"$work/children"
  while IFS=' ' read -r kind theorem agent path; do
    [ "$kind" = result ] || continue
    case "$path" in
      "$root"*) ;;
      *) sp_fail 1 "round $round's result file $path is not under the PR's state root $root" ;;
    esac
    relative=${path#"$root"}
    if [ "$theorem" = list ]; then
      printf '%s\t%s\t%s\n' "$agent" "$relative" "$path" >>"$work/generators"
      continue
    fi
    case "$theorem" in
      T[0-9]*) id=${theorem#T} ;;
      *) id=999999999 ;;
    esac
    case "$id" in
      *[!0-9]*) id=999999999 ;;
    esac
    case "$agent" in
      theorem-disprover) rank=1 ;;
      counterexample-verifier) rank=2 ;;
      *) rank=3 ;;
    esac
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$id" "$theorem" "$rank" "$agent" "$relative" "$path" >>"$work/children"
  done <"$work/out"

  LC_ALL=C sort -t "$TAB" -k1,1 "$work/generators" >"$work/sorted"
  while IFS="$TAB" read -r agent relative path; do
    new_piece
    add_file "$relative" "$path"
  done <"$work/sorted"

  if read_state 'no round review at ' --mode print-review --round "$round"; then
    cp -- "$work/out" "$work/review-$round"
    new_piece
    add_file "round$round/review" "$work/review-$round"
  fi

  LC_ALL=C sort -t "$TAB" -k1,1n -k2,2 -k3,3n -k4,4 "$work/children" >"$work/sorted"
  last_theorem=
  while IFS="$TAB" read -r id theorem rank agent relative path; do
    if [ "$theorem" != "$last_theorem" ]; then
      new_piece
      last_theorem=$theorem
    fi
    add_file "$relative" "$path"
  done <"$work/sorted"

  hold "$round"
done

if [ -z "$first" ]; then
  for records_round in $records_rounds; do
    hold "$records_round"
  done
fi

if [ "$pieces" -eq 0 ]; then
  if [ -n "$existing" ]; then
    printf '%s' "$existing"
  else
    echo "nothing to assemble"
  fi
  exit 0
fi

# --- the chunks -------------------------------------------------------------
# A chunk is its marker line, then each of its parts after a blank line,
# a part being a whole piece or one chunk's share of a split one. The
# marker's width depends on the total, which is known only once the
# pieces are laid out, so room is reserved for a four-digit total.
#
# layout <budget>: reads the manifest and writes each chunk's text after
# its marker line to $work/body-<i>, at most <budget> bytes, printing the
# number of chunks. A file's text is its heading line, a blank line, then
# its lines, the last ending in a newline whether or not the file's does,
# and a piece's files are joined by a blank line. It runs under LC_ALL=C,
# so length() counts bytes.
layout() {
  LC_ALL=C awk -F "$TAB" -v budget="$1" -v work="$work" '
# fail(message): writes message to stderr and exits 1. An exit still runs
# END, so END checks failed before it lays out or prints anything.
function fail(message) {
  printf "%s\n", message >"/dev/stderr"
  failed = 1
  exit 1
}

# heading(rel): the heading line of file rel and the blank line after it.
function heading(rel) {
  return "## `" rel "`\n\n"
}

# open_chunk(): closes the current chunk'"'"'s file and makes the next,
# empty chunk the one put writes to.
function open_chunk() {
  if (chunk) close(out)
  chunk++
  out = work "/body-" chunk
  used = 0
}

# put(s): appends s to the current chunk and counts its bytes in used.
function put(s) {
  printf "%s", s >out
  used += length(s)
}

# read_line(j): reads the next line of piece file j into LINE, returning
# whether there was one, and closes the file at its end.
function read_line(j,   r) {
  r = (getline LINE <path[j])
  if (r < 0) fail("cannot read " path[j])
  if (r == 0) close(path[j])
  return r > 0
}

# fence_run(s): the fence run a line opens with, after up to three
# spaces, or "" when it opens with none; RUN_REST is what follows it.
function fence_run(s,   k, c, n) {
  k = 0
  while (k < 3 && substr(s, 1, 1) == " ") {
    s = substr(s, 2)
    k++
  }
  c = substr(s, 1, 1)
  if (c != "`" && c != "~") return ""
  n = 0
  while (substr(s, n + 1, 1) == c) n++
  if (n < 3) return ""
  RUN_REST = substr(s, n + 1)
  return substr(s, 1, n)
}

# fence_after(line): sets NEXT_IN, NEXT_MARK and NEXT_OPEN to the fence
# state after line, from the state before it in in_fence, mark and
# open_line.
function fence_after(line,   run) {
  NEXT_IN = in_fence
  NEXT_MARK = mark
  NEXT_OPEN = open_line
  run = fence_run(line)
  if (run == "") return
  if (!in_fence) {
    if (substr(run, 1, 1) == "`" && index(RUN_REST, "`")) return
    NEXT_IN = 1
    NEXT_MARK = run
    NEXT_OPEN = line
  } else if (substr(run, 1, 1) == substr(mark, 1, 1) && length(run) >= length(mark) && RUN_REST ~ /^[ \t]*$/) {
    NEXT_IN = 0
  }
}

# continued(rel): the heading a continuation chunk of file rel opens
# with, after the chunk'"'"'s opening blank line.
function continued(rel) {
  return "\n## `" rel "` (continued)\n\n"
}

# reopen(rel, f_mark, f_open, need): the line a continuation chunk of
# file rel reopens a fence with before a line needing need bytes, f_mark
# being the fence'"'"'s marker and f_open its opening line: f_open, or f_mark
# alone when f_open leaves no room for that line.
function reopen(rel, f_mark, f_open, need) {
  if (length(continued(rel)) + length(f_open) + 1 + need <= budget) return f_open
  return f_mark
}

# room(rel, f_in, f_mark): the most bytes a continuation chunk of file
# rel leaves for its lines, the fence being open when f_in is set and
# reopened with its marker f_mark alone.
function room(rel, f_in, f_mark) {
  return budget - length(continued(rel)) - (f_in ? length(f_mark) + 1 : 0)
}

# break_chunk(rel, f_in, f_mark, f_open, need): ends the chunk inside file
# rel, closing the fence when f_in is set, and opens the next as that
# file'"'"'s continuation, reopening the fence there before a line needing
# need bytes.
function break_chunk(rel, f_in, f_mark, f_open, need) {
  if (f_in) put(f_mark "\n")
  open_chunk()
  put(continued(rel))
  if (f_in) put(reopen(rel, f_mark, f_open, need) "\n")
}

# put_head(j, head, need): puts file j'"'"'s heading, in a fresh chunk when
# the heading and need more bytes do not fit the current one, it holds
# more than its opening blank line, and either need fits a fresh chunk or
# the current one has no room for a part of a cut line after the heading.
function put_head(j, head, need,   fresh) {
  fresh = 1 + length(heading(rel[j]))
  if (used + length(head) + need > budget && used > 1 &&
      (fresh + need <= budget || used + length(head) + MIN_PART > budget)) {
    open_chunk()
    put("\n" heading(rel[j]))
  } else {
    put(head)
  }
}

# split_piece(): lays out the piece whose files are rel[1..nfiles] from a
# fresh chunk across as many consecutive chunks as it needs, breaking
# between lines and cutting only a line too long for the room the next
# chunk would leave it.
function split_piece(   j, head, pending, need, cut, broke) {
  open_chunk()
  put("\n")
  for (j = 1; j <= nfiles; j++) {
    in_fence = 0
    head = (j > 1 ? "\n" : "") heading(rel[j])
    pending = 1
    while (read_line(j)) {
      fence_after(LINE)
      need = length(LINE) + 1 + (NEXT_IN ? length(NEXT_MARK) + 1 : 0)
      if (pending) {
        put_head(j, head, need)
        pending = 0
      } else if (used + need > budget && need <= room(rel[j], in_fence, mark)) {
        break_chunk(rel[j], in_fence, mark, open_line, need)
      }
      # A line too long for that room is cut, its first part filling the
      # chunk it is in, never inside a UTF-8 character: a cut backs off
      # over continuation bytes, and a part is cut only where a chunk has
      # room for MIN_PART - 1 bytes, the longest character. A chunk breaks
      # after each part in the fence state after the line, so a cut
      # fence-opening line is closed and reopened like any fence. A chunk
      # with less room than that straight after a break can take no part,
      # so the layout fails rather than spin.
      broke = 0
      while (used + need > budget) {
        cut = budget - used - 1 - (NEXT_IN ? length(NEXT_MARK) + 1 : 0)
        if (cut < MIN_PART - 1) {
          if (broke) fail("a line of " rel[j] " leaves no room for a part in a continuation chunk")
          break_chunk(rel[j], in_fence, mark, open_line, need)
          broke = 1
          continue
        }
        while (cut > 1 && index(CONT, substr(LINE, cut + 1, 1))) cut--
        put(substr(LINE, 1, cut) "\n")
        LINE = substr(LINE, cut + 1)
        need = length(LINE) + 1 + (NEXT_IN ? length(NEXT_MARK) + 1 : 0)
        break_chunk(rel[j], NEXT_IN, NEXT_MARK, NEXT_OPEN, need)
        broke = 1
      }
      put(LINE "\n")
      in_fence = NEXT_IN
      mark = NEXT_MARK
      open_line = NEXT_OPEN
    }
    if (pending) put_head(j, head, 0)
    # A fence the file leaves open is closed before the next file'"'"'s
    # heading. Its last line reserved room for this closing line.
    if (in_fence) put(mark "\n")
  }
}

# step_fence(): moves the fence state in in_fence, mark and open_line past
# LINE.
function step_fence() {
  fence_after(LINE)
  in_fence = NEXT_IN
  mark = NEXT_MARK
  open_line = NEXT_OPEN
}

# place(): lays out the piece whose files are rel[1..nfiles], whole when
# it fits a chunk and split otherwise. A whole piece, like a split one,
# closes a fence a file leaves open at the end of that file, and counts
# that closing line in its size.
function place(   j, size) {
  size = 1
  for (j = 1; j <= nfiles; j++) {
    size += (j > 1) + length(heading(rel[j]))
    in_fence = 0
    while (read_line(j)) {
      size += length(LINE) + 1
      step_fence()
    }
    if (in_fence) size += length(mark) + 1
  }
  if (size > budget) {
    split_piece()
  } else {
    if (!chunk || used + size > budget) open_chunk()
    put("\n")
    for (j = 1; j <= nfiles; j++) {
      put((j > 1 ? "\n" : "") heading(rel[j]))
      in_fence = 0
      while (read_line(j)) {
        put(LINE "\n")
        step_fence()
      }
      if (in_fence) put(mark "\n")
    }
  }
  nfiles = 0
}

BEGIN {
  for (n = 128; n < 192; n++) CONT = CONT sprintf("%c", n)
  # The longest UTF-8 character and its newline.
  MIN_PART = 5
}

{
  if ($1 != piece && piece != "") place()
  piece = $1
  nfiles++
  rel[nfiles] = $2
  path[nfiles] = $3
}

END {
  if (failed) exit 1
  if (piece != "") place()
  if (failed) exit 1
  if (chunk) close(out)
  print chunk
}' "$work/manifest"
}

widest=$(sp_records_marker "$first" "$last" "$MAX_CHUNKS" "$MAX_CHUNKS")
budget=$((MAX_CHUNK_BYTES - ${#widest} - 1))
chunks=$(layout "$budget" || exit) ||
  sp_fail 1 "laying out the chunks failed; nothing was posted."

[ "$chunks" -le "$MAX_CHUNKS" ] ||
  sp_fail 6 "the chain came to $chunks chunks, more than the marker's four digits can number; nothing was posted."

i=1
while [ "$i" -le "$chunks" ]; do
  {
    sp_records_marker "$first" "$last" "$i" "$chunks"
    printf '\n'
    cat -- "$work/body-$i"
  } >"$work/chunk-$i"
  bytes=$(wc -c <"$work/chunk-$i")
  [ "$bytes" -le "$MAX_CHUNK_BYTES" ] ||
    sp_fail 1 "chunk $i of $chunks came to $bytes bytes, over $MAX_CHUNK_BYTES; nothing was posted."
  i=$((i + 1))
done

# --- the posts --------------------------------------------------------------

urls=
i=1
while [ "$i" -le "$chunks" ]; do
  rc=0
  url=$(pr-comment "$SP_REF" --body-file "$work/chunk-$i" || exit) || rc=$?
  if [ "$rc" -ne 0 ]; then
    printf '%s' "$urls"
    sp_fail 5 "pr-comment failed (exit $rc) posting chunk $i of $chunks; the chunks before it are posted."
  fi
  urls="$urls$url"$'\n'
  i=$((i + 1))
done

printf '%s' "$existing"
printf 'posted chain: rounds %s-%s, %s comments\n' "$first" "$last" "$chunks"
printf '%s' "$urls"
