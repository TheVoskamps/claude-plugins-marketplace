#!/usr/bin/env bash
#
# pr-create -- open a draft pull request from a head branch against the
# repo's configured base, with the caller's body followed by one
# `Closes <issue-link-prefix><issue>` line per issue named, then re-read
# the PR and fail unless it is a draft on that base and head carrying
# that body. Which issues it may close is the pr-create skill's
# decision, made before this runs.
#
# Reads `default-pr-target-branch` and `issue-link-prefix` from the
# repo's .issues/repo-config.md.
#
# The contract is plugins/github-prs/skills/pr-create/SKILL.md.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=lib/github-prs-common.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/github-prs-common.sh"

usage() {
  echo "usage: $GP_PROGRAM --head <branch> --title <title> --body-file <path> <issue>..."
}

head_ref=
title=
body_file=
issues=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --head | --title | --body-file)
      [ "$#" -ge 2 ] || gp_usage_error "\`$1\` needs a value."
      case "$1" in
        --head) head_ref=$2 ;;
        --title) title=$2 ;;
        --body-file) body_file=$2 ;;
      esac
      shift 2
      ;;
    -*) gp_usage_error "\`$1\` is not an argument pr-create takes." ;;
    *)
      issue=$(gp_issue_number "$1") || exit $?
      issues="$issues $issue"
      shift
      ;;
  esac
done

[ -n "$head_ref" ] || gp_usage_error "No \`--head\` branch was supplied."
[ -n "$title" ] || gp_usage_error "No \`--title\` was supplied."
[ -n "$body_file" ] || gp_usage_error "No \`--body-file\` was supplied."
[ -f "$body_file" ] && [ -r "$body_file" ] ||
  gp_usage_error "\`$body_file\` is not a readable file."
[ -n "$issues" ] || gp_usage_error "No issue number was supplied."

base=$(gp_config_value default-pr-target-branch) || exit $?
prefix=$(gp_config_value issue-link-prefix) || exit $?

closing=
for issue in $issues; do
  closing="${closing}Closes $prefix$issue
"
done
closing=${closing%
}

summary=$(cat "$body_file")
if [ -n "$summary" ]; then
  wanted="$summary

$closing"
else
  wanted=$closing
fi

url=$(printf '%s\n' "$wanted" |
  gp_gh pr create --draft --base "$base" --head "$head_ref" \
    --title "$title" --body-file -) || exit $?
url=$(printf '%s\n' "$url" | tail -n 1)
pr=${url##*/}
case "$pr" in
  '' | *[!0-9]*) gp_fail 1 "gh pr create reported \`$url\`, which names no PR number" ;;
esac

landed=$(gp_gh pr view "$pr" --json isDraft,baseRefName,headRefName \
  --jq '"\(.isDraft) \(.baseRefName) \(.headRefName)"') || exit $?
[ "$landed" = "true $base $head_ref" ] ||
  gp_not_landed "$pr" "the draft PR" \
    "the re-read reports isDraft, base and head as \`$landed\`, not \`true $base $head_ref\`"

landed_body=$(gp_gh pr view "$pr" --json body --jq .body) || exit $?
[ "$landed_body" = "$wanted" ] ||
  gp_not_landed "$pr" "the PR body" "the re-read body is not the body written"

echo "$url"
