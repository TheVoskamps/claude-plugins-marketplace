#!/usr/bin/env bash
#
# pr-create -- open a draft pull request from a head branch against the
# repo's configured base, with the caller's body followed by one
# `Closes <issue-link-prefix><issue>` line per issue named, then re-read
# the PR and fail unless it is a draft on that base and head carrying
# that body. Which issues it may close is the pr-create skill's
# decision, made before this runs.
#
# Reads `default-pr-target-branch` and `issue-link-prefix` from the
# repo's .issues/repo-config.md.
#
# The contract is plugins/github-prs/skills/pr-create/SKILL.md.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=lib/github-prs-common.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/github-prs-common.sh"

usage() {
  echo "usage: $GP_PROGRAM --head <branch> --title <title> --body-file <path> <issue>..."
}

# config_value <key> -- one front-matter value from the repo's
# .issues/repo-config.md, with surrounding quotes removed. Only the
# front matter is read: the block a `---` first line opens and the next
# `---` line closes. A file whose first line is not `---` has none.
# It lives here rather than in the common helper because this is the
# one verb that reads repo-config.
config_value() {
  local root file value
  root=$(git rev-parse --show-toplevel 2>/dev/null) || root=.
  file="$root/.issues/repo-config.md"
  [ -f "$file" ] || gp_err_no_config
  value=$(awk -v key="$1" '
    NR == 1 && $0 == "---" { inside = 1; next }
    inside && $0 == "---" { exit }
    inside && index($0, key ":") == 1 {
      v = substr($0, length(key) + 2)
      sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v)
      if (v ~ /^".*"$/ || v ~ /^\047.*\047$/) v = substr(v, 2, length(v) - 2)
      print v; exit
    }' "$file")
  [ -n "$value" ] || gp_err_config_key "$1"
  printf '%s\n' "$value"
}

head_ref=
title=
body_file=
issues=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --head | --title | --body-file)
      [ "$#" -ge 2 ] || gp_err_needs_value "$1" "a value"
      case "$1" in
        --head) head_ref=$2 ;;
        --title) title=$2 ;;
        --body-file) body_file=$2 ;;
      esac
      shift 2
      ;;
    -*) gp_err_unknown_arg "$1" ;;
    *)
      issue=$(gp_issue_number "$1") || exit $?
      issues="$issues $issue"
      shift
      ;;
  esac
done

[ -n "$head_ref" ] || gp_err_missing "\`--head\` branch"
[ -n "$title" ] || gp_err_missing "\`--title\`"
[ -n "$body_file" ] || gp_err_missing "\`--body-file\`"
[ -f "$body_file" ] && [ -r "$body_file" ] ||
  gp_err_unreadable "$body_file"
[ -n "$issues" ] || gp_err_missing "issue number"

base=$(config_value default-pr-target-branch) || exit $?
prefix=$(config_value issue-link-prefix) || exit $?

closing=
for issue in $issues; do
  closing="${closing}Closes $prefix$issue
"
done
closing=${closing%
}

summary=$(cat "$body_file")
if [ -n "$summary" ]; then
  wanted="$summary

$closing"
else
  wanted=$closing
fi

url=$(printf '%s\n' "$wanted" |
  gp_gh pr create --draft --base "$base" --head "$head_ref" \
    --title "$title" --body-file -) || exit $?
url=$(printf '%s\n' "$url" | tail -n 1)
pr=${url##*/}
case "$pr" in
  '' | *[!0-9]*) gp_err_no_pr_in_url "$url" ;;
esac

landed=$(gp_gh pr view "$pr" --json isDraft,baseRefName,headRefName \
  --jq '"\(.isDraft) \(.baseRefName) \(.headRefName)"') || exit $?
[ "$landed" = "true $base $head_ref" ] ||
  gp_err_draft_pr_not_landed "$pr" "$landed" "true $base $head_ref"

landed_body=$(gp_gh pr view "$pr" --json body --jq .body) || exit $?
[ "$landed_body" = "$wanted" ] ||
  gp_err_body_not_landed "$pr" "the PR body"

echo "$url"
