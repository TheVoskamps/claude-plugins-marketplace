#!/usr/bin/env bash
#
# pr-draft -- convert a ready pull request back to a draft, then re-read
# it and fail unless it is a draft.
#
# The contract is plugins/github-prs/skills/pr-draft/SKILL.md.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=lib/github-prs-common.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/github-prs-common.sh"

usage() {
  echo "usage: $GP_PROGRAM <PR>"
}

[ "$#" -eq 1 ] || gp_usage_error "Pass exactly one PR number."
pr=$(gp_pr_number "$1") || exit $?

gp_gh pr ready "$pr" --undo >/dev/null

is_draft=$(gp_gh pr view "$pr" --json isDraft --jq .isDraft) || exit $?
[ "$is_draft" = true ] ||
  gp_not_landed "$pr" "the draft flip" "the re-read still reports isDraft $is_draft"

echo "PR #$pr is now a draft"
