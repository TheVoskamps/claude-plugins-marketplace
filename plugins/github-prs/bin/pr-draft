#!/usr/bin/env bash
#
# pr-draft -- convert a ready pull request back to a draft, then re-read
# it and fail unless it is a draft.
#
# The contract is plugins/github-prs/skills/pr-draft/SKILL.md.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=lib/github-prs-common.sh
. "${BASH_SOURCE[0]%/*}/lib/github-prs-common.sh"

usage() {
  echo "usage: $GP_PROGRAM <PR>"
}

[ "$#" -eq 1 ] || gp_err_one_pr
gp_parse_pr "$1"

gp_pr ready --undo >/dev/null

is_draft=$(gp_pr view --json isDraft --jq .isDraft) || exit $?
[ "$is_draft" = true ] ||
  gp_err_flip_not_landed draft "$is_draft"

echo "PR $GP_PR_NAME is now a draft"
