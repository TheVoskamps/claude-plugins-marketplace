#!/usr/bin/env bash
#
# pr-link-issue -- ensure a pull request's body closes every issue named.
# Read the body, and append one `Closes #<issue>` line for each named
# issue gp_closing_issues does not find it closing, keeping the existing
# body verbatim above them; then re-read the body and fail unless it is
# the one written. A body that already closes every issue named is left
# unwritten.
#
# The contract is plugins/github-prs/skills/pr-link-issue/SKILL.md.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=lib/github-prs-common.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/github-prs-common.sh"

usage() {
  echo "usage: $GP_PROGRAM <PR> <issue>..."
}

[ "$#" -ge 2 ] || gp_err_pr_and_issues
gp_parse_pr "$1"
shift

issues=
for arg in "$@"; do
  issue=$(gp_issue_number "$arg") || exit $?
  case " $issues " in
    *" $issue "*) ;;
    *) issues="$issues $issue" ;;
  esac
done

existing=$(gp_pr view --json body --jq .body) || exit $?
closed=" $(gp_closing_issues "$existing" | tr '\n' ' ')" || exit $?

linked=
closing=
for issue in $issues; do
  case "$closed" in
    *" $issue "*) linked="$linked $issue" ;;
    *)
      closing="${closing}Closes #$issue
"
      ;;
  esac
done

if [ -z "$closing" ]; then
  printf 'PR %s already closes %s\n' "$GP_PR_NAME" "$(gp_joined "$linked")"
  exit 0
fi
closing=${closing%
}

if [ -n "$existing" ]; then
  wanted="$existing

$closing"
else
  wanted=$closing
fi

printf '%s\n' "$wanted" | gp_pr edit --body-file - >/dev/null

landed=$(gp_pr view --json body --jq .body) || exit $?
[ "$landed" = "$wanted" ] ||
  gp_err_body_not_landed "the closing lines"

appended=$(printf '%s\n' "$closing" | tr '\n' ',' | sed 's/,$//; s/,/, /g')
if [ -n "$linked" ]; then
  printf 'PR %s already closes %s; appended %s\n' "$GP_PR_NAME" "$(gp_joined "$linked")" "$appended"
else
  printf 'PR %s: appended %s\n' "$GP_PR_NAME" "$appended"
fi
