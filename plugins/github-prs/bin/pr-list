#!/usr/bin/env bash
#
# pr-list -- list the pull requests whose head is one branch, as a JSON
# array. Read-only.
#
# The contract is plugins/github-prs/skills/pr-list/SKILL.md.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=lib/github-prs-common.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/github-prs-common.sh"

usage() {
  echo "usage: $GP_PROGRAM --head <branch> [--state open|closed|merged|all]"
}

head_ref=
state=open
while [ "$#" -gt 0 ]; do
  case "$1" in
    --head)
      [ "$#" -ge 2 ] || gp_usage_error "\`--head\` needs a branch name."
      head_ref=$2
      shift 2
      ;;
    --state)
      [ "$#" -ge 2 ] || gp_usage_error "\`--state\` needs a value."
      state=$2
      shift 2
      ;;
    *) gp_usage_error "\`$1\` is not an argument pr-list takes." ;;
  esac
done

[ -n "$head_ref" ] || gp_usage_error "No \`--head\` branch was supplied."
case "$state" in
  open | closed | merged | all) ;;
  *) gp_usage_error "\`$state\` is not a state. Pass open, closed, merged, or all." ;;
esac

gp_gh pr list --head "$head_ref" --state "$state" \
  --json number,title,state,headRefName,baseRefName,mergedAt,closedAt,url
