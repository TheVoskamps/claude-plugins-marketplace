#!/usr/bin/env bash
#
# pr-closing-issues -- print the body a pull request carries, which is
# the text the pr-closing-issues skill applies GitHub's closing-keyword
# syntax to. Read-only.
#
# The contract is plugins/github-prs/skills/pr-closing-issues/SKILL.md.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=lib/github-prs-common.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/github-prs-common.sh"

usage() {
  echo "usage: $GP_PROGRAM <PR>"
}

[ "$#" -eq 1 ] || gp_err_one_pr
gp_parse_pr "$1"

gp_pr view --json body --jq .body
