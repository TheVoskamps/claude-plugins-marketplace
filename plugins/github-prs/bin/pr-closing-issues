#!/usr/bin/env bash
#
# pr-closing-issues -- report the set of issues a pull request's body
# closes, as gp_closing_issues recognizes them. Read-only.
#
# The contract is plugins/github-prs/skills/pr-closing-issues/SKILL.md.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=lib/github-prs-common.sh
. "${BASH_SOURCE[0]%/*}/lib/github-prs-common.sh"

usage() {
  echo "usage: $GP_PROGRAM <PR>"
}

[ "$#" -eq 1 ] || gp_err_one_pr
gp_parse_pr "$1"

body=$(gp_pr view --json body --jq .body) || exit $?
closed=$(gp_closing_issues "$body") || exit $?

if [ -n "$closed" ]; then
  joined=$(gp_joined "$closed") || exit $?
  printf 'PR %s closes issues %s\n' "$GP_PR_NAME" "$joined"
else
  printf 'PR %s closes no issues\n' "$GP_PR_NAME"
fi
