#!/usr/bin/env bash
#
# pr-merge-conflicts -- enumerate a pull request's merge conflicts with
# its base: trial-merge the base into the PR's head in a throwaway
# detached worktree under .claude/worktrees/, report the conflicting
# files and each one's hunks, then abort the merge and remove the
# worktree whatever happened. Resolves, commits and pushes nothing, and
# leaves the primary clone's working tree as it found it.
#
# The contract is plugins/github-prs/skills/pr-merge-conflicts/SKILL.md.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=lib/github-prs-common.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/github-prs-common.sh"

usage() {
  echo "usage: $GP_PROGRAM <PR>"
}

[ "$#" -eq 1 ] || gp_err_one_pr
gp_parse_pr "$1"

refs=$(gp_pr view --json headRefName,baseRefName \
  --jq '"\(.headRefName) \(.baseRefName)"') || exit $?
head_ref=${refs% *}
base_ref=${refs#* }

root=$(git rev-parse --show-toplevel) || gp_err_not_a_repo
tree="$root/.claude/worktrees/pr-merge-conflicts-$GP_PR"

# A PR of the checkout's own repository merges from origin. A PR of
# another repository has its two branches fetched from that repository's
# URL into refs of this verb's own, which the cleanup below deletes, so
# no remote-tracking ref of the checkout changes.
foreign=
if [ -n "$GP_REPO_ARG" ]; then
  gp_current_repo
  lc() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }
  [ "$(lc "$GP_REPO_ARG")" = "$(lc "$GP_CUR_HOST/$GP_CUR_OWNER/$GP_CUR_REPO")" ] ||
    foreign=yes
fi
if [ -z "$foreign" ]; then
  head_start="origin/$head_ref"
  base_start="origin/$base_ref"
  base_label=$base_start
  git fetch -q origin "$base_ref" "$head_ref" ||
    gp_err_git "git fetch origin $base_ref $head_ref"
else
  head_start="refs/pr-merge-conflicts/$GP_PR/head"
  base_start="refs/pr-merge-conflicts/$GP_PR/base"
  base_label="$base_ref of $GP_REPO_ARG"
  url="https://$GP_REPO_ARG.git"
  if ! git fetch -q --no-tags "$url" \
    "+refs/heads/$base_ref:$base_start" "+refs/heads/$head_ref:$head_start"; then
    git update-ref -d "$head_start" >/dev/null 2>&1 || true
    git update-ref -d "$base_start" >/dev/null 2>&1 || true
    gp_err_git "git fetch $url $base_ref $head_ref"
  fi
fi

# A path left behind holds an interrupted run's merge in progress, which
# nothing else clears, and `worktree add` refuses an existing path. A
# registration whose directory is gone makes the add refuse too, and
# only `prune` drops it.
if [ -e "$tree" ]; then
  git -C "$tree" merge --abort >/dev/null 2>&1 || true
  git worktree remove --force "$tree" ||
    gp_err_git "git worktree remove of the leftover $tree"
fi
git worktree prune || gp_err_git "git worktree prune"

cleanup() {
  # No merge in progress -- a head already up to date with the base --
  # makes the abort fail, which is not a failure here.
  git -C "$tree" merge --abort >/dev/null 2>&1 || true
  git worktree remove --force "$tree" >/dev/null 2>&1 || true
  if [ -n "$foreign" ]; then
    git update-ref -d "$head_start" >/dev/null 2>&1 || true
    git update-ref -d "$base_start" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT

git worktree add -q --detach "$tree" "$head_start" ||
  gp_err_git "git worktree add at $head_start"

echo "PR $GP_PR_NAME: head $head_ref, base $base_ref"

# git's stderr is held back rather than discarded: a conflict is the
# expected outcome and its noise stays off the report, but a merge that
# failed for another reason prints it above the catalogue line.
if merge_err=$(git -C "$tree" -c user.name=pr-merge-conflicts -c user.email=pr-merge-conflicts@localhost \
  merge -q --no-commit --no-ff "$base_start" 2>&1 >/dev/null); then
  echo "The trial merge is clean: no conflicts with $base_label."
  exit 0
fi

files=$(git -C "$tree" diff --name-only --diff-filter=U) ||
  gp_err_git "git diff listing the conflicted files"
if [ -z "$files" ]; then
  [ -z "$merge_err" ] || printf '%s\n' "$merge_err" >&2
  gp_err_merge_no_conflict "$base_label"
fi

echo "Conflicting files:"
printf '%s\n' "$files" | sed 's/^/  /'
printf '%s\n' "$files" | while IFS= read -r file; do
  echo
  echo "=== $file"
  git -C "$tree" diff -- "$file"
done
