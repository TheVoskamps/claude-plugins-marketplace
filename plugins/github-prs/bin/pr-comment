#!/usr/bin/env bash
#
# pr-comment -- post a comment on a pull request from a file, then
# re-read that comment by the id gh reported and fail unless its body
# is the file.
#
# The contract is plugins/github-prs/skills/pr-comment/SKILL.md.
set -euo pipefail
# shellcheck source-path=SCRIPTDIR source=lib/github-prs-common.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/github-prs-common.sh"

usage() {
  echo "usage: $GP_PROGRAM <PR> --body-file <path>"
}

[ "$#" -eq 3 ] && [ "$2" = --body-file ] ||
  gp_err_pr_and_body_file
pr=$(gp_pr_number "$1") || exit $?
body_file=$3
[ -f "$body_file" ] && [ -r "$body_file" ] ||
  gp_err_unreadable "$body_file"
gp_resolve_host

url=$(gp_gh pr comment "$pr" --body-file "$body_file") || exit $?

# gh prints the new comment's URL, which ends #issuecomment-<id>.
case "$url" in
  *'#issuecomment-'*) comment_id=${url##*#issuecomment-} ;;
  *) comment_id= ;;
esac
case "$comment_id" in
  '' | *[!0-9]*)
    gp_err_comment_no_id "$pr" "$url"
    ;;
esac

wanted=$(cat "$body_file")
landed=$(gp_gh api "$(gp_repo_path "issues/comments/$comment_id")" --jq .body) || exit $?
[ "$landed" = "$wanted" ] ||
  gp_err_comment_not_landed "$pr" "$comment_id" "$body_file"

echo "$url"
