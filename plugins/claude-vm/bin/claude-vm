#!/usr/bin/env bash
#
# claude-vm -- preflight launcher / entry point for the claude-vm plugin.
#
# `cr()`-shaped (issue #51; see the maintainer's host `cr()` wrapper in
# ~/.aliases.zsh for the reference shape this mirrors): derive the repo
# name from `origin`, verify we are at a repo root, name the run from
# trailing args or a date stamp, verify the global config exists (offer
# to create it), fail fast on a missing auth credential, then forward to
# the full launcher (payload/claude-vm.sh) instead of bare `claude`.
#
# Unlike `cr()`, this REQUIRES a repo with an `origin` remote -- there is
# no throwaway `git init` branch and no `(local)` fallback. Outside a
# repo, or a repo with no `origin`, this fails clearly instead.
#
# This file ships in the plugin's bin/ directory, which Claude Code adds
# to PATH for the Bash tool when the plugin is enabled, so it runs as the
# bare command `claude-vm` (no long cache-path invocation).
#
# Usage:
#   claude-vm [claude args...]
#
# Run from anywhere inside the target repo (not just its root) -- like
# `cr()`, this moves to the repo root itself before doing anything else.
#
# This script is bash-portable (not zsh): plain `#!/usr/bin/env bash` and
# POSIX/bash string substitutions, no zsh-only syntax.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PLUGIN_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
LAUNCHER="$PLUGIN_ROOT/payload/claude-vm.sh"

# ---------------------------------------------------------------------
# 1. Verify we are inside a git repo, and move to its root -- same
#    "detected existing git repo; cd to repo root" move `cr()` makes,
#    so the launcher's per-repo config lookup (<repo>/.claude-vm/config.yml)
#    and clone both resolve against the actual repo root regardless of
#    the caller's cwd.
# ---------------------------------------------------------------------
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "claude-vm: not inside a git repository." >&2
  echo "claude-vm: run this from inside the repo you want to launch a VM for." >&2
  exit 1
fi

TOPLEVEL="$(git rev-parse --show-toplevel)"
cd "$TOPLEVEL"

# ---------------------------------------------------------------------
# 2. Derive the repo name from the `origin` remote (same parse as
#    `cr()`'s zsh `repo="${${url##*/}%.git}"`, written portably here).
#    Unlike `cr()`, there is no `(local)` fallback: a repo with no
#    `origin` fails clearly instead of silently launching unnamed.
# ---------------------------------------------------------------------
ORIGIN_URL="$(git remote get-url origin 2>/dev/null || true)"
if [ -z "$ORIGIN_URL" ]; then
  echo "claude-vm: repo at '$TOPLEVEL' has no 'origin' remote." >&2
  echo "claude-vm: claude-vm requires a repo with an origin so it can derive a repo name" >&2
  echo "claude-vm: and clone from it; add one (git remote add origin <url>) and retry." >&2
  exit 1
fi
REPO_NAME="${ORIGIN_URL##*/}"
REPO_NAME="${REPO_NAME%.git}"

# ---------------------------------------------------------------------
# 3. Run/session name: trailing args -> suffix, else a date stamp (same
#    `cr()` logic: suffix="$*", default to `date '+%b%d-%H:%M'`), so
#    parallel VMs are individually named. Unlike `cr()`'s bare
#    `claude --name "$name"`, this forwards to payload/claude-vm.sh, which
#    does its own independent --name defaulting (a bare date stamp, no repo
#    name, and only under Remote Control). To make the guest session name
#    match what we print here (and carry the repo name, per the issue's
#    "parallel VMs are individually named" guarantee), inject
#    `--name "$RUN_NAME"` into the forwarded args -- unless the caller
#    already passed their own --name (either `--name <v>` or `--name=<v>`),
#    in which case respect theirs and do not override.
# ---------------------------------------------------------------------
CLAUDE_ARGS=("$@")
if [ "$#" -gt 0 ]; then
  SUFFIX="$*"
else
  SUFFIX="$(date '+%b%d-%H:%M')"
fi
RUN_NAME="$SUFFIX $REPO_NAME"

HAS_NAME=0
for arg in ${CLAUDE_ARGS[@]+"${CLAUDE_ARGS[@]}"}; do
  case "$arg" in
    --name|--name=*) HAS_NAME=1; break ;;
  esac
done
if [ "$HAS_NAME" -eq 0 ]; then
  CLAUDE_ARGS=(${CLAUDE_ARGS[@]+"${CLAUDE_ARGS[@]}"} --name "$RUN_NAME")
fi

# ---------------------------------------------------------------------
# 4. Verify the global config exists; offer to create it via the
#    slice-1 config-writer skill rather than failing outright (the
#    launcher itself works with no config -- resolved defaults apply --
#    but an operator who has never run claude-vm likely wants one).
# ---------------------------------------------------------------------
GLOBAL_CONFIG="${CLAUDE_VM_GLOBAL_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/claude-vm/config.yml}"
if [ ! -f "$GLOBAL_CONFIG" ]; then
  echo "claude-vm: no global config found at '$GLOBAL_CONFIG'." >&2
  echo "claude-vm: claude-vm runs with built-in defaults even without one, but a global" >&2
  echo "claude-vm: config lets you pin cpus/mem/egress/claude.version once for every repo." >&2
  echo "claude-vm: create it now by running /claude-vm-config-global, then re-run claude-vm." >&2
  echo "claude-vm: proceeding with built-in defaults for this launch." >&2
fi

# ---------------------------------------------------------------------
# 5. Fail fast on a missing auth credential (the slice-5 host-Keychain
#    OAuth model). This is a cheap PRESENCE check only -- it mirrors the
#    "logged in or not" branch of claude-vm.sh's own preflight (exit 44
#    / empty blob = not logged in) without doing the full claudeAiOauth
#    selection + token validation, which stays in claude-vm.sh as the
#    authoritative deep check. macOS-only, same as the full launcher.
# ---------------------------------------------------------------------
KEYCHAIN_SERVICE="Claude Code-credentials"
if ! command -v security >/dev/null 2>&1; then
  echo "claude-vm: 'security' (macOS Keychain tool) not found -- claude-vm is macOS-only." >&2
  exit 1
fi
set +e
security find-generic-password -s "$KEYCHAIN_SERVICE" -w >/dev/null 2>/dev/null
SEC_RC=$?
set -e
if [ "$SEC_RC" -ne 0 ]; then
  echo "claude-vm: could not read the claude.ai OAuth credential from the macOS Keychain" >&2
  echo "claude-vm: (service '$KEYCHAIN_SERVICE'). The guest authenticates with the host's" >&2
  echo "claude-vm: live claude.ai login, so you must be logged in to Claude Code on this host." >&2
  echo "claude-vm: run 'claude' once and complete the claude.ai login, then retry." >&2
  exit 1
fi

# ---------------------------------------------------------------------
# 6. Forward to the full launcher (payload/claude-vm.sh) instead of bare
#    `claude` -- the repo root plus any trailing args, augmented with the
#    computed --name (step 3) unless the caller already supplied one; the
#    launcher's own CLAUDE_ARGS handling (e.g. Remote Control injection)
#    applies downstream on top of these.
#
#    The "launching" message is printed here, after every fail-fast
#    preflight check has passed, so it shows only when the launch is
#    actually proceeding -- not on an early exit (missing repo/origin,
#    missing Keychain credential, etc).
# ---------------------------------------------------------------------
echo "claude-vm: launching '$RUN_NAME'" >&2
exec "$LAUNCHER" "$TOPLEVEL" ${CLAUDE_ARGS[@]+"${CLAUDE_ARGS[@]}"}
