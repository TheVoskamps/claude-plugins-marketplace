#!/usr/bin/env bash
#
# cr -- the resolver cc-tools deploys to ~/.local/bin/cr. It asks Claude
# Code where the enabled cc-tools is installed and execs that version's
# bin/cr with its own arguments, so a cc-tools update reaches the next
# `cr` with no redeploy. It carries no launcher logic, with one exception:
# it sets CLAUDE_CONFIG_DIR from --as, because the plugin lookup reads it.
# It never falls back to plain claude. Runs under the bash 3.2 macOS
# ships.
#
# Usage: cr [--cr-strict] [--as <name>] [<name-word>…] [<claude-argument>…]
#
# It accepts and refuses --as by the rules bin/cr applies, passes it on
# with the other arguments, and reads nothing else in them but the
# --cr-strict that may precede it.
#
# The deploy hook copies this file byte for byte, so it must not depend
# on where it lives. It sits under hooks/ rather than bin/ because bin/ is
# what sessions get on PATH, and this file is only ever run from the
# shell.
#
# Exit status: bin/cr's own; 1 when --as is refused, jq is missing, the
# plugin list cannot be read, or no enabled cc-tools is installed, with
# stderr saying which; or, under bash 3.2, 126 when the exec fails,
# whether bin/cr is absent, its install directory is missing, or it is
# not executable.
set -uo pipefail

# apply_as <arg>… -- export CLAUDE_CONFIG_DIR for the --as among the
# arguments before the name words, or exit 1 refusing it. A function, so
# that its shifts leave the script's own arguments whole for the exec. The
# letters are spelled out because a bracket range can follow the locale's
# collation.
apply_as() {
  local account=
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --cr-strict) ;;
      --as=*)
        echo "cr: spell the account as '--as <name>', not '$1'" >&2
        exit 1
        ;;
      --as)
        if [ -n "$account" ]; then
          echo "cr: --as is given twice" >&2
          exit 1
        fi
        if [ "$#" -lt 2 ]; then
          echo "cr: --as needs an account name" >&2
          exit 1
        fi
        case "$2" in
          '' | backup | *[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-]*)
            echo "cr: --as: '$2' is not a valid account name" >&2
            exit 1
            ;;
        esac
        if [ -z "${HOME-}" ]; then
          echo "cr: --as: HOME is not set" >&2
          exit 1
        fi
        account=$2
        if [ ! -d "$HOME/.claude.$account" ]; then
          echo "cr: --as: no account directory $HOME/.claude.$account" >&2
          exit 1
        fi
        export CLAUDE_CONFIG_DIR="$HOME/.claude.$account"
        shift
        ;;
      *) break ;;
    esac
    shift
  done
}
apply_as "$@"

if ! command -v jq >/dev/null 2>&1; then
  echo "cr: jq is not on PATH; cr needs it to find the installed cc-tools" >&2
  exit 1
fi

if ! list=$(claude plugin list --json); then
  echo "cr: \`claude plugin list --json\` failed" >&2
  exit 1
fi

install_path=$(printf '%s\n' "$list" |
  jq -r 'first(.[] | select(.id=="cc-tools@thevoskamps" and .enabled) | .installPath) // empty')

if [ -z "$install_path" ]; then
  echo "cr: no enabled cc-tools@thevoskamps is installed; enable or install it to use cr" >&2
  exit 1
fi

exec "$install_path/bin/cr" "$@"
