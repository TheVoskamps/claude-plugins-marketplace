#!/usr/bin/env bash
# List a project board's open issues at one status, in the board's position
# order or by a named view's sort fields: the configured board's issues in one
# repository, or, with --project or a board URL, a named board's issues across
# its repositories or in one of them. The contract is
# plugins/issues/skills/issue-list/SKILL.md.
set -uo pipefail
# shellcheck source-path=SCRIPTDIR source=lib/issues-common.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/issues-common.sh"

# The sort-field dataTypes the view sort can read a value for.
readonly SORTABLE='NUMBER SINGLE_SELECT TEXT TITLE DATE ITERATION'

# sort_items <project-id> <sort-fields>: stable-sort the issue array on stdin
# by the view's sort fields, in their order and direction. A field's value is
# ranked among the values the items hold -- a single-select by its option's
# position in the field -- and an item with no value sorts after every item
# with one.
sort_items() {
  jq -c --arg p "$1" --argjson fields "$2" '
    def value($f):
      [.projectItems.nodes[]? | select(.project.id == $p) | .fieldValues.nodes[]?
       | select(.field.id? == $f.field.id)][0] as $v
      | $f.field.dataType as $t
      | if $t == "TITLE" then (.title // null | if . == null then null else ascii_downcase end)
        elif $v == null then null
        elif $t == "NUMBER" then $v.number
        elif $t == "SINGLE_SELECT" then ([$f.field.options[]?.id] | index($v.optionId))
        elif $t == "TEXT" then ($v.text // null | if . == null then null else ascii_downcase end)
        elif $t == "DATE" then $v.date
        elif $t == "ITERATION" then $v.startDate
        else null end;
    . as $items
    | [$items[] | [$fields[] as $f | value($f)]] as $values
    | [range(0; $fields | length) as $k | [$values[][$k] | select(. != null)] | unique] as $ranks
    | [range(0; $items | length) as $i
       | {item: $items[$i],
          key: [range(0; $fields | length) as $k | $values[$i][$k] as $v
                | if $v == null then [1, 0]
                  else ($ranks[$k] | index($v)) as $r
                    | [0, (if $fields[$k].direction == "DESC" then -$r else $r end)]
                  end]}]
    | sort_by(.key) | map(.item)'
}

# slot_value <slot>: the slot's value on the issue in ISS_ISSUE, or "-" when
# it is unset or the slot is unconfigured.
slot_value() {
  local kind value=
  kind=$(iss_slot_kind "$1")
  [ "$kind" = skip ] || value=$(iss_slot_read "$1" "$kind")
  printf '%s' "${value:--}"
}

# board_value <field-id>: the value of the board field <field-id> on the
# listed board's item in ISS_ISSUE, or "-" when it is unset or <field-id> is
# empty.
board_value() {
  iss_jq --arg p "$project" --arg f "$1" "[.projectItems.nodes[]? | select(.project.id == \$p)
    | .fieldValues.nodes[]? | select(.field.id? == \$f)][0]
    | if . == null or \$f == \"\" then \"-\"
      elif has(\"name\") then .name
      elif has(\"number\") then (.number | if . == floor then floor else . end)
      elif has(\"text\") then .text
      elif has(\"date\") then .date
      else .startDate // \"-\" end"
}

# board_field_id <name>: the ID of the listed board's field named <name>,
# matched case-insensitively, or nothing when the board has none.
board_field_id() {
  printf '%s' "$ISS_OWNER_BOARD_FIELDS" | jq -r --arg n "$1" \
    'first(.[] | select((.name // "" | ascii_downcase) == ($n | ascii_downcase)) | .id) // empty'
}

# row_config <nameWithOwner>: make the repo-config of the item's repository the
# one the accessors read, and set row_cfg to yes when it is present and usable,
# or to no -- absent, unreadable, tracked in Jira, at an unsupported schema
# version, or otherwise invalid, any of which but absent would abort a verb that
# read it. A read that fails other than as absent is warned about, and the
# listing goes on. Each repository's is read once, from its default branch --
# the current repository's too, since the local file spells references and
# nothing else here -- into its own directory $cache/<owner>/<repo>, since no
# owner or repository name holds a "/".
row_config() {
  local dir gp err rc=0
  dir=$cache/$(iss_lc "$1")
  if [ ! -d "$dir" ]; then
    err=$(mkdir -p "$dir" 2>&1) || iss_err_scratch "$err"
    iss_fetch_target_config "$host" "${1%%/*}" "${1#*/}" || rc=$?
    case "$rc" in
      0)
        # The parse runs in a subshell because it rejects a repo-config by
        # exiting. It makes no call and touches no file, so its only aborts are
        # those rejections, which this row falls back on rather than reports.
        if gp=$({ iss_parse_config_text "$ISS_TARGET_CONFIG_TEXT" && printf '%s' "$ISS_GP"; } 2>/dev/null); then
          err=$({ printf '%s' "$gp" >"$dir/gp" && : >"$dir/ok"; } 2>&1) || iss_err_scratch "$err"
        fi
        ;;
      1) ;;
      *) iss_warn_target_config_unreadable "$(iss_repo_name "$host" "${1%%/*}" "${1#*/}")" "$ISS_TARGET_CONFIG_ERR" ;;
    esac
  fi
  if [ -f "$dir/ok" ]; then
    ISS_GP=$(cat "$dir/gp" 2>&1) || iss_err_scratch "$ISS_GP"
    row_cfg=yes
  else
    ISS_GP=
    row_cfg=no
  fi
}

# row_other_board: whether the repo-config row_config made current reads
# priority or size from a board field on another board than the listed one,
# whose item a row iss_board_items kept does not carry.
row_other_board() {
  local slot
  [ "$row_cfg" = yes ] && [ "$(iss_cfg_get project-id)" != "$project" ] || return 1
  for slot in priority size; do
    case "$(iss_slot_kind "$slot")" in number | single-select) return 0 ;; esac
  done
  return 1
}

# row_slot <slot>: the slot's value on the item in ISS_ISSUE, from its
# repository's repo-config when row_config found one usable, else from the
# board field of the slot's name; "-" when unset.
row_slot() {
  if [ "$row_cfg" = yes ]; then
    slot_value "$1"
  else
    board_value "$(board_field_id "$1")"
  fi
}

tab=$(printf '\t')
usage='usage: issue-list [<owner> | <owner>/<repo>] [--project <number|url>] --status <name> [--view <name|number|url>] [--assignee <login>]... [--unassigned] [--limit <n>]'
status=
status_set=no
view=
view_set=no
project_arg=
project_set=no
assignees=
unassigned=no
limit=
target=
target_set=no
while [ "$#" -gt 0 ]; do
  case "$1" in
    --status | --view | --project | --assignee | --limit)
      [ "$#" -ge 2 ] || iss_usage_die "\`$1\` needs a value; $usage"
      case "$1" in
        --status)
          status=$2
          status_set=yes
          ;;
        --project)
          project_arg=$2
          project_set=yes
          ;;
        --view)
          view=$2
          view_set=yes
          ;;
        --assignee)
          iss_valid_login "$2" || iss_usage_die "\`$2\` is not a GitHub login"
          assignees=${assignees:+$assignees,}$2
          ;;
        --limit)
          iss_is_digits "$2" || iss_usage_die "\`--limit\` takes a non-negative integer, not \`$2\`; $usage"
          limit=$2
          ;;
      esac
      shift 2
      continue
      ;;
    --unassigned) unassigned=yes ;;
    --*) iss_usage_die "$usage" ;;
    *)
      [ "$target_set" = no ] || iss_usage_die "$usage"
      target=$1
      target_set=yes
      ;;
  esac
  shift
done
[ "$status_set" = yes ] || iss_usage_die "\`--status\` is required; $usage"

# A board URL, given to --project or --view, names the board by its owner and
# number, as --project <number> does with an owner positional. Named either
# way, that board is listed with no repo-config deciding what it holds.
board_mode=no
url_host=
url_owner=
if [ "$project_set" = yes ]; then
  board_mode=yes
  case "$project_arg" in
    https://*)
      { iss_parse_project_url "$project_arg" && [ -z "$PU_VIEW" ]; } ||
        iss_usage_die "\`$project_arg\` is not a project URL (expected https://host/orgs/owner/projects/N or https://host/users/owner/projects/N)"
      url_host=$PU_HOST
      url_owner=$PU_OWNER
      board_number=$PU_NUMBER
      ;;
    *)
      iss_is_digits "$project_arg" ||
        iss_usage_die "\`--project\` takes a project number or a project URL, not \`$project_arg\`; $usage"
      board_number=$project_arg
      ;;
  esac
fi
case "$view" in
  https://*)
    { iss_parse_project_url "$view" && [ -n "$PU_VIEW" ]; } ||
      iss_usage_die "\`$view\` is not a project view URL (expected https://host/orgs/owner/projects/N/views/V or https://host/users/owner/projects/N/views/V)"
    if [ "$project_set" = yes ] && { [ "$PU_NUMBER" != "$board_number" ] ||
      { [ -n "$url_owner" ] && [ "$(iss_lc "$PU_HOST/$PU_OWNER")" != "$(iss_lc "$url_host/$url_owner")" ]; }; }; then
      iss_usage_die "\`--view $view\` and \`--project $project_arg\` name different projects"
    fi
    board_mode=yes
    url_host=$PU_HOST
    url_owner=$PU_OWNER
    board_number=$PU_NUMBER
    view=$PU_VIEW
    ;;
esac

iss_require_tools
if [ "$board_mode" = yes ]; then
  # With a board named, a single word, with or without a trailing /, is an
  # owner, so `acme/` is the owner `acme`, and any other positional is a
  # repository the listing is scoped to. The owner and any host it spells are
  # read off the positional by its syntax alone, so the usage errors below come
  # before the gh call that resolving a host-less repository makes.
  board_owner=
  board_repo=
  target_host=
  case "${target%/}" in
    '') [ "$target_set" = no ] || iss_check_repo_syntax "$target" ;;
    */*)
      iss_check_repo_syntax "$target"
      case "$target" in
        *://*)
          iss_split_url "$target"
          target_host=$URL_HOST
          board_owner=$URL_OWNER
          ;;
        *)
          board_owner=${target%/}
          case "$board_owner" in
            */*/*)
              target_host=${board_owner%%/*}
              board_owner=${board_owner#*/}
              ;;
          esac
          board_owner=${board_owner%%/*}
          ;;
      esac
      ;;
    *)
      iss_valid_owner "${target%/}" || iss_usage_die "\`$target\` is not an owner; $usage"
      board_owner=${target%/}
      ;;
  esac
  if [ -n "$url_owner" ]; then
    if [ -n "$board_owner" ] && { [ "$(iss_lc "$board_owner")" != "$(iss_lc "$url_owner")" ] ||
      { [ -n "$target_host" ] && [ "$(iss_lc "$target_host")" != "$(iss_lc "$url_host")" ]; }; }; then
      iss_usage_die "\`$target\` and the URL's \`$url_host/$url_owner\` name different owners"
    fi
  elif [ -z "$board_owner" ]; then
    iss_usage_die "\`--project $project_arg\` needs the board's owner: name \`<owner>\` or \`<owner>/<repo>\`, or pass a project URL"
  fi
  case "${target%/}" in
    */*)
      iss_parse_repo "$target"
      board_repo=$RP_REPO
      host=$RP_HOST
      ;;
  esac
  iss_try_current_repo || :
  if [ -n "$url_owner" ]; then
    board_owner=$url_owner
    host=$url_host
  elif [ -z "$board_repo" ]; then
    host=$ISS_HOST
  fi
  owner=$board_owner
  repo=$board_repo
elif [ "$target_set" = no ]; then
  # The local repo-config is read before any gh call, so a Jira-tracked or
  # missing one stops the verb with none made.
  iss_load_config
  iss_current_repo
  host=$ISS_HOST
  owner=$ISS_OWNER
  repo=$ISS_REPO
  prefix=
else
  # A single word with no current repository to name a repository under can
  # only be an owner, and an owner holds many boards with nothing naming one.
  # Whether there is one can take the gh call that resolves it, so this is no
  # usage error. A trailing / is ignored, so `widgets/` is the single word
  # `widgets`.
  case "${target%/}" in
    */*) ;;
    *)
      iss_check_repo_syntax "$target"
      iss_try_current_repo || iss_err_list_no_current_repo "$target"
      ;;
  esac
  iss_parse_repo "$target"
  host=$RP_HOST
  owner=$RP_OWNER
  repo=$RP_REPO
  # A host/owner/repo or URL operand leaves the current repository unresolved,
  # and each printed reference is the shortest form relative to it.
  iss_try_current_repo || :
  iss_operand_config "$host" "$owner" "$repo" || iss_err_no_target_config "$host" "$owner" "$repo"
  prefix=$ISS_CFG_PREFIX
fi
# An issue of the current repository prints with the current repo-config's
# issue-link-prefix whichever repository is listed, the prefix iss_ref decides
# by, so the reference parses back in this checkout.
here_prefix=${ISS_HERE_LINK_PREFIX-$(iss_read_link_prefix)}

if [ "$board_mode" = yes ]; then
  # The scratch directory row_config caches into is made before the first
  # GraphQL call, which needs a scratch file of its own under the same
  # directory, so an unusable one is reported here rather than by that call.
  cache=$(mktemp -d "${TMPDIR:-/tmp}/$ISS_PROGRAM.XXXXXX" 2>&1) || iss_err_scratch "$cache"
  trap 'rm -rf "$cache"' EXIT
  # The board's own single-select Status field is what --status names.
  iss_owner_board "$host" "$owner" "$board_number"
  project=$ISS_OWNER_BOARD_ID
  status_field=$(printf '%s' "$ISS_OWNER_BOARD_FIELDS" |
    jq -c 'first(.[] | select(.name == "Status" and .dataType == "SINGLE_SELECT")) // empty')
  [ -n "$status_field" ] || iss_err_no_board_status "$owner" "$board_number"
  status_fid=$(printf '%s' "$status_field" | jq -r .id)
  status_name=$(printf '%s' "$status_field" | jq -r --arg s "$status" \
    'first(.options[]? | select((.name | ascii_downcase) == ($s | ascii_downcase)) | .name) // empty')
  [ -n "$status_name" ] ||
    iss_err_not_in_options "$status" status "$(printf '%s' "$status_field" | jq -r '[.options[]?.name] | join(", ")')"
  status_key=status
else
  [ "$ISS_HAS_GP" = 1 ] || iss_err_no_block "$prefix"
  status_kind=$(iss_slot_kind status)
  [ "$status_kind" = single-select ] || iss_err_no_status_slot "$status_kind" "$prefix"
  status_name=$(iss_resolve_name all "$status" fields status options) ||
    iss_err_not_in_options "$status" status "$(iss_slot_options status)"
  project=$(iss_cfg_get project-id)
  status_key=$(iss_board_field_key "$host" "$project" "$(iss_cfg_get fields status id)") || exit 1
fi

view_filter=
sort_fields='[]'
if [ "$view_set" = yes ]; then
  iss_board_views "$host" "$project"
  match=$(printf '%s' "$ISS_BOARD_NODES" | jq -c --arg v "$view" '
    first(.[] | select((.number | tostring) == $v))
    // first(.[] | select((.name | ascii_downcase) == ($v | ascii_downcase)))
    // empty')
  [ -n "$match" ] || iss_err_view_not_found "$view" "$(printf '%s' "$ISS_BOARD_NODES" | jq -r '[.[].name] | join(", ")')"
  view_filter=$(printf '%s' "$match" | jq -r '.filter // ""')
  sort_fields=$(printf '%s' "$match" | jq -c '.sortByFields.nodes // []')
  unsortable=$(printf '%s' "$sort_fields" | jq -r --arg ok "$SORTABLE" '
    first(.[].field | select(.dataType as $t | ($ok | split(" ") | index($t)) == null) | [.name, .dataType] | @tsv) // empty')
  if [ -n "$unsortable" ]; then
    iss_err_unsortable_field "$(printf '%s' "$match" | jq -r .name)" "${unsortable%%"$tab"*}" "${unsortable#*"$tab"}"
  fi
fi

# Each group that can hold OR is parenthesized: OR binds loosest in the
# board's filter grammar, so an unparenthesized one would widen the whole
# query.
search=
[ -z "$view_filter" ] || search="($view_filter) "
[ -z "$repo" ] || search="${search}repo:$owner/$repo "
search="${search}$status_key:\"$status_name\" is:issue is:open"
alternatives=
[ -z "$assignees" ] || alternatives="assignee:$assignees"
[ "$unassigned" = no ] || alternatives="${alternatives:+$alternatives OR }no:assignee"
case "$alternatives" in
  '') ;;
  *' OR '*) search="$search ($alternatives)" ;;
  *) search="$search $alternatives" ;;
esac

iss_board_items "$host" "$project" "$search"
ordered=$ISS_BOARD_ITEMS
if [ "$sort_fields" != '[]' ]; then
  ordered=$(printf '%s' "$ISS_BOARD_ITEMS" | sort_items "$project" "$sort_fields")
fi

while IFS= read -r ISS_ISSUE; do
  [ -n "$ISS_ISSUE" ] || continue
  # Every field but the last, the title, is non-empty, so none collapses into
  # its neighbour on read, and the title keeps any tab of its own.
  IFS=$tab read -r nwo number blockers assigned title <<EOF
$(iss_jq '[.repository.nameWithOwner, .number, ([.blockedBy.nodes[]? | select(.state == "OPEN")] | length),
           ([.assignees.nodes[]?.login] | join(",") | if . == "" then "-" else . end), .title // ""]
          | map(tostring) | join("\t")')
EOF
  ref=$(iss_ref_nwo "$host" "$nwo" "$number")
  case "$ref" in '#'*) ref=$here_prefix$number ;; esac
  if [ "$board_mode" = yes ]; then
    row_config "$nwo"
    ! row_other_board || iss_board_row_project_items "$host"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$ref" "$(board_value "$status_fid")" \
      "$(row_slot priority)" "$(row_slot size)" "$blockers" "$assigned" "$title"
  else
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$ref" "$(slot_value status)" \
      "$(slot_value priority)" "$(slot_value size)" "$blockers" "$assigned" "$title"
  fi
done <<EOF
$(printf '%s' "$ordered" | jq -c --argjson n "${limit:-null}" 'if $n == null then .[] else .[:$n][] end')
EOF
