#!/usr/bin/env bash
# Record that one issue blocks another: the blocked-by edge, named from the
# blocker's end. The contract is plugins/issues/skills/issue-set-blocks/SKILL.md.
set -uo pipefail
# shellcheck source-path=SCRIPTDIR source=lib/issues-common.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/issues-common.sh"

[ "$#" -eq 2 ] || iss_usage_die "usage: issue-set-blocks <N> <blocked-N>"
iss_init
iss_blocked_by_edge add "$2" "$1" blocker
if [ "$EDGE_RESULT" = noop ]; then
  printf 'Issue %s already blocks %s; no change.\n' "$EDGE_BLOCKER" "$EDGE_BLOCKED"
else
  printf 'Marked issue %s as blocking %s.\n%s\n' "$EDGE_BLOCKER" "$EDGE_BLOCKED" "$EDGE_URL"
fi
