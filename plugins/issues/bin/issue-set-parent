#!/usr/bin/env bash
# Make one issue a sub-issue of another, named from the child's end. The
# contract is plugins/issues/skills/issue-set-parent/SKILL.md.
set -uo pipefail
# shellcheck source-path=SCRIPTDIR source=lib/issues-common.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/issues-common.sh"

[ "$#" -eq 2 ] || iss_usage_die "usage: issue-set-parent <child-issue> <parent-issue>"
iss_init "$1" "$2"
iss_add_sub_issue "$2" "$1"
