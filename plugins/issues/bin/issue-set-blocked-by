#!/usr/bin/env bash
# Record that one issue is blocked by another. The contract is
# plugins/issues/skills/issue-set-blocked-by/SKILL.md.
set -uo pipefail
# shellcheck source-path=SCRIPTDIR source=lib/issues-common.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/issues-common.sh"

[ "$#" -eq 2 ] || iss_usage_die "usage: issue-set-blocked-by <N> <blocker-N>"
iss_init
iss_blocked_by_edge add "$1" "$2" blocked
if [ "$EDGE_RESULT" = noop ]; then
  printf 'Issue %s is already blocked by %s; no change.\n' "$EDGE_BLOCKED" "$EDGE_BLOCKER"
else
  printf 'Marked issue %s as blocked by %s.\n%s\n' "$EDGE_BLOCKED" "$EDGE_BLOCKER" "$EDGE_URL"
fi
