#!/usr/bin/env bash
# Set the issue type on one existing issue. The contract is
# plugins/issues/skills/issue-set-type/SKILL.md.
set -uo pipefail
# shellcheck source-path=SCRIPTDIR source=lib/issues-common.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/issues-common.sh"

[ "$#" -eq 2 ] || iss_usage_die "usage: issue-set-type <issue> <type-name>"
iss_init "$1"
iss_parse_operand "$1"
iss_operand_board_config
iss_cfg_get issue-types >/dev/null 2>&1 || iss_err_no_issue_types "$ISS_CFG_PREFIX"
ref=$(iss_ref "$OP_HOST" "$OP_OWNER" "$OP_REPO" "$OP_NUMBER")

type_name=$(iss_resolve_name skip-default "$2" issue-types) ||
  iss_err_type_not_known "$2" "$(iss_cfg_children issue-types | grep -vx default | iss_join_lines)"
type_id=$(iss_cfg_get issue-types "$type_name")

iss_lookup "$OP_HOST" "$OP_OWNER" "$OP_REPO" "$OP_NUMBER" "id issueType { id name }"
if [ "$(iss_jq '.issueType.id // empty')" = "$type_id" ]; then
  printf '%s type already set to %s.\n' "$ref" "$type_name"
  exit 0
fi

iss_type_write "$OP_HOST" "$OP_OWNER" "$OP_REPO" "$OP_NUMBER" "$(iss_jq .id)" "$type_id" "$type_name"
printf '%s type set to %s.\n' "$ref" "$type_name"
