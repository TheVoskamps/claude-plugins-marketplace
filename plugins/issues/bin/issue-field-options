#!/usr/bin/env bash
# Report what repo-config says a field slot accepts and defaults to, or every
# slot's when none is named — this repo's, or with --repo another's. Only
# --repo makes a gh call. The contract is
# plugins/issues/skills/issue-field-options/SKILL.md.
set -uo pipefail
# shellcheck source-path=SCRIPTDIR source=lib/issues-common.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/issues-common.sh"

# The slot's default: in the options' own capitalization when it names one,
# otherwise as the config spells it; nothing when the slot declares none.
default_suffix() {
  local key=$1 kind=$2 value canonical
  value=$(iss_cfg_get fields "$key" default 2>/dev/null) || return 0
  [ -n "$value" ] || return 0
  if [ "$kind" != number ] && canonical=$(iss_resolve_name all "$value" fields "$key" options); then
    value=$canonical
  fi
  printf ' (default: %s)' "$value"
}

# report <slot-as-named> [<configured-key>]
report() {
  local name=$1 key=${2:-} kind bound
  if [ -z "$key" ]; then
    printf '%s: unconfigured\n' "$name"
    return
  fi
  kind=$(iss_slot_kind "$key")
  case "$kind" in
    skip)
      printf '%s: unconfigured\n' "$key"
      ;;
    number)
      printf '%s: number%s\n' "$key" "$(default_suffix "$key" number)"
      for bound in min max; do
        if iss_cfg_get fields "$key" "$bound" >/dev/null 2>&1; then
          printf '  %s: %s\n' "$bound" "$(iss_cfg_get fields "$key" "$bound")"
        fi
      done
      ;;
    *)
      printf '%s: %s%s\n' "$key" "$kind" "$(default_suffix "$key" "$kind")"
      iss_cfg_children fields "$key" options | sed 's/^/  /'
      ;;
  esac
}

usage='usage: issue-field-options [<slot>] [--repo owner/repo]'
slot=
slot_set=no
target=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --repo)
      [ "$#" -ge 2 ] && [ -z "$target" ] || iss_usage_die "$usage"
      target=$2
      shift 2
      ;;
    -*) iss_usage_die "$usage" ;;
    *)
      [ "$slot_set" = no ] || iss_usage_die "$usage"
      slot=$1
      slot_set=yes
      shift
      ;;
  esac
done

if [ -z "$target" ]; then
  iss_load_config
else
  # A target with no repo-config leaves every slot unconfigured.
  iss_load_target_config "$target" || :
fi

if [ "$slot_set" = yes ]; then
  key=
  [ "$ISS_HAS_GP" = 1 ] && key=$(iss_resolve_name all "$slot" fields)
  report "$slot" "$key"
  exit 0
fi

if [ "$ISS_HAS_GP" != 1 ] || [ -z "$(iss_cfg_children fields)" ]; then
  printf 'No fields configured.\n'
  exit 0
fi
first=1
while IFS= read -r key; do
  [ -n "$key" ] || continue
  [ "$first" = 1 ] || printf '\n'
  first=0
  report "$key" "$key"
done <<EOF
$(iss_cfg_children fields)
EOF
