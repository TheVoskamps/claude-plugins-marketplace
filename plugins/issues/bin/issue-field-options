#!/usr/bin/env bash
# Report what repo-config says a field slot accepts and defaults to, or every
# slot's when none is named — this repo's, or the one a positional <repo>
# names. Only a named repo makes a gh call. The contract is
# plugins/issues/skills/issue-field-options/SKILL.md.
set -uo pipefail
# shellcheck source-path=SCRIPTDIR source=lib/issues-common.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/issues-common.sh"

# The slot's default: in the options' own capitalization when it names one,
# otherwise as the config spells it; nothing when the slot declares none.
default_suffix() {
  local key=$1 kind=$2 value canonical
  value=$(iss_cfg_get fields "$key" default 2>/dev/null) || return 0
  [ -n "$value" ] || return 0
  if [ "$kind" != number ] && canonical=$(iss_resolve_name all "$value" fields "$key" options); then
    value=$canonical
  fi
  printf ' (default: %s)' "$value"
}

# report <slot-as-named> [<configured-key>]
report() {
  local name=$1 key=${2:-} kind bound
  if [ -z "$key" ]; then
    printf '%s: unconfigured\n' "$name"
    return
  fi
  kind=$(iss_slot_kind "$key")
  case "$kind" in
    skip)
      printf '%s: unconfigured\n' "$key"
      ;;
    number)
      printf '%s: number%s\n' "$key" "$(default_suffix "$key" number)"
      for bound in min max; do
        if iss_cfg_get fields "$key" "$bound" >/dev/null 2>&1; then
          printf '  %s: %s\n' "$bound" "$(iss_cfg_get fields "$key" "$bound")"
        fi
      done
      ;;
    *)
      printf '%s: %s%s\n' "$key" "$kind" "$(default_suffix "$key" "$kind")"
      iss_cfg_children fields "$key" options | sed 's/^/  /'
      ;;
  esac
}

usage='usage: issue-field-options [[<repo>] <slot>]
       issue-field-options [<repo>] --all'
all=no
positionals=0
first_arg=
second_arg=
while [ "$#" -gt 0 ]; do
  case "$1" in
    --all) all=yes ;;
    --repo)
      iss_usage_die "\`--repo\` is not an issue-field-options flag; name the repository positionally: issue-field-options <repo> <slot>, or issue-field-options <repo> --all"
      ;;
    -*) iss_usage_die "$usage" ;;
    *)
      positionals=$((positionals + 1))
      case "$positionals" in
        1) first_arg=$1 ;;
        2) second_arg=$1 ;;
        *) iss_usage_die "$usage" ;;
      esac
      ;;
  esac
  shift
done

# Without --all, one positional is a slot and two are <repo> <slot>; with it,
# the one positional it accepts is the repository.
target=
target_set=no
slot=
slot_set=no
if [ "$all" = yes ]; then
  [ "$positionals" -le 1 ] ||
    iss_usage_die "\`--all\` reports every slot, so it takes no slot; $usage"
  [ "$positionals" -eq 0 ] || { target=$first_arg; target_set=yes; }
else
  case "$positionals" in
    1) slot=$first_arg; slot_set=yes ;;
    2) target=$first_arg; target_set=yes; slot=$second_arg; slot_set=yes ;;
  esac
fi

if [ "$target_set" = no ]; then
  iss_load_config
else
  iss_parse_repo "$target"
  # A target with no repo-config leaves every slot unconfigured.
  iss_load_target_config "$RP_HOST" "$RP_OWNER" "$RP_REPO" || :
fi

if [ "$slot_set" = yes ]; then
  key=
  [ "$ISS_HAS_GP" = 1 ] && key=$(iss_resolve_name all "$slot" fields)
  report "$slot" "$key"
  exit 0
fi

if [ "$ISS_HAS_GP" != 1 ] || [ -z "$(iss_cfg_children fields)" ]; then
  printf 'No fields configured.\n'
  exit 0
fi
first=1
while IFS= read -r key; do
  [ -n "$key" ] || continue
  [ "$first" = 1 ] || printf '\n'
  first=0
  report "$key" "$key"
done <<EOF
$(iss_cfg_children fields)
EOF
