#!/usr/bin/env bash
# The live lookups the issues skills' interviews make, on the host the current
# repository's origin is on: the owner's project boards, one board's fields,
# the repository's native issue fields and issue types, and the authenticated
# user. Each subcommand prints JSON on stdout. Reads no repo-config, since
# /repo-config runs it before one exists.
set -uo pipefail
# shellcheck source-path=SCRIPTDIR source=lib/issues-common.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/issues-common.sh"

usage="usage: issues-discover projects | project <number> | fields <number> | issue-fields | issue-types | viewer"

case "${1:-}" in
  projects|issue-fields|issue-types|viewer)
    [ "$#" -eq 1 ] || iss_usage_die "$usage"
    ;;
  project|fields)
    { [ "$#" -eq 2 ] && iss_is_digits "$2"; } || iss_usage_die "$usage"
    ;;
  *)
    iss_usage_die "$usage"
    ;;
esac

# The scope a subcommand's query needs, named when the token lacks one and
# gh's error does not say which.
case "$1" in projects|project|fields) scope=read:project ;; *) scope=repo ;; esac

iss_require_tools
iss_current_repo

# disc_repo_null: succeed when the last iss_gql call's response holds a null
# `repository` -- one the host does not resolve, not one with nothing to list.
disc_repo_null() {
  [ "$(printf '%s' "$ISS_GQL_OUT" | jq -r '(.data // {}) | has("repository") and .repository == null' 2>/dev/null)" = true ]
}

# disc_fail: abort on the last iss_gql call's failure, never returning. A
# missing scope names the scope and the host whose token lacks it; anything
# else passes gh's error through.
disc_fail() {
  local err needed=$scope
  local listed="following scopes: \[[\"']([^\"']*)[\"']" missing='missing required scopes? \[([^], ]*)'
  err="$ISS_GQL_ERR $ISS_GQL_OUT"
  case "$err" in
    *INSUFFICIENT_SCOPES*|*"required scopes"*|*"missing required scope"*)
      if [[ $err =~ $listed ]] || [[ $err =~ $missing ]]; then
        needed=${BASH_REMATCH[1]:-$scope}
      fi
      iss_err_missing_scope "$ISS_HOST" "$needed" "${ISS_GQL_ERR:-$ISS_GQL_OUT}"
      ;;
  esac
  iss_gql_fail
}

# disc_nodes <doc> <jq-path> <gh args...>: run <doc>, whose connection at
# <jq-path> takes $after, page it to its end, and set DISC_NODES to every node
# as one JSON array, or to "null" when the connection is null. Returns 1 when
# a call fails, ISS_GQL_OUT and ISS_GQL_ERR holding its output, and exits when
# a page past the first comes back null.
disc_nodes() {
  local doc=$1 path=$2 conn cursor=
  shift 2
  DISC_NODES=[]
  while :; do
    if [ -n "$cursor" ]; then
      iss_gql "$ISS_HOST" -f query="$doc" "$@" -f after="$cursor" || return 1
    else
      iss_gql "$ISS_HOST" -f query="$doc" "$@" || return 1
    fi
    conn=$(printf '%s' "$ISS_GQL_OUT" | jq -c "$path")
    if [ "$conn" = null ]; then
      [ -n "$cursor" ] || { DISC_NODES=null; return 0; }
      iss_die "the next page of \`$path\` came back empty"
    fi
    DISC_NODES=$(jq -cn --argjson a "$DISC_NODES" --argjson c "$conn" '$a + $c.nodes')
    [ "$(printf '%s' "$conn" | jq -r .pageInfo.hasNextPage)" = true ] || return 0
    cursor=$(printf '%s' "$conn" | jq -r .pageInfo.endCursor)
  done
}

case "$1" in
  projects)
    disc_nodes "$ISS_DOC_DISCOVER_PROJECTS" .data.repositoryOwner.projectsV2 -f owner="$ISS_OWNER" || disc_fail
    # Every repository owner is a ProjectV2Owner, so a null connection is an
    # owner the host does not resolve.
    [ "$DISC_NODES" != null ] || iss_die "no owner \`$ISS_OWNER\` on \`$ISS_HOST\`"
    printf '%s\n' "$DISC_NODES"
    ;;
  project)
    iss_gql "$ISS_HOST" -f query="$ISS_DOC_DISCOVER_PROJECT" -f owner="$ISS_OWNER" -F number="$2" || disc_fail
    out=$(printf '%s' "$ISS_GQL_OUT" | jq -c '.data.repositoryOwner.projectV2')
    [ "$out" != null ] || iss_die "no project \`$2\` under \`$ISS_OWNER\` on \`$ISS_HOST\`"
    printf '%s\n' "$out"
    ;;
  fields)
    disc_nodes "$ISS_DOC_DISCOVER_FIELDS" .data.repositoryOwner.projectV2.fields \
      -f owner="$ISS_OWNER" -F number="$2" || disc_fail
    [ "$DISC_NODES" != null ] || iss_die "no project \`$2\` under \`$ISS_OWNER\` on \`$ISS_HOST\`"
    printf '%s\n' "$DISC_NODES" | jq -c '[.[] | select(.dataType == "NUMBER" or .dataType == "SINGLE_SELECT")
      | if .dataType == "SINGLE_SELECT" then {id, name, dataType, options} else {id, name, dataType} end]'
    ;;
  issue-fields)
    if ! disc_nodes "$ISS_DOC_DISCOVER_ISSUE_FIELDS" .data.repository.issueFields \
      -f owner="$ISS_OWNER" -f repo="$ISS_REPO"; then
      case "$ISS_GQL_ERR $ISS_GQL_OUT" in
        *issueFields*"doesn't exist"*|*undefinedField*|*IssueField*"No such type"*|*"No such type"*IssueField*|*undefinedType*)
          printf "%s: \`issueFields\` is not in the schema on \`%s\`, so there are no native issue fields\n" \
            "$ISS_PROGRAM" "$ISS_HOST" >&2
          printf '[]\n'
          exit 0
          ;;
      esac
      disc_fail
    fi
    [ "$DISC_NODES" != null ] || ! disc_repo_null || iss_err_repo_not_found "$ISS_HOST" "$ISS_OWNER" "$ISS_REPO"
    out=$(printf '%s\n' "$DISC_NODES" |
      jq -c '[(. // [])[] | select(.__typename == "IssueFieldSingleSelect") | {id, name, options}]')
    [ "$out" != '[]' ] ||
      printf "%s: \`%s/%s\` has no single-select native issue fields\n" "$ISS_PROGRAM" "$ISS_OWNER" "$ISS_REPO" >&2
    printf '%s\n' "$out"
    ;;
  issue-types)
    disc_nodes "$ISS_DOC_DISCOVER_ISSUE_TYPES" .data.repository.issueTypes \
      -f owner="$ISS_OWNER" -f repo="$ISS_REPO" || disc_fail
    [ "$DISC_NODES" != null ] || ! disc_repo_null || iss_err_repo_not_found "$ISS_HOST" "$ISS_OWNER" "$ISS_REPO"
    printf '%s\n' "$DISC_NODES" | jq -c '[(. // [])[] | select(.isEnabled == true) | {id, name}]'
    ;;
  viewer)
    login=$(iss_viewer_login "$ISS_HOST") || exit 1
    jq -cn --arg host "$ISS_HOST" --arg owner "$ISS_OWNER" --arg repo "$ISS_REPO" --arg login "$login" \
      '{host: $host, owner: $owner, repo: $repo, login: $login}'
    ;;
esac
