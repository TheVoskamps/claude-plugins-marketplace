#!/usr/bin/env bash
# The <slot>_line and <slot>_value variables are written and read through eval,
# and backticks in single quotes are literal Markdown.
# shellcheck disable=SC2016,SC2034
# File one issue with its type, field slots, parent, assignees and labels set,
# in this repo or, with --repo, in another. Every value is validated before
# the issue is created, and every write is re-read after it. The contract is
# plugins/issues/skills/issue-create/SKILL.md.
set -uo pipefail
# shellcheck source-path=SCRIPTDIR source=lib/issues-common.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/issues-common.sh"

usage='usage: issue-create --title "..." --body-file PATH [--type T] [--labels a,b,c] [--assignee u1,u2]
                    [--parent N] [--priority V] [--size V] [--status S] [--repo owner/repo]'

title=
body_file=
type_arg=
labels=
assignee_arg=
parent_arg=
target=
priority_arg=
size_arg=
status_arg=
priority_set=no
size_set=no
status_set=no
while [ "$#" -gt 0 ]; do
  case "$1" in
    --title|--body-file|--type|--labels|--assignee|--parent|--priority|--size|--status|--repo)
      [ "$#" -ge 2 ] || iss_usage_die "$usage"
      ;;
    *) iss_usage_die "$usage" ;;
  esac
  case "$1" in
    --title) title=$2 ;;
    --body-file) body_file=$2 ;;
    --type) type_arg=$2 ;;
    --labels) labels=$2 ;;
    --assignee) assignee_arg=$2 ;;
    --parent) parent_arg=$2 ;;
    --repo) target=$2 ;;
    --priority) priority_arg=$2; priority_set=yes ;;
    --size) size_arg=$2; size_set=yes ;;
    --status) status_arg=$2; status_set=yes ;;
  esac
  shift 2
done
[ -n "$title" ] && [ -n "$body_file" ] || iss_usage_die "$usage"

iss_require_tools

# ---------------------------------------------------------------------------
# Which repo, and whose repo-config.
# ---------------------------------------------------------------------------

no_target_config=no
if [ -z "$target" ]; then
  iss_load_config
  iss_current_repo
  owner=$ISS_OWNER
  repo=$ISS_REPO
else
  case "$target" in
    */*) owner=${target%%/*}; repo=${target#*/} ;;
    *) iss_usage_die "\`--repo\` takes owner/repo" ;;
  esac
  case "$repo" in ''|*/*) iss_usage_die "\`--repo\` takes owner/repo" ;; esac
  ISS_REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || ISS_REPO_ROOT=
  errf=$(mktemp "${TMPDIR:-/tmp}/issue-create.XXXXXX")
  if content=$(gh api "repos/$owner/$repo/contents/.issues/repo-config.md" --jq .content 2>"$errf"); then
    rm -f "$errf"
    text=$(printf '%s' "$content" | tr -d '\n' | base64 --decode) ||
      iss_die "could not decode \`$owner/$repo\`'s \`.issues/repo-config.md\`"
    iss_parse_config_text "$text" "target repo \`$owner/$repo\`: "
  elif grep -q 'HTTP 404' "$errf"; then
    rm -f "$errf"
    no_target_config=yes
    ISS_HAS_GP=0
    ISS_GP=
    ISS_LINK_PREFIX='#'
  else
    err=$(cat "$errf"); rm -f "$errf"
    iss_die "could not read \`$owner/$repo\`'s \`.issues/repo-config.md\`: $err"
  fi
  # References print as #N for the current repo and owner/repo#N elsewhere,
  # so the current repo is resolved when there is one.
  if nwo=$(gh repo view --json owner,name --jq '.owner.login + "/" + .name' 2>/dev/null); then
    ISS_OWNER=${nwo%%/*}
    ISS_REPO=${nwo#*/}
  else
    ISS_OWNER=
    ISS_REPO=
  fi
fi

case "$body_file" in
  /*) ;;
  *) [ -f "$body_file" ] || [ -z "${ISS_REPO_ROOT:-}" ] || body_file="$ISS_REPO_ROOT/$body_file" ;;
esac
[ -r "$body_file" ] || iss_die "body file \`$body_file\` does not exist or is not readable"

# ---------------------------------------------------------------------------
# Resolve and validate everything before the issue exists.
# ---------------------------------------------------------------------------

warnings=
warn() { warnings="$warnings$1$ISS_NEWLINE"; }

type_line=
type_id=
if [ "$no_target_config" = yes ]; then
  type_line="skipped: target repo has no repo-config"
elif [ "$ISS_HAS_GP" != 1 ]; then
  type_line="skipped: no github-project block in repo-config"
  warn "warning: no \`github-project:\` block in \`repo-config.md\`; skipping \`--type\`. Run \`/repo-config\` to add it."
elif ! iss_cfg_get issue-types >/dev/null 2>&1; then
  type_line="skipped: no issue-types map in repo-config"
  warn "warning: issue-types map missing from \`github-project:\` in \`repo-config.md\`; skipping \`--type\`. Run \`/repo-config\` to add it."
else
  known_types=$(iss_cfg_children issue-types | grep -vx default | iss_join_lines)
  if [ -n "$type_arg" ]; then
    type_name=$(iss_resolve_name skip-default "$type_arg" issue-types) || iss_err_type_not_known "$type_arg" "$known_types"
  elif default_type=$(iss_cfg_get issue-types default 2>/dev/null) && [ -n "$default_type" ]; then
    type_name=$(iss_resolve_name skip-default "$default_type" issue-types) || iss_err_type_not_known "$default_type" "$known_types"
  elif type_name=$(iss_resolve_name skip-default Feature issue-types); then
    :
  else
    type_name=
    type_line="skipped: built-in default Feature is not in the issue-types map"
  fi
  if [ -n "$type_name" ]; then
    type_id=$(iss_cfg_get issue-types "$type_name")
    type_line=$type_name
  fi
fi

# resolve_slot <slot> <passed yes|no> <value>: sets <slot>_line and
# <slot>_value (the canonical value to write, empty when skipped).
resolve_slot() {
  local slot=$1 passed=$2 value=$3 kind line='' resolved=''
  if [ "$no_target_config" = yes ]; then
    line="skipped: target repo has no repo-config"
  elif [ "$ISS_HAS_GP" != 1 ]; then
    line="skipped: no github-project block in repo-config"
    warn "warning: no \`github-project:\` block in \`repo-config.md\`; skipping \`--$slot\`. Run \`/repo-config\` to add it."
  else
    kind=$(iss_slot_kind "$slot")
    if [ "$kind" = skip ]; then
      if iss_cfg_get fields "$slot" >/dev/null 2>&1; then
        line="skipped: slot kind: skip"
        warn "warning: slot '$slot' is kind: skip in repo-config.md; skipping --$slot."
      else
        line="skipped: slot absent from fields:"
        warn "warning: slot '$slot' is missing from fields: in repo-config.md; skipping --$slot."
      fi
    else
      if [ "$passed" = no ]; then
        value=$(iss_cfg_get fields "$slot" default 2>/dev/null) || value=
      fi
      if [ -z "$value" ]; then
        line="skipped: flag not passed and no default"
      else
        iss_slot_resolve "$slot" "$value"
        resolved=$SLOT_VALUE
        line=$SLOT_VALUE
      fi
    fi
  fi
  eval "${slot}_line=\$line; ${slot}_value=\$resolved"
}
priority_line=; priority_value=; size_line=; size_value=; status_line=; status_value=
resolve_slot priority "$priority_set" "$priority_arg"
resolve_slot size "$size_set" "$size_arg"
resolve_slot status "$status_set" "$status_arg"

parent_id=
parent_ref=
if [ -n "$parent_arg" ]; then
  num=${parent_arg#"$ISS_LINK_PREFIX"}
  num=${num#'#'}
  iss_is_digits "$num" || iss_usage_die "\`--parent\` takes an issue number"
  iss_lookup "$owner" "$repo" "$num" id
  parent_id=$(iss_jq .id)
  parent_ref=$(iss_ref "$owner" "$repo" "$num")
fi

assignees=$assignee_arg
if [ -z "$assignees" ] && [ "$no_target_config" = no ]; then
  if [ -n "$target" ]; then
    assignees=$(iss_default_assignee global-only) || exit 1
  else
    assignees=$(iss_default_assignee) || exit 1
  fi
fi

# ---------------------------------------------------------------------------
# Create, then apply and verify each piece.
# ---------------------------------------------------------------------------

created_url=
completed=
on_exit() {
  local rc=$?
  if [ "$rc" -ne 0 ] && [ -n "$created_url" ]; then
    printf '%s: issue %s was created (%s), but the run stopped before finishing.\n' \
      "$ISS_PROGRAM" "$ref" "$created_url" >&2
    printf '%s: completed: %s\n' "$ISS_PROGRAM" "${completed:-the create only}" >&2
  fi
}
trap on_exit EXIT
step_done() { completed="${completed:+$completed, }$1"; }

set -- issue create --repo "$owner/$repo" --title "$title" --body-file "$body_file"
[ -n "$labels" ] && set -- "$@" --label "$labels"
[ -n "$assignees" ] && set -- "$@" --assignee "$assignees"
out=$(gh "$@") || iss_die "\`gh issue create\` failed; no issue was created"
created_url=$(printf '%s\n' "$out" | grep -o 'https://[^[:space:]]*/issues/[0-9][0-9]*' | tail -n 1)
[ -n "$created_url" ] || iss_die "\`gh issue create\` printed no issue URL: $out"
number=${created_url##*/}
ref=$(iss_ref "$owner" "$repo" "$number")
step_done create

iss_lookup "$owner" "$repo" "$number" "id $ISS_SEL_PROJECT_ITEMS"
issue_id=$(iss_jq .id)

if [ "$ISS_HAS_GP" = 1 ] && iss_cfg_get project-id >/dev/null 2>&1 && [ -z "$(iss_project_item)" ]; then
  iss_gql -f query="$ISS_DOC_ADD_PROJECT_ITEM" -f projectId="$(iss_cfg_get project-id)" -f contentId="$issue_id" ||
    iss_gql_fail
  step_done "added to project"
fi

if [ -n "$type_id" ]; then
  iss_gql -f query="$ISS_DOC_SET_TYPE" -f issueId="$issue_id" -f issueTypeId="$type_id" || iss_gql_fail
  iss_lookup "$owner" "$repo" "$number" "issueType { id name }"
  [ "$(iss_jq '.issueType.id // empty')" = "$type_id" ] ||
    iss_err_write_not_landed type "$ref" "$type_name" "$(iss_jq '.issueType.name // "(none)"')"
  step_done "type"
fi

if [ -n "$parent_id" ]; then
  iss_gql -f query="$ISS_DOC_ADD_SUB_ISSUE" -f parentId="$parent_id" -f childId="$issue_id" || iss_gql_fail
  iss_lookup "$owner" "$repo" "$number" "$ISS_SEL_PARENT"
  [ "$(iss_jq '.parent.id // empty')" = "$parent_id" ] ||
    iss_err_write_not_landed parent "$ref" "$parent_ref" "(none)"
  step_done "parent"
fi

for slot in priority size status; do
  eval "value=\$${slot}_value"
  [ -n "$value" ] || continue
  iss_slot_resolve "$slot" "$value"
  iss_slot_write "$slot" "$owner" "$repo" "$number" always
  step_done "$slot"
done

assignee_line="skipped: no --assignee passed and no built-in default applies"
if [ -n "$assignees" ]; then
  iss_lookup "$owner" "$repo" "$number" "assignees(first: 50) { nodes { login } }"
  have=$(iss_jq '.assignees.nodes[].login')
  have_lc=$(printf '%s\n' "$have" | tr '[:upper:]' '[:lower:]')
  missing=
  for login in $(printf '%s' "$assignees" | tr ',' ' '); do
    printf '%s\n' "$have_lc" | grep -Fxq -- "$(iss_lc "$login")" || missing="${missing:+$missing, }$login"
  done
  if [ -n "$missing" ]; then
    assignee_line="$(printf '%s' "$have" | iss_join_lines) (requested $assignees; $missing did not land)"
  else
    assignee_line=$(printf '%s' "$have" | iss_join_lines)
  fi
fi

printf 'Created issue %s "%s"\n' "$ref" "$title"
printf '  type:       %s\n' "$type_line"
printf '  priority:   %s\n' "$priority_line"
printf '  size:       %s\n' "$size_line"
printf '  status:     %s\n' "$status_line"
printf '  assignee:   %s\n' "$assignee_line"
[ -z "$parent_ref" ] || printf '  parent:     %s\n' "$parent_ref"
if [ "$no_target_config" = yes ]; then
  printf '\nnote: project fields skipped: %s has no %s.\n' "\`$owner/$repo\`" '`.issues/repo-config.md`'
fi
[ -z "$warnings" ] || printf '\n%s' "$warnings"
printf '\n%s\n' "$created_url"

if [ -n "${missing:-}" ]; then
  created_url=
  iss_die "assignee(s) $missing did not land on issue \`$ref\`"
fi
