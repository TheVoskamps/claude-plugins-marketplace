#!/usr/bin/env bash
# File one issue with its type, field slots, parent, assignees and labels set,
# in this repo or in the one a positional <repo> names. The type, slot and
# parent values are validated before the issue is created; the type, parent,
# slot, assignee and label writes are re-read after it. The contract is
# plugins/issues/skills/issue-create/SKILL.md.
set -uo pipefail
# shellcheck source-path=SCRIPTDIR source=lib/issues-common.sh
. "$(dirname "${BASH_SOURCE[0]}")/lib/issues-common.sh"

usage='usage: issue-create [<repo>] --title "..." --body-file PATH [--type T] [--labels a,b,c] [--assignee u1,u2]
                    [--parent <issue>] [--priority V] [--size V] [--status S]'

title=
body_file=
type_arg=
labels=
assignee_arg=
parent_arg=
target=
target_set=no
priority_arg=
size_arg=
status_arg=
priority_set=no
size_set=no
status_set=no
while [ "$#" -gt 0 ]; do
  case "$1" in
    --title|--body-file|--type|--labels|--assignee|--parent|--priority|--size|--status)
      [ "$#" -ge 2 ] || iss_usage_die "$usage"
      ;;
    --repo)
      iss_usage_die "\`--repo\` is not an issue-create flag; name the repository as the first argument: issue-create <repo> --title \"...\" --body-file PATH"
      ;;
    -*) iss_usage_die "$usage" ;;
    *)
      [ "$target_set" = no ] || iss_usage_die "$usage"
      target=$1
      target_set=yes
      shift
      continue
      ;;
  esac
  case "$1" in
    --title) title=$2 ;;
    --body-file) body_file=$2 ;;
    --type) type_arg=$2 ;;
    --labels) labels=$2 ;;
    --assignee) assignee_arg=$2 ;;
    --parent) parent_arg=$2 ;;
    --priority) priority_arg=$2; priority_set=yes ;;
    --size) size_arg=$2; size_set=yes ;;
    --status) status_arg=$2; status_set=yes ;;
  esac
  shift 2
done
[ -n "$title" ] && [ -n "$body_file" ] || iss_usage_die "$usage"

iss_require_tools

# ---------------------------------------------------------------------------
# Which repo, and whose repo-config.
# ---------------------------------------------------------------------------

no_target_config=no
if [ "$target_set" = no ]; then
  iss_load_config
  iss_current_repo
  host=$ISS_HOST
  owner=$ISS_OWNER
  repo=$ISS_REPO
else
  # The current repo anchors a relative --body-file, completes a target named
  # without its host or owner, and decides how references print; its
  # repo-config is never read, since the target's alone governs.
  ISS_REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || ISS_REPO_ROOT=
  iss_parse_repo "$target"
  iss_try_current_repo || :
  host=$RP_HOST
  owner=$RP_OWNER
  repo=$RP_REPO
  iss_load_target_config "$host" "$owner" "$repo" || no_target_config=yes
fi

case "$body_file" in
  /*) ;;
  *) [ -f "$body_file" ] || [ -z "${ISS_REPO_ROOT:-}" ] || body_file="$ISS_REPO_ROOT/$body_file" ;;
esac
[ -r "$body_file" ] || iss_die "body file \`$body_file\` does not exist or is not readable"

# ---------------------------------------------------------------------------
# Resolve and validate everything before the issue exists.
# ---------------------------------------------------------------------------

warnings=
warn() { warnings="$warnings$1$ISS_NEWLINE"; }

type_line=
type_id=
if [ "$no_target_config" = yes ]; then
  type_line="skipped: target repo has no repo-config"
elif [ "$ISS_HAS_GP" != 1 ]; then
  type_line="skipped: no github-project block in repo-config"
  warn "warning: no \`github-project:\` block in \`repo-config.md\`; skipping \`--type\`. Run \`/repo-config\` to add it."
elif ! iss_cfg_get issue-types >/dev/null 2>&1; then
  type_line="skipped: no issue-types map in repo-config"
  warn "warning: issue-types map missing from \`github-project:\` in \`repo-config.md\`; skipping \`--type\`. Run \`/repo-config\` to add it."
else
  known_types=$(iss_cfg_children issue-types | grep -vx default | iss_join_lines)
  if [ -n "$type_arg" ]; then
    type_name=$(iss_resolve_name skip-default "$type_arg" issue-types) || iss_err_type_not_known "$type_arg" "$known_types"
  elif default_type=$(iss_cfg_get issue-types default 2>/dev/null) && [ -n "$default_type" ]; then
    type_name=$(iss_resolve_name skip-default "$default_type" issue-types) || iss_err_type_not_known "$default_type" "$known_types"
  elif type_name=$(iss_resolve_name skip-default Feature issue-types); then
    :
  else
    type_name=
    type_line="skipped: built-in default Feature is not in the issue-types map"
  fi
  if [ -n "$type_name" ]; then
    type_id=$(iss_cfg_get issue-types "$type_name")
    type_line=$type_name
  fi
fi

# resolve_slot <slot> <passed yes|no> <value>: sets slot_line and slot_value
# (the canonical value to write, empty when skipped).
resolve_slot() {
  local slot=$1 passed=$2 value=$3 kind
  slot_line=
  slot_value=
  if [ "$no_target_config" = yes ]; then
    slot_line="skipped: target repo has no repo-config"
  elif [ "$ISS_HAS_GP" != 1 ]; then
    slot_line="skipped: no github-project block in repo-config"
    warn "warning: no \`github-project:\` block in \`repo-config.md\`; skipping \`--$slot\`. Run \`/repo-config\` to add it."
  else
    kind=$(iss_slot_kind "$slot")
    if [ "$kind" = skip ]; then
      if iss_cfg_get fields "$slot" >/dev/null 2>&1; then
        slot_line="skipped: slot kind: skip"
        warn "warning: slot '$slot' is kind: skip in repo-config.md; skipping --$slot."
      else
        slot_line="skipped: slot absent from fields:"
        warn "warning: slot '$slot' is missing from fields: in repo-config.md; skipping --$slot."
      fi
    else
      if [ "$passed" = no ]; then
        value=$(iss_cfg_get fields "$slot" default 2>/dev/null) || value=
      fi
      if [ -z "$value" ]; then
        slot_line="skipped: flag not passed and no default"
      else
        iss_slot_resolve "$slot" "$value"
        slot_value=$SLOT_VALUE
        slot_line=$SLOT_VALUE
      fi
    fi
  fi
}
resolve_slot priority "$priority_set" "$priority_arg"
priority_line=$slot_line; priority_value=$slot_value
resolve_slot size "$size_set" "$size_arg"
size_line=$slot_line; size_value=$slot_value
resolve_slot status "$status_set" "$status_arg"
status_line=$slot_line; status_value=$slot_value

parent_id=
parent_ref=
if [ -n "$parent_arg" ]; then
  # A bare N names an issue in the repo the issue is filed in, whose
  # repo-config supplied the issue-link-prefix it may carry.
  iss_parse_operand "$parent_arg" "$host" "$owner" "$repo"
  iss_check_repo "$OP_HOST" "$OP_OWNER" "$OP_REPO" "$host" "$owner" "$repo"
  iss_lookup "$OP_HOST" "$OP_OWNER" "$OP_REPO" "$OP_NUMBER" id
  parent_id=$(iss_jq .id)
  parent_ref=$(iss_ref "$OP_HOST" "$OP_OWNER" "$OP_REPO" "$OP_NUMBER")
fi

assignees=$assignee_arg
if [ -z "$assignees" ] && [ "$no_target_config" = no ]; then
  if [ "$target_set" = yes ]; then
    assignees=$(iss_default_assignee "$host" global-only) || exit 1
  else
    assignees=$(iss_default_assignee "$host") || exit 1
  fi
fi

# ---------------------------------------------------------------------------
# Create, then apply and verify each piece.
# ---------------------------------------------------------------------------

created_url=
completed=
on_exit() {
  local rc=$?
  if [ "$rc" -ne 0 ] && [ -n "$created_url" ]; then
    printf '%s: issue %s was created (%s), but the run stopped before finishing.\n' \
      "$ISS_PROGRAM" "$ref" "$created_url" >&2
    printf '%s: completed: %s\n' "$ISS_PROGRAM" "${completed:-the create only}" >&2
  fi
}
trap on_exit EXIT
step_done() { completed="${completed:+$completed, }$1"; }

set -- issue create --repo "$(iss_repo_arg "$host" "$owner" "$repo")" --title "$title" \
  --body-file "$body_file"
[ -n "$labels" ] && set -- "$@" --label "$labels"
[ -n "$assignees" ] && set -- "$@" --assignee "$assignees"
out=$(gh "$@") || iss_die "\`gh issue create\` failed; no issue was created"
created_url=$(printf '%s\n' "$out" | grep -o 'https://[^[:space:]]*/issues/[0-9][0-9]*' | tail -n 1)
[ -n "$created_url" ] || iss_die "\`gh issue create\` printed no issue URL: $out"
number=${created_url##*/}
ref=$(iss_ref "$host" "$owner" "$repo" "$number")
step_done create

iss_lookup "$host" "$owner" "$repo" "$number" "id $ISS_SEL_PROJECT_ITEMS"
issue_id=$(iss_jq .id)

if [ "$ISS_HAS_GP" = 1 ] && iss_cfg_get project-id >/dev/null 2>&1 && [ -z "$(iss_project_item)" ]; then
  iss_gql "$host" -f query="$ISS_DOC_ADD_PROJECT_ITEM" -f projectId="$(iss_cfg_get project-id)" \
    -f contentId="$issue_id" || iss_gql_fail
  step_done "added to project"
fi

if [ -n "$type_id" ]; then
  iss_type_write "$host" "$owner" "$repo" "$number" "$issue_id" "$type_id" "$type_name"
  step_done "type"
fi

if [ -n "$parent_id" ]; then
  iss_gql "$host" -f query="$ISS_DOC_ADD_SUB_ISSUE" -f parentId="$parent_id" -f childId="$issue_id" || iss_gql_fail
  iss_lookup "$host" "$owner" "$repo" "$number" "$ISS_SEL_PARENT"
  [ "$(iss_jq '.parent.id // empty')" = "$parent_id" ] ||
    iss_err_write_not_landed parent "$ref" "$parent_ref" "(none)"
  step_done "parent"
fi

# write_slot <slot> <value>: write the resolved value; an empty one was
# skipped.
write_slot() {
  [ -n "$2" ] || return 0
  iss_slot_resolve "$1" "$2"
  iss_slot_write "$1" "$host" "$owner" "$repo" "$number" always
  step_done "$1"
}
write_slot priority "$priority_value"
write_slot size "$size_value"
write_slot status "$status_value"

# requested_missing <requested-csv> <landed-lines>: print the requested names
# the re-read does not show, comma-joined; matching ignores case.
requested_missing() {
  local item landed_lc out=
  landed_lc=$(printf '%s\n' "$2" | tr '[:upper:]' '[:lower:]')
  while IFS= read -r item; do
    [ -n "$item" ] || continue
    printf '%s\n' "$landed_lc" | grep -Fxq -- "$(iss_lc "$item")" || out="${out:+$out, }$item"
  done <<EOF
$(printf '%s\n' "$1" | tr ',' '\n')
EOF
  printf '%s' "$out"
}

missing=
missing_labels=
if [ -n "$assignees" ] || [ -n "$labels" ]; then
  iss_lookup "$host" "$owner" "$repo" "$number" "$(iss_conn assignees) $ISS_SEL_LABELS"
fi

assignee_line="skipped: no --assignee passed and no built-in default applies"
if [ -n "$assignees" ]; then
  have=$(iss_jq '.assignees.nodes[].login')
  missing=$(requested_missing "$assignees" "$have")
  if [ -n "$missing" ]; then
    assignee_line="$(printf '%s' "$have" | iss_join_lines) (requested $assignees; $missing did not land)"
  else
    assignee_line=$(printf '%s' "$have" | iss_join_lines)
  fi
fi

labels_line=
if [ -n "$labels" ]; then
  have=$(iss_jq '.labels.nodes[].name')
  missing_labels=$(requested_missing "$labels" "$have")
  if [ -n "$missing_labels" ]; then
    labels_line="$(printf '%s' "$have" | iss_join_lines) (requested $labels; $missing_labels did not land)"
  else
    labels_line=$(printf '%s' "$have" | iss_join_lines)
  fi
fi

printf 'Created issue %s "%s"\n' "$ref" "$title"
printf '  type:       %s\n' "$type_line"
printf '  priority:   %s\n' "$priority_line"
printf '  size:       %s\n' "$size_line"
printf '  status:     %s\n' "$status_line"
printf '  assignee:   %s\n' "$assignee_line"
[ -z "$labels" ] || printf '  labels:     %s\n' "$labels_line"
[ -z "$parent_ref" ] || printf '  parent:     %s\n' "$parent_ref"
if [ "$no_target_config" = yes ]; then
  printf '\nnote: project fields skipped: %s has no %s.\n' "\`$(iss_repo_name "$host" "$owner" "$repo")\`" "\`.issues/repo-config.md\`"
fi
[ -z "$warnings" ] || printf '\n%s' "$warnings"
printf '\n%s\n' "$created_url"

if [ -n "$missing" ] || [ -n "$missing_labels" ]; then
  # The summary above already reports the issue, so the exit trap's
  # partial-run report is silenced.
  created_url=
  dropped=
  [ -z "$missing" ] || dropped="assignee(s) $missing"
  [ -z "$missing_labels" ] || dropped="${dropped:+$dropped and }label(s) $missing_labels"
  iss_die "$dropped did not land on issue \`$ref\`"
fi
